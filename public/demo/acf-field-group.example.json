{
  "_comment": "Example: an existing WordPress ACF (Advanced Custom Fields) field group for the 'Resolución de Uso de Suelo' trámite, annotated with an `_attestto` mapping so Attestto can import it into a credential request. Each field maps to a Verifiable Credential claim, a user input, or a signature. The canonical wire format is DIF Presentation Exchange; this is the authoring/import view.",
  "key": "group_resolucion_uso_de_suelo",
  "title": "Resolución de Uso de Suelo",
  "fields": [
    { "key": "field_cedula", "label": "Cédula", "name": "cedula", "type": "text", "required": 1,
      "_attestto": { "credential": "IdentityCredential", "claim": "cedula", "source": "persona" } },
    { "key": "field_nombre", "label": "Nombre completo", "name": "nombre", "type": "text", "required": 1,
      "_attestto": { "credential": "IdentityCredential", "claim": "nombre", "source": "persona" } },
    { "key": "field_contacto", "label": "Correo y teléfono", "name": "contacto", "type": "text", "required": 1,
      "_attestto": { "credential": "ContactCredential", "claim": "contacto", "source": "persona" } },
    { "key": "field_finca", "label": "N° de Finca (folio real)", "name": "finca", "type": "text", "required": 1,
      "_attestto": { "credential": "PropertyCredential", "claim": "finca", "source": "propiedad" } },
    { "key": "field_plano", "label": "N° Plano catastrado", "name": "plano", "type": "text", "required": 1,
      "_attestto": { "credential": "PropertyCredential", "claim": "plano", "source": "propiedad" } },
    { "key": "field_registral", "label": "Consulta registral vigente", "name": "consulta_registral", "type": "true_false", "required": 1,
      "_attestto": { "credential": "RegistryCredential", "source": "propiedad" } },
    { "key": "field_impuestos", "label": "Impuestos municipales al día", "name": "impuestos_al_dia", "type": "true_false", "required": 1,
      "_attestto": { "credential": "TaxStatusCredential", "source": "propiedad" } },
    { "key": "field_rol", "label": "Titular registral", "name": "rol", "type": "text", "required": 1,
      "_attestto": { "credential": "OwnershipCredential", "source": "propiedad" } },
    { "key": "field_actividad", "label": "Actividad a desarrollar", "name": "actividad", "type": "select", "required": 1,
      "choices": { "vivienda_unifamiliar": "Residencial — Vivienda unifamiliar", "comercio": "Comercial — Construcción de comercio" },
      "_attestto": { "input": true } },
    { "key": "field_declaracion", "label": "Declaración jurada (Art. 318 CP · Art. 28 LPU)", "name": "declaracion_jurada", "type": "true_false", "required": 1,
      "_attestto": { "input": true, "sign": true } }
  ],
  "location": [[{ "param": "page_template", "operator": "==", "value": "uso-de-suelo.php" }]],
  "_attestto_meta": {
    "verifier": "did:web:sanbuenaventura.go.cr",
    "encryptTo": "did:web:sanbuenaventura.go.cr",
    "note": "Attestto reads this field group and produces a credential request. The resulting Verifiable Presentation is signed by the holder AND encrypted to `encryptTo`, so it can traverse an insecure site while only the municipal system can decrypt it (no plaintext PII on the wire)."
  }
}
