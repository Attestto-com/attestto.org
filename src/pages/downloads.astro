---
import Base from '../layouts/Base.astro'

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "Attestto",
    "url": "https://attestto.org/downloads",
    "applicationCategory": "SecurityApplication",
    "operatingSystem": "Cross-platform",
    "license": "https://www.apache.org/licenses/LICENSE-2.0",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What Attestto apps are available?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Attestto offers four surfaces: verify.attestto.com (zero-install browser verification), the Attestto App (PWA at app.attestto.com for credential management), Station (Electron desktop for vault, signing, and mesh), and a browser extension for web-based certificate verification."
        }
      },
      {
        "@type": "Question",
        "name": "Is Attestto open source?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. All Attestto components are open source under the Apache 2.0 license. Source code is available on GitHub at github.com/Attestto-com. SDKs include @attestto/verify, cr-vc-sdk, cr-vc-schemas, id-wallet-adapter, and attestto-mesh."
        }
      },
      {
        "@type": "Question",
        "name": "What platforms does Attestto Station support?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Attestto Station is built with Electron and supports macOS, Windows, and Linux. It bundles your identity vault, document signer, verifier, mesh node, and proctoring engine into a single desktop application."
        }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Attestto", "item": "https://attestto.org" },
      { "@type": "ListItem", "position": 2, "name": "Downloads", "item": "https://attestto.org/downloads" }
    ]
  }
]
---

<Base
  structuredData={structuredData}
  title="Downloads — Attestto"
  description="Download the desktop app, install the browser extension, open the web apps, or integrate Attestto SDKs."
  canonicalPath="/downloads"
  ogTitle="Downloads — Attestto"
  ogDescription="All Attestto apps and tools in one place. Desktop, mobile, extension, verification, signing, and SDKs."
  navVariant="default"
  footerVariant="default"
>

  <!-- Hero (dark) -->
  <section class="hero hero-single">
    <div class="container">
      <h1 data-i18n="downloads.hero_title">Downloads</h1>
      <p class="lead" data-i18n="downloads.hero_lead">All Attestto apps and tools in one place. Desktop, mobile, browser extension, web apps, and SDKs for developers.</p>
    </div>
  </section>

  <!-- Apps (light) -->
  <section id="apps" class="section-light">
    <div class="container">
      <div class="section-label" data-i18n="downloads.apps_label">Apps</div>
      <h2 class="section-title" data-i18n="downloads.apps_title">Applications</h2>
      <p class="section-desc" data-i18n="downloads.apps_desc">Install Station on your desktop for verification, signing, and mesh networking. Open the App on your phone for credentials and exams. Every surface connects to the same identity.</p>
      <div class="apps-grid">
        <!-- App (PWA) -->
        <div class="card">
          <span class="tag tag-mobile">PWA</span>
          <h3>Attestto App</h3>
          <p>Sovereign citizen wallet. Identity, credentials, proctored exams, on-device AI, and perpetual competency — all offline-first. Modular architecture, on-device LLM. Installs from the browser.</p>
          <div class="dl-links">
            <a href="https://app.attestto.com" class="dl-btn">Open app.attestto.com</a>
            <a href="https://app.attestto.com/demo.html" class="dl-btn">Live Demo</a>
          </div>
          <p class="note">PWA — installs on Android, iOS, and desktop browsers. <a href="https://github.com/Attestto-com/attestto-app">Source on GitHub</a> (Apache 2.0)</p>
        </div>

        <!-- Station -->
        <div class="card">
          <span class="tag tag-desktop">Desktop</span>
          <h3>Station</h3>
          <p data-i18n="downloads.station_desc">Your verification station. Encrypted vault, document OCR, national digital signature support, trust store. Required for mesh network nodes and professional modules (notarial, medical, legal). macOS, Windows, and Linux.</p>
          <div class="dl-links">
            <a href="https://github.com/Attestto-com/attestto-desktop/releases/latest" class="dl-btn">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:1rem;height:1rem"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.604-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"/></svg>
              GitHub Releases
            </a>
          </div>
          <div class="dl-links dl-links-sub">
            <a href="https://github.com/Attestto-com/attestto-desktop/releases/latest" class="dl-btn">macOS</a>
            <a href="https://github.com/Attestto-com/attestto-desktop/releases/latest" class="dl-btn">Windows</a>
            <a href="https://github.com/Attestto-com/attestto-desktop/releases/latest" class="dl-btn">Linux</a>
          </div>
          <p class="note" data-i18n-html="downloads.station_note">v0.1.0 — <a href="https://github.com/Attestto-com/attestto-desktop/releases">Changelog</a> · Requires macOS 12+, Windows 10+, or Ubuntu 20.04+</p>
        </div>

        <!-- Extension -->
        <div class="card card-disabled">
          <span class="tag tag-extension">Extension</span>
          <h3>Attestto ID <span class="coming-soon-label">— Coming soon</span></h3>
          <p data-i18n="downloads.extension_desc">Browser extension that validates document signatures client-side and manages your decentralized identity on the web.</p>
          <div class="dl-links">
            <span class="dl-btn dl-btn-disabled">Chrome</span>
            <span class="dl-btn dl-btn-disabled">Firefox</span>
          </div>
          <p class="note" data-i18n-html="downloads.extension_note">Coming soon to Chrome Web Store and Firefox Add-ons. Available from <a href="https://github.com/Attestto-com/attestto-creds-extension">source code</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <style>
    .apps-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-md);
      margin-top: var(--space-md);
    }

    @media (max-width: 768px) {
      .apps-grid { grid-template-columns: 1fr; }
    }
  </style>

  <!-- Web apps (dark) -->
  <section id="web" class="section-dark">
    <div class="container">
      <div class="section-label" data-i18n="downloads.web_label">Web</div>
      <h2 class="section-title" data-i18n="downloads.web_title">Web applications</h2>
      <p class="section-desc" data-i18n="downloads.web_desc">Verify and sign documents directly from your browser. No installation, no registration.</p>
      <div class="grid-3">
        <div class="card">
          <div class="card-icon">&#10003;</div>
          <h3 data-i18n="downloads.verify_title">Verify</h3>
          <p data-i18n="downloads.verify_desc">Verify signed documents. Drop a PDF and check the cryptographic signature, chain of trust, and document integrity. Supports national PKI roots per jurisdiction.</p>
          <div class="dl-links">
            <a href="https://verify.attestto.com" class="dl-btn" data-i18n="downloads.verify_btn">Open verify.attestto.com</a>
          </div>
        </div>
        <div class="card">
          <div class="card-icon">&#9998;</div>
          <h3 data-i18n="downloads.sign_title">Sign</h3>
          <p data-i18n="downloads.sign_desc">Sign documents with your verified identity. Simple electronic signature, advanced signature with Attestto CA, or Costa Rican Digital Signature.</p>
          <div class="dl-links">
            <a href="https://verify.attestto.com/sign/" class="dl-btn" data-i18n="downloads.sign_btn">Open verify.attestto.com/sign</a>
          </div>
        </div>
        <div class="card">
          <div class="card-icon">&#9830;</div>
          <h3 data-i18n="downloads.platform_title">Platform</h3>
          <p data-i18n="downloads.platform_desc">Complete dashboard for organizations. KYC/KYB, credentials, treasury, data vault, and more.</p>
          <div class="dl-links">
            <a href="https://attestto.com" class="dl-btn" data-i18n="downloads.platform_btn">Open attestto.com</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Developers (light) -->
  <section id="developers" class="section-light">
    <div class="container">
      <div class="section-label" data-i18n="downloads.dev_label">Developers</div>
      <h2 class="section-title" data-i18n="downloads.dev_title">SDKs and open source</h2>
      <p class="section-desc" data-i18n="downloads.dev_desc">Integrate credential verification, decentralized identity, and verifiable schemas in your application. Everything is open source on GitHub.</p>
      <div class="grid-3">
        <h3 style="grid-column: 1 / -1; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-accent); margin: 0;">Schemas &amp; Specs</h3>
        <div class="card">
          <span class="tag tag-sdk">SDK</span>
          <h3>cr-vc-schemas</h3>
          <p>JSON-LD schemas for 11 Costa Rica credential types. W3C VDL + ISO 18013-5.</p>
          <div class="code-block">npm install cr-vc-schemas</div>
          <div class="dl-links"><a href="https://github.com/Attestto-com/cr-vc-schemas" class="dl-btn">GitHub</a></div>
        </div>
        <div class="card">
          <span class="tag tag-sdk">Spec</span>
          <h3>did-sns-spec</h3>
          <p>DID method specification for Solana Name Service domains.</p>
          <div class="dl-links"><a href="https://github.com/Attestto-com/did-sns-spec" class="dl-btn">GitHub</a></div>
        </div>
        <h3 style="grid-column: 1 / -1; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-accent); margin: 0; margin-top: var(--space-sm);">Identity &amp; Wallet</h3>
        <div class="card">
          <span class="tag tag-sdk">SDK</span>
          <h3>cr-vc-sdk</h3>
          <p>Typed SDK for issuing and verifying Costa Rica credentials.</p>
          <div class="code-block">npm install cr-vc-sdk</div>
          <div class="dl-links"><a href="https://github.com/Attestto-com/cr-vc-sdk" class="dl-btn">GitHub</a></div>
        </div>
        <div class="card">
          <span class="tag tag-sdk">Bridge</span>
          <h3>vLEI-Solana-Bridge</h3>
          <p>On-chain vLEI attestations with Groth16 zero-knowledge proofs.</p>
          <div class="dl-links"><a href="https://github.com/Attestto-com/vLei-Solana-Bridge" class="dl-btn">GitHub</a></div>
        </div>
        <div class="card">
          <span class="tag tag-sdk">Wallet</span>
          <h3>credential-wallet-connector</h3>
          <p>CHAPI-based wallet discovery and credential exchange protocol.</p>
          <div class="dl-links"><a href="https://github.com/Attestto-com/credential-wallet-connector" class="dl-btn">GitHub</a></div>
        </div>
        <div class="card">
          <span class="tag tag-sdk">Trust</span>
          <h3>@attestto/trust</h3>
          <p>Trust store — hash-pinned X.509 CA certificates for national PKIs. Multi-jurisdiction. ESM exports.</p>
          <div class="dl-links"><a href="https://github.com/Attestto-com/attestto-trust" class="dl-btn">GitHub</a></div>
        </div>
        <h3 style="grid-column: 1 / -1; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-accent); margin: 0; margin-top: var(--space-sm);">Infrastructure</h3>
        <div class="card">
          <span class="tag tag-sdk">Network</span>
          <h3>attestto-mesh</h3>
          <p>P2P data mesh over libp2p — encrypted state-sync for sovereign identity.</p>
          <div class="dl-links"><a href="https://github.com/Attestto-com/attestto-mesh" class="dl-btn">GitHub</a></div>
        </div>
        <div class="card">
          <span class="tag tag-sdk">Component</span>
          <h3>@attestto/verify</h3>
          <p>Web Components for PDF signature verification and signing. Drop-in &lt;attestto-verify&gt; element. Browser-only, no backend.</p>
          <div class="code-block">npm install @attestto/verify</div>
          <div class="dl-links"><a href="https://github.com/Attestto-com/attestto-verify" class="dl-btn">GitHub</a></div>
        </div>
        <div class="card">
          <span class="tag tag-sdk">App</span>
          <h3>attestto-app</h3>
          <p>Sovereign citizen wallet (PWA). Modular, credential-gated, on-device AI. Monorepo with module SDK.</p>
          <div class="dl-links"><a href="https://github.com/Attestto-com/attestto-app" class="dl-btn">GitHub</a></div>
        </div>
      </div>
      <div class="dev-all-cta">
        <a href="https://github.com/Attestto-com" class="btn btn-primary" data-i18n="downloads.dev_btn_all">View all on GitHub</a>
      </div>
    </div>
  </section>

  <!-- Community (dark) -->
  <section class="section-dark">
    <div class="container">
      <div class="section-label" data-i18n="downloads.community_label">Community</div>
      <h2 class="section-title" data-i18n="downloads.community_title">Build with us</h2>
      <p class="section-desc" data-i18n="downloads.community_desc">Attestto is open source. Report bugs, propose features, contribute code, or just follow along.</p>
      <div class="grid-3">
        <div class="card">
          <div class="card-icon">
            <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.604-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"/></svg>
          </div>
          <h3 data-i18n="downloads.community_github_title">GitHub</h3>
          <p data-i18n="downloads.community_github_desc">Source code, issues, pull requests, and releases from all repositories.</p>
          <div class="dl-links"><a href="https://github.com/Attestto-com" class="dl-btn">github.com/Attestto-com</a></div>
        </div>
        <div class="card">
          <div class="card-icon">&#9993;</div>
          <h3 data-i18n="downloads.community_contact_title">Contact</h3>
          <p data-i18n="downloads.community_contact_desc">For institutions, governments, and partners who want to board the Ark.</p>
          <div class="dl-links">
            <a href="mailto:ark@attestto.com" class="dl-btn">ark@attestto.com</a>
            <a href="mailto:open@attestto.com" class="dl-btn">open@attestto.com</a>
          </div>
        </div>
        <div class="card">
          <div class="card-icon">&#9741;</div>
          <h3 data-i18n="downloads.community_arch_title">Architecture</h3>
          <p data-i18n="downloads.community_arch_desc">Learn the full architecture: Station, Wallet, Mesh, Ceremony, and Trust.</p>
          <div class="dl-links"><a href="/ark" class="dl-btn">Attestto Ark</a></div>
        </div>
      </div>
    </div>
  </section>

</Base>
