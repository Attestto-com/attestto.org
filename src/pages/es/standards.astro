---
import Base from '../../layouts/Base.astro'

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Estándares Attestto — Métodos DID y Casos de Uso",
    "url": "https://attestto.org/es/standards",
    "inLanguage": "es",
    "description": "Dos métodos DID del W3C (did:pki, did:sns), un resolver universal en producción, y despliegue real en credenciales profesionales, firma de documentos y puente de PKI nacional.",
    "mainEntity": [
      {
        "@type": "DefinedTerm",
        "name": "did:pki",
        "description": "Método DID de solo lectura que deriva DIDs a partir de certificados X.509 de CAs en jerarquías de PKI nacionales",
        "url": "https://github.com/Attestto-com/did-pki-spec"
      },
      {
        "@type": "DefinedTerm",
        "name": "did:sns",
        "description": "Método DID anclado en alias usando el Solana Name Service",
        "url": "https://github.com/Attestto-com/did-sns-spec"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "¿Qué es did:pki?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "did:pki es un método DID de solo lectura que deriva Identificadores Descentralizados de forma determinista a partir de certificados X.509 de Autoridades Certificadoras en infraestructuras de clave pública nacionales. No requiere registro ni escrituras en cadena — si un certificado de CA gubernamental existe, ya tiene un DID."
        }
      },
      {
        "@type": "Question",
        "name": "¿Qué es did:sns?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "did:sns es un método DID anclado en alias que utiliza el Solana Name Service. Proporciona identificadores legibles (como did:sns:attestto) que se resuelven a DID Documents mediante consulta on-chain, ideal para organizaciones y profesionales que quieren un identificador memorable y verificable."
        }
      },
      {
        "@type": "Question",
        "name": "¿Cómo funciona el resolver de Attestto?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "El resolver en resolver.attestto.com es un endpoint HTTP unificado que resuelve identificadores did:pki y did:sns. Cumple con la interfaz del DIF Universal Resolver y retorna resultados de resolución W3C DID con claves públicas, metadatos de certificados e información de jerarquía PKI."
        }
      },
      {
        "@type": "Question",
        "name": "¿Por qué no usar listas de confianza eIDAS o Adobe AATL en lugar de did:pki?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Las listas eIDAS dependen de acuerdos diplomáticos entre cada par de países y escalan lentamente. Adobe AATL depende de los criterios de inclusión de una empresa privada y se pierde la soberanía. Las CAs puente dependen de una autoridad central que firma cruzadamente. did:pki usa derivación determinista del propio certificado — sin registro, sin acuerdos, sin dependencia de proveedores."
        }
      },
      {
        "@type": "Question",
        "name": "¿Qué países soporta did:pki?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "La jerarquía PKI completa de Costa Rica (BCCR/MICITT) está en producción. España (FNMT), Brasil (ICP-Brasil) y Estados Unidos (Federal PKI) están planificados. Agregar un país significa agregar sus certificados de CA al repositorio open-source attestto-trust."
        }
      },
      {
        "@type": "Question",
        "name": "¿Están did:pki y did:sns en la vía de estándares del W3C?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sí. did:pki está registrado mediante W3C DID Extensions PR #697 y did:sns mediante PR #674. Ambos métodos también están registrados en el DIF Universal Resolver (PR #542). Las especificaciones son open source y auditables públicamente."
        }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Attestto", "item": "https://attestto.org" },
      { "@type": "ListItem", "position": 2, "name": "Estándares", "item": "https://attestto.org/es/standards" }
    ]
  }
]
---

<Base
  title="Estándares — Métodos DID y Casos de Uso de Attestto"
  structuredData={structuredData}
  description="Dos métodos DID del W3C (did:pki, did:sns), un resolver universal en producción, y despliegue real en credenciales profesionales, firma de documentos y puente de PKI nacional."
  canonicalPath="/es/standards"
  ogTitle="Estándares Attestto — Métodos DID y Casos de Uso"
  ogDescription="Métodos DID abiertos que conectan PKI nacional con identidad descentralizada. Resolver en producción, estándares W3C, despliegues reales."
  navVariant="standards"
  footerVariant="default"
  footerTagline="Estándares abiertos para identidad soberana. Estándares W3C y DIF."
  lang="es"
>
  <Fragment slot="head">
    <link rel="alternate" hreflang="es" href="https://attestto.org/es/standards" />
    <link rel="alternate" hreflang="en" href="https://attestto.org/standards" />
    <link rel="alternate" hreflang="x-default" href="https://attestto.org/standards" />
    <meta property="og:locale" content="es_CR" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Estándares Attestto — Métodos DID y Casos de Uso" />
    <meta name="twitter:description" content="Métodos DID abiertos que conectan PKI nacional con identidad descentralizada. Resolver en producción, estándares W3C, despliegues reales." />
    <meta name="twitter:image" content="https://attestto.org/og-image.png" />
    <meta name="keywords" content="método DID, did:pki, did:sns, W3C, DIF Universal Resolver, credenciales verificables, puente PKI, verificación transfronteriza, identidad descentralizada, X.509" />
  </Fragment>
  <!-- Hero -->
  <section class="story-highlight" style="padding: var(--space-xl) 0 var(--space-lg);">
    <div class="container">
      <div class="story-content">
        <div class="story-label">Estándares W3C</div>
        <h1 class="story-title">Métodos DID abiertos para identidad real</h1>
        <div class="story-text">
          <p>Attestto desarrolla y mantiene dos métodos de Identificador Descentralizado &mdash; ambos en el proceso de estandarización del W3C, ambos con resolvers en producción, ambos de código abierto.</p>
          <p>Estos métodos conectan infraestructura de confianza existente (PKIs nacionales, sistemas de nombres de dominio) con el ecosistema DID <strong>sin reemplazar nada</strong>. Los verificadores obtienen resolución interoperable. Los emisores conservan sus claves existentes.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- DID Methods -->
  <section id="methods" class="story-section">
    <div class="container">
      <div class="story-content">
        <div class="story-label">Métodos DID</div>
        <h2 class="story-title">Dos métodos, un resolver</h2>
      </div>

      <div class="methods-grid">
        <!-- did:pki -->
        <div class="method-card">
          <div class="method-header">
            <code class="method-name">did:pki</code>
            <span class="method-version">v0.1.0</span>
          </div>
          <p class="method-desc">Método DID de solo lectura que deriva DIDs de forma determinista a partir de certificados X.509 de CAs en Infraestructuras de Clave Pública nacionales. Sin registro, sin escrituras on-chain &mdash; si una CA gubernamental existe, ya tiene un DID.</p>

          <div class="method-example">
            <code>did:pki:cr:raiz-nacional</code>
            <span class="method-example-label">CA Raíz de Costa Rica</span>
          </div>
          <div class="method-example">
            <code>did:pki:cr:sinpe:persona-fisica</code>
            <span class="method-example-label">CA emisora de SINPE para usuario final</span>
          </div>

          <ul class="method-links">
            <li><a href="https://github.com/Attestto-com/did-pki-spec">Especificación</a></li>
            <li><a href="https://github.com/Attestto-com/did-pki-resolver">Implementación de referencia</a></li>
            <li><a href="https://github.com/Attestto-com/did-pki-spec/tree/main/test-vectors">Vectores de prueba</a></li>
            <li><a href="https://github.com/w3c/did-extensions/pull/697">W3C DID Extensions PR #697</a></li>
          </ul>
        </div>

        <!-- did:sns -->
        <div class="method-card">
          <div class="method-header">
            <code class="method-name">did:sns</code>
            <span class="method-version">v0.4.0</span>
          </div>
          <p class="method-desc">Método DID anclado en alias usando el Solana Name Service. Identificadores legibles para humanos que resuelven a DID Documents mediante consulta on-chain. Adecuado para organizaciones, profesionales y cualquier entidad que quiera un identificador memorable y verificable.</p>

          <div class="method-example">
            <code>did:sns:attestto</code>
            <span class="method-example-label">Organización Attestto</span>
          </div>
          <div class="method-example">
            <code>did:sns:fi-cr</code>
            <span class="method-example-label">Autoridad financiera de Costa Rica</span>
          </div>

          <ul class="method-links">
            <li><a href="https://github.com/Attestto-com/did-sns-spec">Especificación</a></li>
            <li><a href="https://github.com/Attestto-com/attestto-did-resolver">Implementación de referencia</a></li>
            <li><a href="https://github.com/w3c/did-extensions/pull/674">W3C DID Extensions PR #674</a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Live Resolver -->
  <section id="resolver" class="story-highlight">
    <div class="container">
      <div class="story-content">
        <div class="story-label">Infraestructura en producción</div>
        <h2 class="story-title">Resolver universal</h2>
        <div class="story-text">
          <p>Un endpoint HTTP unificado que resuelve identificadores tanto <code>did:pki</code> como <code>did:sns</code>. Conforme a la interfaz del <a href="https://github.com/decentralized-identity/universal-resolver" style="color: #4ade80;">DIF Universal Resolver</a>.</p>
        </div>

        <div class="resolver-demo">
          <div class="resolver-url">
            <span class="resolver-method">GET</span>
            <code>https://resolver.attestto.com/1.0/identifiers/did:pki:cr:raiz-nacional</code>
          </div>
          <p class="resolver-note">Retorna un DID Resolution Result del W3C con la clave pública de la CA como JWK, metadatos del certificado e información de la jerarquía PKI.</p>
        </div>

        <ul class="method-links" style="margin-top: var(--space-md);">
          <li><a href="https://resolver.attestto.com/1.0/identifiers/did:pki:cr:raiz-nacional">Pruébalo &mdash; CA Raíz CR</a></li>
          <li><a href="https://resolver.attestto.com/1.0/identifiers/did:sns:attestto">Pruébalo &mdash; did:sns:attestto</a></li>
          <li><a href="https://github.com/Attestto-com/attestto-did-resolver">Código fuente</a></li>
          <li><a href="https://github.com/decentralized-identity/universal-resolver/pull/542">DIF Universal Resolver PR #542</a></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Why did:pki — Comparison -->
  <section id="why" class="story-section">
    <div class="container">
      <div class="story-content">
        <div class="story-label">El problema</div>
        <h2 class="story-title">Por qué los enfoques existentes no escalan</h2>
        <div class="story-text">
          <p>Más de 100 países operan jerarquías de PKI soberanas para firmas digitales. Estas jerarquías son islas — un certificado emitido por el BCCR de Costa Rica no es verificable en Panamá sin herramientas a medida. La industria ha intentado varios enfoques, cada uno con limitaciones estructurales.</p>
        </div>
      </div>

      <div class="comparison-table">
        <table>
          <thead>
            <tr>
              <th>Enfoque</th>
              <th>Depende de</th>
              <th>Neutralidad</th>
              <th>¿Escala?</th>
            </tr>
          </thead>
          <tbody>
            <tr class="highlight-row">
              <td><code>did:pki</code></td>
              <td>Matemáticas (certificado X.509)</td>
              <td><strong>Total</strong></td>
              <td>Automático — agrega certificados, obtén DIDs</td>
            </tr>
            <tr>
              <td>Listas de confianza (eIDAS)</td>
              <td>Acuerdos diplomáticos por par de países</td>
              <td>Media</td>
              <td>Lento — requiere tratados</td>
            </tr>
            <tr>
              <td>Programas de vendor (Adobe AATL)</td>
              <td>Criterios de inclusión de una empresa privada</td>
              <td>Ninguna</td>
              <td>Fácil — pero pierdes soberanía</td>
            </tr>
            <tr>
              <td>Bridge CAs (Federal Bridge)</td>
              <td>Autoridad central que firma cruzado</td>
              <td>Baja</td>
              <td>Rígido — punto único de control político</td>
            </tr>
            <tr>
              <td><code>did:web</code> / <code>did:tdw</code></td>
              <td>Infraestructura DNS + hosting</td>
              <td>Media</td>
              <td>Fácil — pero si el dominio muere, el DID muere</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="story-content" style="margin-top: var(--space-md);">
        <div class="story-text">
          <p><code>did:pki</code> toma un enfoque fundamentalmente diferente: <strong>derivación determinista del certificado mismo</strong>. Sin registro, sin acuerdos, sin dependencia de vendors, sin dependencia de DNS. Si un certificado de CA gubernamental existe, ya tiene un DID — cualquier resolver conforme derivará el mismo identificador y retornará la misma clave pública.</p>
          <p>Esta es la <strong>vía rápida técnica</strong>: en lugar de esperar acuerdos diplomáticos para reconocer listas de confianza, <code>did:pki</code> traduce la confianza que ya existe en el certificado a un lenguaje que las aplicaciones modernas (wallets, verificadores, contratos inteligentes) entienden nativamente.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Use Cases -->
  <section id="usecases" class="story-section">
    <div class="container">
      <div class="story-content">
        <div class="story-label">Dónde se despliegan los DIDs</div>
        <h2 class="story-title">Casos de uso reales</h2>
        <div class="story-text">
          <p>Estos no son hipotéticos. Cada caso de uso a continuación está en producción o en desarrollo activo, usando <code>did:pki</code> y/o <code>did:sns</code> para resolución de identidad y verificación de credenciales.</p>
        </div>
      </div>

      <div class="usecases-grid">
        <div class="usecase-card">
          <div class="usecase-icon">&#x1F3DB;</div>
          <h3>Puente PKI Nacional</h3>
          <p>La jerarquía PKI de Firma Digital de Costa Rica (BCCR/MICITT) mapeada a <code>did:pki</code>. Cada CA &mdash; raíz, política, emisora &mdash; resoluble como DID Document con su clave pública. Permite verificación de firmas transfronteriza sin acuerdos bilaterales.</p>
          <span class="usecase-status live">En vivo</span>
        </div>

        <div class="usecase-card">
          <div class="usecase-icon">&#x1F4DD;</div>
          <h3>Verificación de Firma de Documentos</h3>
          <p>Documentos PDF firmados con firmas digitales nacionales (PKCS#7/CAdES) verificados criptográficamente en el navegador. El verificador no necesita empaquetar el trust store de cada país &mdash; el resolver provee las claves públicas de las CAs.</p>
          <span class="usecase-status live">En vivo</span>
        </div>

        <div class="usecase-card">
          <div class="usecase-icon">&#x2695;</div>
          <h3>Credenciales Profesionales</h3>
          <p>Marco propuesto para Credenciales Verificables de profesionales colegiados (médicos, abogados, ingenieros). Identidad profesional anclada vía <code>did:sns</code>, autoridad emisora verificada vía cadena <code>did:pki</code>.</p>
          <span class="usecase-status proposed">Propuesto</span>
        </div>

        <div class="usecase-card">
          <div class="usecase-icon">&#x1F697;</div>
          <h3>Credenciales Digitales de Conducción</h3>
          <p>Arquitectura de licencia de conducir móvil propuesta siguiendo ISO 18013-5, con verificación de competencia continua basada en maestría. Exámenes supervisados, puntuación por decaimiento y puertas de renovación &mdash; anclados al DID del titular.</p>
          <span class="usecase-status proposed">Propuesto</span>
        </div>

      </div>
    </div>
  </section>

  <!-- Countries -->
  <section id="coverage" class="story-highlight">
    <div class="container">
      <div class="story-content">
        <div class="story-label">Cobertura</div>
        <h2 class="story-title">Trust store de PKI</h2>
        <div class="story-text">
          <p>El resolver <code>did:pki</code> se alimenta del repositorio <a href="https://github.com/Attestto-com/attestto-trust" style="color: #4ade80;">attestto-trust</a> &mdash; un espejo público independiente de código abierto de certificados de CA raíz e intermedios de PKIs nacionales. Agregar un país significa agregar sus certificados al trust store.</p>
        </div>

        <div class="countries-list">
          <div class="country-item active">
            <span class="country-flag">&#x1F1E8;&#x1F1F7;</span>
            <span>Costa Rica</span>
            <span class="country-status">En vivo &mdash; jerarquía completa BCCR/MICITT</span>
          </div>
          <div class="country-item planned">
            <span class="country-flag">&#x1F1EA;&#x1F1F8;</span>
            <span>España</span>
            <span class="country-status">Planificado &mdash; certificados FNMT</span>
          </div>
          <div class="country-item planned">
            <span class="country-flag">&#x1F1E7;&#x1F1F7;</span>
            <span>Brasil</span>
            <span class="country-status">Planificado &mdash; jerarquía ICP-Brasil</span>
          </div>
          <div class="country-item planned">
            <span class="country-flag">&#x1F1FA;&#x1F1F8;</span>
            <span>Estados Unidos</span>
            <span class="country-status">Planificado &mdash; Federal PKI</span>
          </div>
        </div>

        <p class="resolver-note" style="margin-top: var(--space-md);">¿Quieres que la PKI de tu país esté en el trust store? <a href="mailto:open@attestto.com" style="color: #4ade80;">Contáctanos</a> o <a href="https://github.com/Attestto-com/attestto-trust/pulls" style="color: #4ade80;">envía un PR</a>.</p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="story-highlight" style="padding: var(--space-lg) 0;">
    <div class="container">
      <div class="cta-banner">
        <div class="cta-banner-text">
          <h2>¿Listo para explorar?</h2>
          <p>Explora el código fuente, lee las especificaciones o prueba el resolver en producción.</p>
        </div>
        <div class="cta-banner-actions">
          <a href="https://github.com/Attestto-com" class="cta-primary">Ver en GitHub &rarr;</a>
          <a href="https://resolver.attestto.com/1.0/identifiers/did:pki:cr:raiz-nacional" class="cta-secondary">Prueba el resolver &rarr;</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ── Method Cards ── */
  .methods-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  .method-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: var(--space-md);
  }

  .method-header {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .method-name {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-accent);
  }

  .method-version {
    font-size: 0.875rem;
    color: var(--color-ink-muted);
    font-weight: 500;
  }

  .method-desc {
    color: var(--color-ink-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin-bottom: var(--space-sm);
  }

  .method-example {
    background: #f8fafc;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 0.5rem 0.75rem;
    margin-bottom: 0.5rem;
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
  }

  .method-example code {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-ink);
    font-weight: 600;
  }

  .method-example-label {
    font-size: 0.8125rem;
    color: var(--color-ink-subtle);
  }

  .method-links {
    list-style: none;
    padding: 0;
    margin-top: var(--space-sm);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  .method-links a {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.15s;
  }

  .method-links a:hover {
    border-bottom-color: var(--color-accent);
  }

  .story-highlight .method-links a {
    color: #4ade80;
  }

  .story-highlight .method-links a:hover {
    border-bottom-color: #4ade80;
  }

  /* ── Resolver Demo ── */
  .resolver-demo {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: var(--space-sm) var(--space-md);
    margin-top: var(--space-md);
  }

  .resolver-url {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    overflow-x: auto;
  }

  .resolver-method {
    background: #4ade80;
    color: #0a1628;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .resolver-url code {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.9);
    white-space: nowrap;
  }

  .resolver-note {
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.5);
    margin-top: 0.5rem;
  }

  /* ── Use Case Cards ── */
  .usecases-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  .usecase-card {
