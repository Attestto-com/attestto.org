---
import Base from '../../layouts/Base.astro'

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Attestto",
    "url": "https://attestto.org",
    "logo": "https://attestto.org/logo.svg",
    "description": "Infraestructura de identidad soberana de código abierto. Credenciales verificables, identificadores descentralizados y verificación criptográfica para gobiernos, profesionales y ciudadanos.",
    "license": "https://www.apache.org/licenses/LICENSE-2.0",
    "foundingDate": "2025",
    "sameAs": [
      "https://github.com/Attestto-com",
      "https://attestto.com",
      "https://www.npmjs.com/org/attestto",
      "https://resolver.attestto.com",
      "https://spec.attestto.com"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Attestto",
    "url": "https://attestto.org"
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "Cómo verificar un documento firmado digitalmente",
    "description": "Verifica la firma digital, la cadena de certificados y la integridad de cualquier PDF firmado — completamente en tu navegador.",
    "step": [
      {
        "@type": "HowToStep",
        "name": "Abre el verificador",
        "text": "Ve a verify.attestto.com en cualquier navegador moderno. Sin cuenta ni instalación.",
        "url": "https://verify.attestto.com"
      },
      {
        "@type": "HowToStep",
        "name": "Arrastra tu PDF",
        "text": "Arrastra y suelta un PDF firmado digitalmente en la página. El archivo se queda en tu navegador — no se sube nada."
      },
      {
        "@type": "HowToStep",
        "name": "Revisa los resultados",
        "text": "El verificador comprueba la firma criptográfica, valida la cadena de certificados contra las anclas de confianza PKI nacionales y confirma la integridad del documento. Los resultados aparecen en segundos."
      }
    ],
    "totalTime": "PT30S",
    "tool": {
      "@type": "HowToTool",
      "name": "Cualquier navegador web moderno"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "¿Qué es Attestto?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Attestto es infraestructura de identidad soberana de código abierto construida sobre estándares W3C e IETF. Permite verificar documentos, emitir credenciales verificables y conectar sistemas PKI nacionales — todo sin dependencia de proveedor. Licencia Apache 2.0."
        }
      },
      {
        "@type": "Question",
        "name": "¿Cómo verifica documentos Attestto?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Arrastra un PDF a verify.attestto.com y la firma digital se verifica completamente en tu navegador. Sin subir archivos, sin backend. El verificador valida la cadena de certificados contra las anclas de confianza PKI nacionales y verifica la integridad del documento criptográficamente."
        }
      },
      {
        "@type": "Question",
        "name": "¿Qué son did:pki y did:sns?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "did:pki conecta certificados PKI nacionales al ecosistema DID — si existe una CA gubernamental, ya tiene un DID. did:sns proporciona identificadores legibles mediante Solana Name Service. Ambos están en el track de estándares W3C con resolvers en vivo en resolver.attestto.com."
        }
      },
      {
        "@type": "Question",
        "name": "¿Es gratis usar Attestto?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Identidad, firma, anclaje, recuperación y verificación son gratuitos para los ciudadanos, para siempre. La emisión de credenciales profesionales y el marketplace de módulos tienen estructuras de tarifas que financian la infraestructura gratuita."
        }
      }
    ]
  }
]
---

<Base
  title="Attestto — Infraestructura de Identidad Soberana"
  description="Infraestructura de código abierto para credenciales verificables e identidad descentralizada. Verifica documentos, emite credenciales, conecta PKIs nacionales — con estándares W3C y resolvers en vivo."
  canonicalPath="/es"
  ogTitle="Attestto — Infraestructura de Identidad Soberana"
  ogDescription="Infraestructura de código abierto para credenciales verificables e identidad descentralizada. Métodos DID en track de estándares W3C, resolver en vivo, despliegues reales."
  lang="es"
  structuredData={structuredData}
>
  <Fragment slot="head">
    <meta property="og:locale:alternate" content="en_US" />
    <meta name="keywords" content="identidad soberana, identidad descentralizada, DID, credenciales verificables, firma digital, verificar documento, did:pki, did:sns, W3C, código abierto, infraestructura pública digital, DPI, identidad digital Costa Rica, credencial profesional, colegio profesional" />
  </Fragment>

  <!-- Hero -->
  <section class="hero hero-single">
    <div class="container">
      <div class="hero-text">
        <h1>Verifica cualquier documento. Emite cualquier credencial. Conecta cualquier PKI.</h1>
        <p class="lead">
          Infraestructura de identidad construida sobre estándares W3C e IETF.
          Tecnológicamente neutral &mdash; funciona con cualquier stack, cualquier proveedor, cualquier gobierno.
          Implementaciones de referencia de código abierto que cualquiera puede desplegar.
        </p>
        <div class="hero-actions">
          <a href="https://verify.attestto.com" class="btn btn-primary">Verificar un documento</a>
          <a href="/es/standards" class="btn btn-secondary">Explorar los estándares</a>
        </div>
      </div>
    </div>
  </section>

  <!-- What Attestto Does — Use Cases -->
  <section id="usecases" class="section-light">
    <div class="container">
      <div class="section-label">Lo que construimos</div>
      <h2 class="section-title">Infraestructura de identidad para el mundo real</h2>
      <p class="section-desc">
        Cada caso de uso a continuación está en vivo o en desarrollo activo,
        utilizando estándares abiertos para resolución de identidad y verificación de credenciales.
      </p>
      <div class="usecases-grid">
        <div class="usecase-card">
          <h3>Verificación de documentos</h3>
          <p>Arrastra un PDF firmado digitalmente. La firma, la cadena de certificados y la autoridad emisora se verifican criptográficamente — sin cuenta, sin subir datos.</p>
          <div class="usecase-meta">
            <span class="usecase-status live">En vivo</span>
            <a href="https://verify.attestto.com" class="usecase-link">verify.attestto.com</a>
          </div>
        </div>

        <div class="usecase-card">
          <h3>Puente PKI transfronterizo</h3>
          <p>La jerarquía PKI de Firma Digital de Costa Rica mapeada a DIDs <code>did:pki</code>. Cada CA resoluble como un DID Document. Un documento firmado en CR se puede verificar en cualquier lugar — un solo endpoint, cualquier país.</p>
          <div class="usecase-meta">
            <span class="usecase-status live">En vivo</span>
            <a href="/es/standards#methods" class="usecase-link">Spec did:pki</a>
          </div>
        </div>

        <div class="usecase-card">
          <h3>Credenciales profesionales</h3>
          <p>Marco propuesto para Credenciales Verificables para profesionales con licencia — médicos, abogados, ingenieros. Modelo de competencia continua basado en maestría con emisión por colegios profesionales.</p>
          <div class="usecase-meta">
            <span class="usecase-status proposed">Propuesto</span>
            <a href="/es/ark" class="usecase-link">Arquitectura</a>
          </div>
        </div>

        <div class="usecase-card">
          <h3>Credenciales digitales de conducción</h3>
          <p>Arquitectura propuesta de licencia de conducir móvil siguiendo ISO 18013-5, con exámenes supervisados, puntuación por decaimiento y puertas de renovación — anclada al DID del titular.</p>
          <div class="usecase-meta">
            <span class="usecase-status proposed">Propuesto</span>
            <a href="/cr" class="usecase-link">Costa Rica</a>
          </div>
        </div>


      </div>
    </div>
  </section>

  <!-- Surfaces — What you can use today -->
  <section id="surfaces" class="section-dark">
    <div class="container">
      <div class="section-label">Herramientas</div>
      <h2 class="section-title">Úsalo hoy</h2>
      <p class="section-desc">
        Cuatro superficies, adopción progresiva. Empieza sin fricción en el navegador,
        profundiza según lo necesites.
      </p>
      <div class="grid-4 surfaces-grid">
        <div class="card surface-card">
          <div class="surface-badge live">En vivo</div>
          <h3>Verify</h3>
          <p>Arrastra y suelta un PDF firmado. Verifica la firma, la cadena de certificados y la CA emisora — en tu navegador, sin subir nada.</p>
          <a href="https://verify.attestto.com" class="surface-link">verify.attestto.com &rarr;</a>
        </div>
        <div class="card surface-card">
          <div class="surface-badge live">En vivo</div>
          <h3>App</h3>
          <p>Billetera de identidad soberana. Almacena credenciales, presenta pruebas, realiza exámenes supervisados. Progressive Web App — funciona en cualquier dispositivo.</p>
          <a href="https://app.attestto.com" class="surface-link">app.attestto.com &rarr;</a>
        </div>
        <div class="card surface-card">
          <div class="surface-badge soon">Pre-lanzamiento</div>
          <h3>Station</h3>
          <p>Bóveda de escritorio, firmador, verificador y nodo mesh. Capacidad offline completa. Electron en macOS, Windows y Linux.</p>
          <a href="/es/ark/desktop" class="surface-link">Más información &rarr;</a>
        </div>
        <div class="card surface-card">
          <div class="surface-badge soon">Próximamente</div>
          <h3>Extension</h3>
          <p>Extensión de navegador para verificación nativa en la web. Valida firmas digitales en cualquier página que visites.</p>
          <a href="/es/downloads" class="surface-link">Descargas &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Standards — Social Proof -->
  <section id="standards" class="section-light">
    <div class="container">
      <div class="section-label">Estándares</div>
      <h2 class="section-title">Métodos DID en track de estándares W3C</h2>
      <p class="section-desc">
        Dos métodos DID, ambos en el track de estándares W3C, ambos con resolvers en vivo.
        Conectan infraestructura de confianza existente al ecosistema DID
        sin reemplazar nada.
      </p>
      <div class="standards-row">
        <div class="standard-card">
          <code class="standard-name">did:pki</code>
          <p>DIDs de solo lectura derivados de certificados X.509 de CA. Si existe una CA gubernamental, ya tiene un DID.</p>
          <div class="standard-links">
            <a href="https://github.com/Attestto-com/did-pki-spec">Spec</a>
            <a href="https://github.com/w3c/did-extensions/pull/697">W3C PR #697</a>
          </div>
        </div>
        <div class="standard-card">
          <code class="standard-name">did:sns</code>
          <p>DIDs anclados a alias vía Solana Name Service. Identificadores legibles y verificables.</p>
          <div class="standard-links">
            <a href="https://github.com/Attestto-com/did-sns-spec">Spec</a>
            <a href="https://github.com/w3c/did-extensions/pull/674">W3C PR #674</a>
          </div>
        </div>
        <div class="standard-card resolver-card">
          <code class="standard-name">resolver</code>
          <p>Endpoint HTTP unificado que resuelve ambos métodos. Compatible con DIF Universal Resolver.</p>
          <div class="standard-links">
            <a href="https://resolver.attestto.com/1.0/identifiers/did:pki:cr:raiz-nacional">Probarlo en vivo</a>
            <a href="https://github.com/decentralized-identity/universal-resolver/pull/542">DIF PR #542</a>
          </div>
        </div>
      </div>
      <div style="text-align: center; margin-top: var(--space-md);">
        <a href="/es/standards" class="btn btn-outline">Todos los estándares y casos de uso &rarr;</a>
      </div>
    </div>
  </section>

  <!-- Open Source -->
  <section id="source" class="section-dark">
    <div class="container">
      <div class="section-label">Implementaciones de referencia</div>
      <h2 class="section-title">Basado en estándares. Código abierto. Desplegable.</h2>
      <p class="section-desc">
        Publicamos implementaciones de referencia para cada estándar que proponemos.
        Los proveedores tradicionales pueden adoptar los estándares sin usar nuestro código. O bifurcarlo. Apache 2.0.
      </p>
      <div class="repo-grid">
        <a href="https://github.com/Attestto-com/did-pki-spec" class="repo">
          <img src="/github.svg" class="repo-icon" alt="GitHub" />
          <div>
            <div class="repo-name">did-pki-spec</div>
            <div class="repo-desc">Método DID para jerarquías PKI nacionales. En track de estándares W3C.</div>
            <span class="repo-tag">Spec</span>
          </div>
        </a>
        <a href="https://github.com/Attestto-com/did-pki-resolver" class="repo">
          <img src="/github.svg" class="repo-icon" alt="GitHub" />
          <div>
            <div class="repo-name">did-pki-resolver</div>
            <div class="repo-desc">Implementación de referencia — resolución de X.509 a DID Document.</div>
            <span class="repo-tag">Resolver</span>
          </div>
        </a>
        <a href="https://github.com/Attestto-com/did-sns-spec" class="repo">
          <img src="/github.svg" class="repo-icon" alt="GitHub" />
          <div>
            <div class="repo-name">did-sns-spec</div>
            <div class="repo-desc">Método DID para Solana Name Service. En track de estándares W3C.</div>
            <span class="repo-tag">Spec</span>
          </div>
        </a>
        <a href="https://github.com/Attestto-com/attestto-did-resolver" class="repo">
          <img src="/github.svg" class="repo-icon" alt="GitHub" />
          <div>
            <div class="repo-name">attestto-did-resolver</div>
            <div class="repo-desc">Resolver unificado — did:pki + did:sns en un solo servicio HTTP.</div>
            <span class="repo-tag">Infraestructura</span>
          </div>
        </a>
        <a href="https://github.com/Attestto-com/attestto-verify" class="repo">
          <img src="/github.svg" class="repo-icon" alt="GitHub" />
          <div>
            <div class="repo-name">attestto-verify</div>
            <div class="repo-desc">Componentes web de verificación de documentos — arrastra un PDF, verifica la matemática.</div>
            <span class="repo-tag">Web</span>
          </div>
        </a>
        <a href="https://github.com/Attestto-com/attestto-trust" class="repo">
          <img src="/github.svg" class="repo-icon" alt="GitHub" />
          <div>
            <div class="repo-name">attestto-trust</div>
            <div class="repo-desc">Almacén de confianza PKI multipaís — espejo público independiente de raíces CA nacionales.</div>
            <span class="repo-tag">Confianza</span>
          </div>
        </a>
        <a href="https://github.com/Attestto-com/cr-vc-sdk" class="repo">
          <img src="/github.svg" class="repo-icon" alt="GitHub" />
          <div>
            <div class="repo-name">cr-vc-sdk</div>
            <div class="repo-desc">SDK tipado para emitir y verificar credenciales de Costa Rica.</div>
            <span class="repo-tag">Costa Rica</span>
          </div>
        </a>
        <a href="https://github.com/Attestto-com/attestto-mesh" class="repo">
          <img src="/github.svg" class="repo-icon" alt="GitHub" />
          <div>
            <div class="repo-name">attestto-mesh</div>
            <div class="repo-desc">Mesh de datos P2P sobre libp2p — sincronización cifrada de estado para identidad soberana.</div>
            <span class="repo-tag">Red</span>
          </div>
        </a>
        <a href="https://github.com/Attestto-com/cr-vc-schemas" class="repo">
          <img src="/github.svg" class="repo-icon" alt="GitHub" />
          <div>
            <div class="repo-name">cr-vc-schemas</div>
            <div class="repo-desc">Esquemas JSON-LD para tipos de credenciales de Costa Rica. W3C VDL + ISO 18013-5.</div>
            <span class="repo-tag">Costa Rica</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Audience Routing -->
  <section id="adopt" class="section-light">
    <div class="container">
      <div class="section-label">Empieza aquí</div>
      <h2 class="section-title">Construido para ser desplegado</h2>
      <div class="audience-grid">
        <a href="/cr" class="audience-card">
          <h3>Gobiernos</h3>
          <p>Despliega infraestructura de identidad soberana. Emite documentos públicos verificables. Interopera entre jurisdicciones.</p>
          <span class="audience-cta">Ver despliegue en Costa Rica &rarr;</span>
        </a>
        <a href="/es/ark/desktop" class="audience-card">
          <h3>Profesionales</h3>
          <p>Credenciales verificables para tu licencia, firma y competencia. Emitidas por tu Colegio, en tu dispositivo.</p>
          <span class="audience-cta">Explorar Station &rarr;</span>
        </a>
        <a href="/es/standards" class="audience-card">
          <h3>Organismos de estándares</h3>
          <p>Dos métodos DID W3C, integración con DIF Universal Resolver, vectores de prueba abiertos e implementaciones funcionales.</p>
          <span class="audience-cta">Revisar los estándares &rarr;</span>
        </a>
        <a href="https://github.com/Attestto-com" class="audience-card">
          <h3>Desarrolladores</h3>
          <p>Bifurca los SDKs, extiende los esquemas, implementa nuevos métodos DID o construye módulos para el marketplace de credenciales.</p>
          <span class="audience-cta">Ver en GitHub &rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Principles (compact) -->
  <section id="principles" class="section-dark">
    <div class="container">
      <div class="section-label">Principios</div>
      <h2 class="section-title">Lo que defendemos</h2>
      <div class="principles-row">
        <div class="principle-item">
          <strong>Soberanía</strong>
          <span>Tus llaves, tu dispositivo, tus datos.</span>
        </div>
        <div class="principle-item">
          <strong>Interoperabilidad</strong>
          <span>Solo estándares W3C, IETF, ISO.</span>
        </div>
        <div class="principle-item">
          <strong>Privacidad</strong>
          <span>Divulgación selectiva por defecto.</span>
        </div>
        <div class="principle-item">
          <strong>Portabilidad</strong>
          <span>Bifúrcalo, expórtalo, migra libremente.</span>
        </div>
        <div class="principle-item">
          <strong>Transparencia</strong>
          <span>Código abierto, gobernanza abierta, auditoría abierta.</span>
        </div>
        <div class="principle-item">
          <strong>Neutralidad</strong>
          <span>Tú eliges la tecnología, no nosotros.</span>
        </div>
        <div class="principle-item">
          <strong>Bien público</strong>
          <span>Gratis para ciudadanos, para siempre.</span>
        </div>
      </div>
      <div style="margin-top: var(--space-md);">
        <a href="/es/why" class="btn btn-outline">Lee la historia completa &rarr;</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ── Use Case Cards ── */
  .usecases-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  .usecase-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
  }

  .usecase-card h3 {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-ink);
    margin-bottom: 0.5rem;
  }

  .usecase-card p {
    font-size: 0.875rem;
    color: var(--color-ink-muted);
    line-height: 1.6;
    flex: 1;
  }

  .usecase-card code {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    background: #f1f5f9;
    padding: 0.1rem 0.3rem;
    border-radius: 3px;
  }

  .usecase-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-top: var(--space-sm);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-border);
  }

  .usecase-status {
    font-size: 0.6875rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .usecase-status.live { background: #dcfce7; color: #15803d; }
  .usecase-status.poc { background: #dbeafe; color: #1e40af; }
  .usecase-status.building { background: #fef3c7; color: #92400e; }
  .usecase-status.proposed { background: #f3e8ff; color: #6b21a8; }
  .usecase-status.planned { background: #f1f5f9; color: #475569; }

  .usecase-link {
    font-size: 0.8125rem;
    color: var(--color-accent);
    font-weight: 500;
    margin-left: auto;
  }

  /* ── Surface Cards ── */
  .surfaces-grid {
    gap: var(--space-sm) !important;
  }

  .surface-card {
    position: relative;
    padding-top: calc(var(--space-md) + 0.5rem) !important;
  }

  .surface-badge {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    font-size: 0.6875rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .surface-badge.live { background: #dcfce7; color: #15803d; }
  .surface-badge.soon { background: rgba(255,255,255,0.1); color: rgba(255,255,255,0.5); }

  .surface-link {
    display: inline-block;
    margin-top: var(--space-xs);
    font-size: 0.875rem;
    color: #4ade80;
    font-weight: 500;
  }

  /* ── Standards Row ── */
  .standards-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  .standard-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: var(--space-md);
  }

  .standard-name {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-accent);
    display: block;
    margin-bottom: 0.5rem;
  }

  .standard-card p {
    font-size: 0.875rem;
    color: var(--color-ink-muted);
    line-height: 1.6;
  }

  .standard-links {
    display: flex;
