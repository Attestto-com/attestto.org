---
import Base from '../../../layouts/Base.astro'

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Arquitectura Attestto — Infraestructura Soberana de Identidad Digital",
    "url": "https://attestto.org/es/ark",
    "description": "La arquitectura completa para identidad digital soberana. Station, Web Extension, Mesh, Ceremony, Trust.",
    "inLanguage": "es"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Que es la arquitectura de Attestto?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "La arquitectura de Attestto tiene cinco pilares: Station (app de escritorio con vault, firmador, verificador, nodo mesh), Web Extension (verificacion de certificados a nivel de navegador), Mesh (red peer-to-peer de verificacion de credenciales), Ceremony (gobernanza de llaves CA con Shamir secret sharing) y Trust (almacen de confianza PKI multi-pais)."
        }
      },
      {
        "@type": "Question",
        "name": "Attestto requiere un servidor central?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. Attestto usa una red mesh peer-to-peer donde cada nodo puede verificar credenciales de forma independiente, incluso sin conexion. No hay un servidor central que almacene tus datos o controle el acceso. Los timestamps criptograficos se anclan en un ledger publico para auditabilidad."
        }
      },
      {
        "@type": "Question",
        "name": "Que es la escalera de confianza de Attestto?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "La escalera de confianza define cuatro niveles de verificacion de identidad: C (auto-declarado), B (verificado con documento de identidad gubernamental), A+ (credencial profesional verificada) y A (atestacion institucional). Cada nivel desbloquea diferentes capacidades y tipos de credenciales."
        }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Attestto", "item": "https://attestto.org/es" },
      { "@type": "ListItem", "position": 2, "name": "Arquitectura", "item": "https://attestto.org/es/ark" }
    ]
  }
]
---

<Base
  structuredData={structuredData}
  title="Attestto Open · Ark — Infraestructura Soberana de Identidad Digital"
  description="La arquitectura completa para identidad digital soberana. Station, Web Extension, Mesh, Ceremony, Trust — todo lo que una institucion necesita para emitir, verificar y gobernar credenciales verificables."
  canonicalPath="/es/ark"
  ogTitle="Attestto Open · Ark — Infraestructura Soberana de Identidad Digital"
  ogDescription="La arquitectura completa para identidad digital soberana. Verificacion de escritorio, credenciales moviles, mesh P2P, ceremonias de llaves CA y gobernanza de confianza."
  navVariant="default"
  footerVariant="default"
  lang="es"
  footerNotes={[
    'Datos de confianza PKI provienen de <a href="https://trust.attestto.com">trust.attestto.com</a> — espejo publico independiente, no una publicacion oficial del gobierno.',
    'Los nombres de dominio listados son retenidos por Attestto como anclas de gobernanza; los dominios especificos de cada institucion se transferiran a los entes respectivos al formalizarse los acuerdos.',
  ]}
>
  <Fragment slot="head">
    <meta property="og:locale:alternate" content="en_US" />
    <meta name="keywords" content="arquitectura de identidad, identidad soberana, verificacion de escritorio, mesh P2P, ceremonia de llaves CA, gobernanza de confianza, credenciales verificables, DID, codigo abierto, Attestto Ark" />
  </Fragment>

  <!-- Hero (dark) -->
  <section class="hero">
    <div class="container">
      <div class="hero-text">
        <h1><span data-i18n="ark.hero_title_1">Infraestructura soberana</span> <span data-i18n="ark.hero_title_3"></span> <em data-i18n="ark.hero_title_2">de identidad digital</em></h1>
        <p class="lead" data-i18n="ark.lead">La infraestructura para emitir, verificar y gobernar credenciales verificables — codigo abierto, soberana por diseno, y construida para que cualquier institucion participe en la raiz de confianza. Sin punto unico de falla. Sin punto unico de control.</p>
        <div class="hero-actions">
          <a href="#contact" class="btn btn-primary" data-i18n="ark.btn_board">Contactanos</a>
          <a href="#components" class="btn btn-secondary" data-i18n="ark.btn_explore">Explorar la arquitectura</a>
        </div>
      </div>
      <div class="hero-layers">
        <div class="hero-layer">
          <span class="hero-layer-num">01</span>
          <span class="hero-layer-label" data-i18n="ark.station_title">Station</span>
          <span class="hero-layer-desc" data-i18n="ark.hero_station_desc">Verifica, firma y resguarda tus documentos — todo en tu propia computadora. Nada sale de tu equipo a menos que vos lo decidas.</span>
        </div>
        <div class="hero-layer">
          <span class="hero-layer-num">02</span>
          <span class="hero-layer-label" data-i18n="ark.ext_title">Web Extension</span>
          <span class="hero-layer-desc" data-i18n="ark.hero_ext_desc">Inicia sesion en cualquier sitio web sin usuario ni contrasena y firma documentos con un clic — tus datos privados, tus cuentas tuyas.</span>
        </div>
        <div class="hero-layer">
          <span class="hero-layer-num">03</span>
          <span class="hero-layer-label" data-i18n="ark.mesh_title">Mesh</span>
          <span class="hero-layer-desc" data-i18n="ark.hero_mesh_desc">Stations, extensiones y apps moviles pueden unirse a una red compartida y cifrada — tus datos viven en la comunidad, no en un solo servidor.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Principio de Derechos Ciudadanos (callout manifiesto) -->
  <section class="section-light rights-callout">
    <div class="container">
      <div class="rights-callout-badge">
        <span class="rights-callout-dot"></span>
        <span data-i18n="ark.rights_label">Un principio fundacional</span>
      </div>
      <h2 data-i18n="ark.rights_title">Gratis para los ciudadanos. Siempre.</h2>
      <p data-i18n="ark.rights_desc">Identidad, firma, anclaje, recuperacion y verificacion son derechos ciudadanos — no servicios. Son gratis para siempre, para cada persona a la que Ark llegue, en cada pais donde opere. El comercio financia la red para que los ciudadanos nunca tengan que pagar. Sin niveles premium. Sin barreras. Sin excepciones.</p>
    </div>
  </section>

  <!-- Personas (dark) -->
  <section id="who" class="section-dark">
    <div class="container">
      <div class="section-label" data-i18n="ark.who_label">Para quien es esto</div>
      <h2 class="section-title" data-i18n="ark.who_title">Para quien es esto</h2>
      <p class="section-desc" data-i18n="ark.who_desc">Ark es infraestructura viva ofrecida a las instituciones, profesionales y desarrolladores que tienen que hacer realidad la identidad digital soberana. Encuentra el rol que te corresponde.</p>
      <div class="persona-grid">
        <div class="persona-card">
          <span class="persona-tag" data-i18n="ark.persona1_tag">Gobierno</span>
          <h3 data-i18n="ark.persona1_title">Regulador o institucion publica</h3>
          <p data-i18n="ark.persona1_desc">Reguladores nacionales e instituciones publicas. Evalua la arquitectura, solicita un briefing y explora la participacion institucional.</p>
          <a class="persona-cta" href="mailto:open@attestto.com?subject=Ark%20%E2%80%94%20Briefing%20institucional" data-i18n="ark.persona1_cta">Solicitar briefing institucional &rarr;</a>
        </div>
        <div class="persona-card">
          <span class="persona-tag" data-i18n="ark.persona2_tag">Notario &middot; Abogado &middot; Contador</span>
          <h3 data-i18n="ark.persona2_title">Usuario diario de Firma Digital</h3>
          <p data-i18n="ark.persona2_desc">Si convivis todos los dias con el banner rojo "validez de firma desconocida", Station esta hecho para vos. Verifica PDFs firmados con CR Firma Digital de forma nativa.</p>
          <a class="persona-cta" href="mailto:open@attestto.com?subject=Ark%20%E2%80%94%20Station%20para%20profesionales" data-i18n="ark.persona2_cta">Acceso anticipado a Station &rarr;</a>
        </div>
        <div class="persona-card">
          <span class="persona-tag" data-i18n="ark.persona3_tag">Institucion</span>
          <h3 data-i18n="ark.persona3_title">Banco, aseguradora, universidad, operador KYC</h3>
          <p data-i18n="ark.persona3_desc">Corré un piloto sobre un flujo real de onboarding o firma. Emiti credenciales verificables que tus contrapartes puedan validar offline.</p>
          <a class="persona-cta" href="mailto:open@attestto.com?subject=Ark%20%E2%80%94%20Piloto%20institucional" data-i18n="ark.persona3_cta">Proponer un piloto &rarr;</a>
        </div>
        <div class="persona-card">
          <span class="persona-tag" data-i18n="ark.persona4_tag">Desarrollador</span>
          <h3 data-i18n="ark.persona4_title">Contribuidor open source</h3>
          <p data-i18n="ark.persona4_desc">Cada componente es codigo abierto. Leé el codigo, abrí issues, manda un modulo, forkeá un despliegue de pais.</p>
          <a class="persona-cta" href="https://github.com/Attestto-com" data-i18n="ark.persona4_cta">Ver los repos en GitHub &rarr;</a>
        </div>
        <div class="persona-card">
          <span class="persona-tag" data-i18n="ark.persona5_tag">Aliado LATAM</span>
          <h3 data-i18n="ark.persona5_title">Operador fuera de Costa Rica</h3>
          <p data-i18n="ark.persona5_desc">Levanta una CA soberana en tu jurisdiccion con tus propios accionistas y tu propia ceremonia. La arquitectura es uno-por-pais por diseno.</p>
          <a class="persona-cta" href="mailto:open@attestto.com?subject=Ark%20%E2%80%94%20Despliegue%20por%20pa%C3%ADs" data-i18n="ark.persona5_cta">Desplegá en tu pais &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Componentes (light) -->
  <section id="components" class="section-light">
    <div class="container">
      <div class="section-label" data-i18n="ark.comp_label">Componentes</div>
      <h2 class="section-title" data-i18n="ark.comp_title">Cinco pilares, una arquitectura</h2>
      <p class="section-desc" data-i18n="ark.comp_desc">Empieza con un componente y crece hacia la infraestructura completa. Incorporacion progresiva — desplega Station hoy, agrega la Web Extension manana, unite al Mesh cuando estes listo. Cada paso suma, y el todo es mas que la suma de sus partes.</p>
      <div class="grid-3">
        <div class="card">
          <div class="card-icon">&#9633;</div>
          <h3 data-i18n="ark.station_title">Station</h3>
          <p data-i18n="ark.station_desc">Aplicacion de escritorio Electron. Tu estacion de verificacion, boveda de credenciales y nodo de la red mesh.</p>
          <ul>
            <li data-i18n="ark.station_l1">Verificacion de documentos con OCR y padron</li>
            <li data-i18n="ark.station_l2">Boveda cifrada local con xsalsa20-poly1305 + scrypt</li>
            <li data-i18n="ark.station_l3">Firma electronica hoy; Firma Digital con tarjeta inteligente (PKCS#11) planeado</li>
            <li data-i18n="ark.station_l4">Cada instalacion puede unirse a la red como nodo</li>
          </ul>
        </div>
        <div class="card">
          <div class="card-icon">&#9671;</div>
          <h3 data-i18n="ark.ext_title">Web Extension</h3>
          <p data-i18n="ark.ext_desc">Extension de navegador que valida firmas de documentos y confianza CA en la pagina, muestra un puntaje de confianza y se conecta a Station para flujos de verificacion.</p>
          <ul>
            <li data-i18n="ark.ext_l1">Validacion de certificados del lado del cliente</li>
            <li data-i18n="ark.ext_l2">Puntaje de confianza visible en el navegador</li>
            <li data-i18n="ark.ext_l3">Descubrimiento de wallet adapter para firma</li>
            <li data-i18n="ark.ext_l4">Conecta paginas del navegador con Station</li>
          </ul>
        </div>
        <div class="card">
          <div class="card-icon">&#8857;</div>
          <h3 data-i18n="ark.mesh_title">Mesh</h3>
          <p data-i18n="ark.mesh_desc">Red P2P cifrada sobre libp2p. Sincronizacion de estado entre dispositivos locales y nodos nacionales sin servidor central.</p>
          <ul>
            <li data-i18n="ark.mesh_l1">Principio del Courier Ciego — los nodos no pueden leer los datos que transportan</li>
            <li data-i18n="ark.mesh_l2">Huella compacta por ciudadano</li>
            <li data-i18n="ark.mesh_l3">Funciona offline, sincroniza cuando conecta</li>
            <li data-i18n="ark.mesh_l4">Anclaje criptografico en ledger publico</li>
          </ul>
        </div>
        <div class="card">
          <div class="card-icon">&#9881;</div>
          <h3 data-i18n="ark.ceremony_title">Ceremony</h3>
          <p data-i18n="ark.ceremony_desc">Appliance soberano para ceremonias de llaves CA. Laptop air-gapped con Linux, distribucion de fragmentos Shamir por mesh local.</p>
          <ul>
            <li data-i18n="ark.ceremony_l1">Laptop Linux limpio (live USB)</li>
            <li data-i18n="ark.ceremony_l2">La llave se divide, la original se destruye</li>
            <li data-i18n="ark.ceremony_l3">Verificacion vLEI de accionistas (planeado)</li>
            <li data-i18n="ark.ceremony_l4">Soporte PKCS#11 por jurisdiccion (planeado)</li>
          </ul>
        </div>
        <div class="card">
          <div class="card-icon">&#9741;</div>
          <h3 data-i18n="ark.trust_title">Trust</h3>
          <p data-i18n="ark.trust_desc">Marco de confianza CA con accionistas Shamir, transparencia on-chain y gobernanza distribuida entre instituciones.</p>
          <ul>
            <li data-i18n="ark.trust_l1">Llave CA dividida: 2-de-3 hoy, extensible a 3-de-5 con socios institucionales</li>
            <li data-i18n="ark.trust_l2">Raiz de confianza en vault.attestto.sol</li>
            <li data-i18n="ark.trust_l3">Transparencia auditable en blockchain</li>
            <li data-i18n="ark.trust_l4">Ningun actor tiene control unilateral</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Como funciona (dark) -->
  <section id="how" class="section-dark">
    <div class="container">
      <div class="section-label" data-i18n="ark.how_label">Como funciona</div>
      <h2 class="section-title" data-i18n="ark.how_title">Verificacion de escritorio a movil</h2>
      <p class="section-desc" data-i18n="ark.how_desc">El escritorio y el telefono trabajan juntos sobre WiFi local. Las imagenes y datos biometricos nunca salen de tu red — la conexion es directa, sin servidores ni nube.</p>
      <div class="grid-3">
        <div class="card">
          <div class="card-icon">1</div>
          <h3 data-i18n="ark.step1_title">Abrí Station en tu escritorio</h3>
          <p data-i18n="ark.step1_desc">Selecciona el tipo de documento a verificar. Station genera un codigo QR unico para la sesion.</p>
        </div>
        <div class="card">
          <div class="card-icon">2</div>
          <h3 data-i18n="ark.step2_title">Escaneá el QR con tu telefono</h3>
          <p data-i18n="ark.step2_desc">El QR abre la app movil con la conexion WebSocket preconfigurada. Tu telefono se conecta directamente a tu escritorio.</p>
        </div>
        <div class="card">
          <div class="card-icon">3</div>
          <h3 data-i18n="ark.step3_title">Captura documento y selfie</h3>
          <p data-i18n="ark.step3_desc">Frente, reverso del documento y selfie con prueba de vida (deteccion de parpadeo). Todo se transmite en tiempo real al escritorio.</p>
        </div>
        <div class="card">
          <div class="card-icon">4</div>
          <h3 data-i18n="ark.step4_title">Procesamiento automatico</h3>
          <p data-i18n="ark.step4_desc">Station ejecuta OCR, extrae datos del MRZ, valida el documento y genera la credencial verificable.</p>
        </div>
        <div class="card">
          <div class="card-icon">5</div>
          <h3 data-i18n="ark.step5_title">Credencial en tu boveda</h3>
          <p data-i18n="ark.step5_desc">La credencial se almacena cifrada en la boveda local. Firmala con Firma Digital, anclala en un ledger publico o compartela via presentacion verificable.</p>
        </div>
      </div>

      <div class="arch-subsection">
        <div>
          <h3 class="arch-subsection-title" data-i18n="ark.arch_title">Arquitectura de red local</h3>
          <p class="arch-subsection-desc" data-i18n="ark.arch_desc">La conexion entre escritorio y movil es directa por WiFi local. No hay servidores intermedios, no hay nube, no hay dependencia de internet.</p>
          <p class="arch-note" data-i18n="ark.arch_note">Privacidad no es una politica — es una garantia matematica.</p>
        </div>
        <div class="arch-layers">
          <div class="arch-layer">
            <span class="arch-layer-num">&#9633;</span>
            <span class="arch-layer-name">Station</span>
            <span class="arch-layer-desc">WebSocket + OCR + Padron + Boveda</span>
          </div>
          <div class="arch-layer">
            <span class="arch-layer-num">&#8597;</span>
            <span class="arch-layer-name">WiFi local</span>
            <span class="arch-layer-desc">Sin internet, conexion directa</span>
          </div>
          <div class="arch-layer">
            <span class="arch-layer-num">&#9671;</span>
            <span class="arch-layer-name">Web Extension</span>
            <span class="arch-layer-desc">Camara + Prueba de vida + VCs</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Gobernanza CA (light) -->
  <section id="governance" class="section-light">
    <div class="container">
      <div class="section-label" data-i18n="ark.gov_label">Gobernanza CA</div>
      <h2 class="section-title" data-i18n="ark.gov_title">Confianza distribuida por diseno</h2>
      <p class="section-desc" data-i18n="ark.gov_desc">La llave privada de la Autoridad Certificadora se divide usando Shamir's Secret Sharing. Ningun actor individual — incluyendo Attestto — puede firmar unilateralmente.</p>
      <div class="grid-3">
        <div class="card">
          <div class="card-icon">&#8902;</div>
          <h3 data-i18n="ark.sss_title">Shamir's Secret Sharing</h3>
          <p data-i18n="ark.sss_desc">La llave CA Ed25519 se genera en una ceremonia air-gapped y se divide en N fragmentos. Se requiere un umbral K para reconstruirla. La llave original se destruye.</p>
          <div class="detail-box">
            <div><span class="hl">Fase 1A (actual):</span> 2-de-3 solo fundadores</div>
            <div><span class="hl">Fase 1B:</span> redistribucion a 3-de-5 al incorporar socios institucionales</div>
            <div><span class="hl">Fase 2+:</span> el umbral crece con el conjunto de accionistas</div>
          </div>
        </div>
        <div class="card">
          <div class="card-icon">&#9878;</div>
          <h3 data-i18n="ark.shareholders_title">Accionistas institucionales</h3>
          <p data-i18n="ark.shareholders_desc">La Fase 1A es solo para fundadores con todos los fragmentos en poder de Attestto. Las posiciones de accionistas institucionales estan reservadas para la Fase 1B cuando se incorporen socios formales. Cada fragmento solo es inutil — solo cuando el umbral se reune, la llave se reconstruye temporalmente.</p>
          <div class="detail-box">
            <div><span class="hl">Attestto</span> — Operador tecnico (Fase 1A — actual)</div>
            <div><span class="hl">Reservado</span> — Posiciones de socios institucionales (Fase 1B)</div>
            <div><span class="hl">Reservado</span> — Posicion de auditor independiente (Fase 1B)</div>
          </div>
        </div>
        <div class="card">
          <div class="card-icon">&#9830;</div>
          <h3 data-i18n="ark.onchain_title">Registro publico de atestaciones</h3>
          <p data-i18n="ark.onchain_desc">Ark es agnostico de cadena por diseno. Los estandares W3C VC, W3C DID, GLEIF vLEI y eIDAS no dependen de ningun ledger en particular. Los eventos CA se registran como atestaciones publicas on-chain — brindando nombramiento soberano, compromiso publico sub-segundo y un costo por evento compatible con despliegues institucionales. Cada jurisdiccion puede elegir su capa de anclaje segun lo requieran sus socios institucionales; las credenciales emitidas bajo un ancla siguen siendo verificables bajo otra.</p>
          <div class="detail-box">
            <div><span class="hl">Raiz:</span> vault.attestto.sol</div>
            <div><span class="hl">Registro:</span> Cada evento CA &rarr; atestacion on-chain (planeado)</div>
            <div><span class="hl">Verificacion:</span> Publica y abierta</div>
          </div>
        </div>
      </div>

      <div class="arch-subsection">
        <div>
          <h3 class="arch-subsection-title" data-i18n="ark.vlei_title">Verificacion vLEI</h3>
          <p class="arch-subsection-desc" data-i18n-html="ark.vlei_desc">El marco requiere que cada accionista posea un LEI (Legal Entity Identifier) verificado y un vLEI emitido por <a href="https://www.gleif.org/en/vlei/introducing-the-vlei" target="_blank" rel="noopener">GLEIF</a> antes de participar en una ceremonia, para que representen legitimamente a su institucion. La via de verificacion on-chain esta planeada.</p>
        </div>
        <div>
          <div class="detail-box">
            <div><span class="hl">Pre-requisito:</span> LEI activo + vLEI emitido</div>
            <div><span class="hl">Verificacion:</span> Atestacion on-chain (planeado)</div>
            <div><span class="hl">Estandar:</span> GLEIF + ISO 17442</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Ceremonia (dark) -->
  <section id="ceremony" class="section-dark">
    <div class="container">
      <div class="section-label" data-i18n="ark.cer_label">Ceremonia de llaves</div>
      <h2 class="section-title" data-i18n="ark.cer_title">Soberano, air-gapped, verificable</h2>
      <p class="section-desc" data-i18n="ark.cer_desc">La ceremonia de generacion de llaves CA ocurre en un ambiente completamente aislado. No hay conexion a internet. La unica red es un mesh local cifrado entre los dispositivos de los accionistas.</p>
      <div class="grid-3">
        <div class="card">
          <div class="card-icon">&#9875;</div>
          <h3 data-i18n="ark.appliance_title">El appliance soberano</h3>
          <p data-i18n="ark.appliance_desc">Un laptop Linux limpio arranca desde USB live. Sin disco duro, sin historial, sin red externa. El software de la ceremonia crea un mesh WiFi privado para distribuir los fragmentos Shamir a los dispositivos de los accionistas.</p>
          <ul>
            <li>Linux live USB — sin disco duro</li>
            <li>Mesh WiFi local — sin internet</li>
            <li>Genera par de llaves Ed25519</li>
            <li>Divide en fragmentos Shamir</li>
            <li>Destruye la llave original</li>
            <li>Ceremonia auditable y filmada</li>
          </ul>
        </div>
        <div class="card">
          <div class="card-icon">&#8634;</div>
          <h3 data-i18n="ark.types_title">Tipos de ceremonia</h3>
          <p data-i18n="ark.types_desc">El sistema soporta diferentes ceremonias segun el ciclo de vida de la CA.</p>
          <div class="detail-box">
            <div><span class="hl">Genesis:</span> Primera generacion de llave CA</div>
            <div><span class="hl">Rotacion:</span> Redistribucion con nuevos accionistas</div>
            <div><span class="hl">Firma:</span> Reconstruccion para firmar certificados</div>
            <div><span class="hl">Revocacion:</span> Revocar llave comprometida</div>
          </div>
        </div>
        <div class="card">
          <div class="card-icon">&#9789;</div>
          <h3 data-i18n="ark.multi_title">Multi-jurisdiccion</h3>
          <p data-i18n="ark.multi_desc">Cada pais tiene su propio esquema de firma electronica. El appliance soporta PKCS#11 para integrarse con hardware de firma local.</p>
          <div class="detail-box">
            <div><span class="hl">Costa Rica:</span> Marco nacional de firma digital (planeado)</div>
            <div><span class="hl">Brasil:</span> Infraestructura nacional de PKI (planeado)</div>
            <div><span class="hl">Mexico:</span> Firma electronica federal (planeado)</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TLS (light) -->
  <section id="tls" class="section-light">
    <div class="container">
      <div class="section-label" data-i18n="ark.tls_label">TLS descentralizado</div>
      <h2 class="section-title" data-i18n="ark.tls_title">Cuatro caminos hacia la web soberana</h2>
      <p class="section-desc" data-i18n="ark.tls_desc">El objetivo final: que los certificados TLS emitidos por Attestto CA sean reconocidos nativamente por los navegadores. Hay cuatro caminos paralelos, cada uno con diferente horizonte temporal.</p>
      <div class="timeline-item">
        <div class="timeline-when" data-i18n="ark.tls1_when">Ahora</div>
        <div class="timeline-content">
          <h3 data-i18n="ark.tls1_title">Extension de navegador</h3>
          <p data-i18n="ark.tls1_desc">La extension Attestto ID valida certificados del lado del cliente contra vault.attestto.sol y muestra un puntaje de confianza soberana en el navegador. Despliegue desde el dia uno, sin cambios en infraestructura DNS.</p>
        </div>
      </div>
      <div class="timeline-item">
        <div class="timeline-when" data-i18n="ark.tls2_when">6 meses</div>
        <div class="timeline-content">
          <h3 data-i18n="ark.tls2_title">DANE / TLSA</h3>
          <p data-i18n="ark.tls2_desc">Publicar registros TLSA en DNS que apunten a certificados Attestto CA. Requiere que el dominio use DNSSEC. Los validadores DANE ya existen en algunos navegadores.</p>
        </div>
      </div>
      <div class="timeline-item">
        <div class="timeline-when" data-i18n="ark.tls3_when">12 meses</div>
        <div class="timeline-content">
          <h3 data-i18n="ark.tls3_title">Proxy de verificacion</h3>
          <p data-i18n="ark.tls3_desc">Un servicio puente que permite a los sitios publicar su certificado emitido por Attestto junto a un certificado de confianza global, para que los navegadores sin DANE ni la extension sigan viendo una cadena valida mientras el certificado soberano es reconocido por los clientes participantes.</p>
        </div>
      </div>
      <div class="timeline-item">
        <div class="timeline-when" data-i18n="ark.tls4_when">2-5 anos</div>
        <div class="timeline-content">
          <h3 data-i18n="ark.tls4_title">Estandares W3C / IETF</h3>
          <p data-i18n="ark.tls4_desc">Participar en grupos de trabajo para que los navegadores reconozcan nativamente raices CA ancladas en registros descentralizados (blockchain, IPNS, nombramiento descentralizado).</p>
        </div>
      </div>
    </div>
  </section>

