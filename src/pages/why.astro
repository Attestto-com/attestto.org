---
import Base from '../layouts/Base.astro'

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "Why Attestto Exists — The Story Behind Sovereign Identity",
    "description": "Identity shouldn't be a favor granted by an authority. It can be a mathematical proof you carry yourself.",
    "url": "https://attestto.org/why",
    "datePublished": "2026-04-15",
    "dateModified": "2026-04-15",
    "author": {
      "@type": "Person",
      "name": "Eduardo Chongkan",
      "jobTitle": "Founder",
      "url": "https://attestto.org"
    },
    "publisher": {
      "@type": "Organization",
      "name": "Attestto",
      "url": "https://attestto.org",
      "logo": "https://attestto.org/logo.svg"
    },
    "mainEntityOfPage": "https://attestto.org/why"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is Attestto?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Attestto is open-source public infrastructure for sovereign digital identity. It provides W3C-compliant Decentralized Identifiers (DIDs), Verifiable Credentials, a peer-to-peer mesh network, and ledger anchoring — all without central servers or vendor lock-in. Licensed under Apache 2.0."
        }
      },
      {
        "@type": "Question",
        "name": "Is Attestto free?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Identity, signature, anchoring, recovery, and verification are free for citizens, forever. Commerce-layer features (professional credential issuance, module marketplace) have fee structures that fund the free tier."
        }
      },
      {
        "@type": "Question",
        "name": "What standards does Attestto use?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Attestto uses only W3C, IETF, and ISO standards: W3C Decentralized Identifiers (DIDs), W3C Verifiable Credentials, and ISO 18013-5 for mobile driving licenses. Two DID methods (did:pki and did:sns) are on the W3C standards track. No proprietary formats."
        }
      },
      {
        "@type": "Question",
        "name": "Can a government fork Attestto?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Every component is open source under the Apache 2.0 license. Any government can fork the entire stack and deploy it independently, without depending on Attestto. That's by design — public infrastructure should never create vendor dependency."
        }
      },
      {
        "@type": "Question",
        "name": "How does Attestto protect privacy?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Attestto uses selective disclosure by default — you share only what's needed. Your keys stay on your device, your data never leaves without your consent, and the peer-to-peer mesh network verifies credentials without calling a central server. Every credential can be revoked and every key can be deleted."
        }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Attestto", "item": "https://attestto.org" },
      { "@type": "ListItem", "position": 2, "name": "Why", "item": "https://attestto.org/why" }
    ]
  }
]
---

<Base
  structuredData={structuredData}
  title="Why Attestto Exists — The Story Behind Sovereign Identity"
  description="Identity shouldn't be a favor granted by an authority. It can be a mathematical proof you carry yourself. This is why Attestto exists."
  canonicalPath="/why"
  ogTitle="Why Attestto Exists"
  ogDescription="Identity shouldn't be a favor granted by an authority. This is the story of why we built open infrastructure for sovereign identity."
  ogType="article"
>
  <!-- Hero -->
  <section class="why-hero">
    <div class="container">
      <h1 data-i18n="why.title">Your identity. Your proof.</h1>
      <p class="lead" data-i18n="why.lead">Why we built open infrastructure for sovereign identity &mdash; and why it matters that no one owns it.</p>
    </div>
  </section>

  <!-- Section 1: The world as it is -->
  <section class="story-section">
    <div class="container">
      <div class="story-content">
        <div class="story-label" data-i18n="why.s1_label">The world as it is</div>
        <h2 class="story-title" data-i18n="why.s1_title">Identity is something someone else confirms</h2>
        <div class="story-text">
          <p data-i18n="why.s1_p1">In most of the world, proving who you are means carrying a physical card, presenting it to an institution, hoping they believe it, and trusting that whoever holds your data won't misuse it.</p>
          <p data-i18n="why.s1_p2">Your identity exists only when someone else says it does. A government office. A bank. A platform. If they lose your record, revoke your access, or simply close for the day &mdash; you stop being provable.</p>
        </div>
        <div class="pullquote" data-i18n="why.s1_p3">This isn't a technology problem. It's a design choice. And it can be redesigned.</div>
      </div>
    </div>
  </section>

  <!-- Section 2: What goes wrong — cards instead of text wall -->
  <section class="story-section">
    <div class="container">
      <div class="story-content">
        <div class="story-label" data-i18n="why.s2_label">What goes wrong</div>
        <h2 class="story-title" data-i18n="why.s2_title">When identity depends on someone else</h2>
      </div>
      <div class="why-problems-grid">
        <div class="why-problem-card">
          <div class="why-problem-icon">&#x1F30D;</div>
          <p>The professional whose credentials don't travel across borders.</p>
        </div>
        <div class="why-problem-card">
          <div class="why-problem-icon">&#x270D;</div>
          <p>The family whose last name was misspelled at the civil registry &mdash; half of them exist under different identities.</p>
        </div>
        <div class="why-problem-card">
          <div class="why-problem-icon">&#x1F4B0;</div>
          <p>The small business that can't prove it's real to a foreign partner without paying a $15,000 compliance intermediary.</p>
        </div>
        <div class="why-problem-card">
          <div class="why-problem-icon">&#x1F512;</div>
          <p>The vendor who locks five million citizens into a proprietary identity system with no export, no interoperability, and a renewal clause that doubles the price.</p>
        </div>
      </div>
      <div class="story-content" style="margin-top: var(--space-md);">
        <div class="pullquote" data-i18n="why.s2_p3">These aren't hypothetical. They're happening now, in the countries where we live and build.</div>
      </div>
    </div>
  </section>

  <!-- Section 3: The insight (dark) -->
  <section class="story-highlight">
    <div class="container">
      <div class="story-content">
        <div class="story-label" data-i18n="why.s3_label">The insight</div>
        <h2 class="story-title" data-i18n="why.s3_title">Identity doesn't have to be a favor</h2>
        <div class="story-text">
          <p data-i18n-html="why.s3_p1"><strong>Identity can be a mathematical proof you carry yourself.</strong> W3C Decentralized Identifiers and Verifiable Credentials make this technically possible. A cryptographic key pair on your device. A credential signed by an authority you choose to trust. A proof you present without revealing more than you must.</p>
          <p data-i18n-html="why.s3_p2">The technology exists. What didn't exist &mdash; until now &mdash; was open infrastructure to make it deployable. Not a product. Not a platform. <strong>Public infrastructure</strong>, like roads or the postal service. Anyone can use it, anyone can verify it, anyone can fork it.</p>
        </div>
        <div class="why-cta-inline">
          <a href="/standards" class="cta-primary">See the standards we built &rarr;</a>
          <a href="https://verify.attestto.com" class="cta-secondary">Try the verifier &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 4: What we built — visual layers -->
  <section class="story-section">
    <div class="container">
      <div class="story-content">
        <div class="story-label" data-i18n="why.s4_label">What we built</div>
        <h2 class="story-title" data-i18n="why.s4_title">Three layers, zero central servers</h2>
      </div>
      <div class="why-layers">
        <div class="why-layer">
          <div class="why-layer-num">01</div>
          <div class="why-layer-content">
            <h3>Institutional trust</h3>
            <p data-i18n="why.s4_p1">Existing authorities (governments, professional bodies, universities) issue verifiable credentials signed with their own keys. We don't replace them. We give them a standards-based channel to issue digitally what they already issue on paper.</p>
          </div>
        </div>
        <div class="why-layer">
          <div class="why-layer-num">02</div>
          <div class="why-layer-content">
            <h3>Mesh verification</h3>
            <p data-i18n="why.s4_p2">A peer-to-peer network where every node can verify credentials independently, offline, without calling a central server. The credential holder controls what they share and with whom.</p>
          </div>
        </div>
        <div class="why-layer">
          <div class="why-layer-num">03</div>
          <div class="why-layer-content">
            <h3>Ledger anchoring</h3>
            <p data-i18n="why.s4_p3">Cryptographic timestamps on a public ledger prove that a credential existed at a specific time. Not the content &mdash; just the proof that it was issued. Immutable, auditable, independent of Attestto.</p>
          </div>
        </div>
      </div>
      <div class="story-content" style="margin-top: var(--space-md);">
        <div class="pullquote" data-i18n="why.s4_p4">Every component is open source (Apache 2.0). Every standard is W3C or IETF. Any government can fork the entire stack and never depend on us. That's the point.</div>
      </div>
    </div>
  </section>

  <!-- Section 5: The number -->
  <section class="story-highlight why-stat-section">
    <div class="container">
      <div class="why-stat">
        <div class="why-stat-number">100+</div>
        <div class="why-stat-label">countries operate sovereign PKI hierarchies</div>
        <div class="why-stat-desc">Each one is an island. A certificate issued by Costa Rica is unverifiable in Panama. did:pki bridges them all through a single resolver endpoint.</div>
      </div>
    </div>
  </section>

  <!-- Section 6: Commitments (dark) -->
  <section class="story-highlight">
    <div class="container">
      <div class="story-content">
        <div class="story-label" data-i18n="why.s5_label">What we ask of ourselves</div>
        <h2 class="story-title" data-i18n="why.s5_title">Eight commitments, not eight features</h2>
        <div class="story-text">
          <p data-i18n="why.s5_p1">Infrastructure earns trust by what it refuses to do, not by what it promises. These aren't marketing principles. They're constraints we enforce in code.</p>
        </div>
        <ul class="principles-compact">
          <li><strong>Sovereignty</strong> <span>Your keys, your device, your data. No custodian.</span></li>
          <li><strong>Interoperability</strong> <span>W3C, IETF, ISO standards only. No proprietary formats.</span></li>
          <li><strong>Privacy</strong> <span>Selective disclosure by default. Share only what's needed.</span></li>
          <li><strong>Full portability</strong> <span>Fork it, export it, migrate freely. Your data comes with you.</span></li>
          <li><strong>Reversibility</strong> <span>Revoke any credential. Delete any key. No permanent traces.</span></li>
          <li><strong>Transparency</strong> <span>Open source, open governance, open audit.</span></li>
          <li><strong>Neutrality</strong> <span>Chain-agnostic, stack-agnostic. You choose the technology, not us.</span></li>
          <li><strong>Public good</strong> <span>Free for citizens, forever. Commerce pays for commerce.</span></li>
        </ul>

        <div class="founder-note">
          <p>My family's last name is split across the Costa Rican civil registry. A clerical error at birth registration. Half of us exist under one spelling, half under another. Two different legal identities for the same family.</p>
          <p style="margin-top: 0.75rem;">I didn't build Attestto because I read a whitepaper. I built it because I'm a case study.</p>
          <div class="attribution">&mdash; Eduardo Chongkan, founder</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="story-section" style="padding-bottom: var(--space-xl);">
    <div class="container">
      <div class="story-content" style="text-align: center;">
        <h2 class="story-title" data-i18n="why.cta_title">See what we've built</h2>
        <div class="cta-row" style="justify-content: center;">
          <a href="/standards" class="cta-primary">Explore the standards &rarr;</a>
          <a href="/ark" class="cta-secondary">Architecture &rarr;</a>
          <a href="https://github.com/Attestto-com" class="cta-secondary">GitHub &rarr;</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ── Pull Quote ── */
  .pullquote {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-ink);
    border-left: 3px solid var(--color-accent);
    padding-left: var(--space-sm);
    margin-top: var(--space-md);
    line-height: 1.5;
  }

  .story-highlight .pullquote {
    color: #ffffff;
    border-left-color: #4ade80;
  }

  /* ── Problem Cards ── */
  .why-problems-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }

  .why-problem-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: var(--space-sm) var(--space-md);
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
  }

  .why-problem-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .why-problem-card p {
    font-size: 0.9375rem;
    color: var(--color-ink-muted);
    line-height: 1.6;
    margin: 0;
  }

  /* ── Inline CTA ── */
  .why-cta-inline {
    display: flex;
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }

  /* ── Layer Cards ── */
  .why-layers {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }

  .why-layer {
    display: flex;
    gap: var(--space-md);
    padding: var(--space-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
  }

  .why-layer-num {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-accent);
    flex-shrink: 0;
    line-height: 1;
    margin-top: 0.2rem;
  }

  .why-layer-content h3 {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-ink);
    margin-bottom: 0.5rem;
  }

  .why-layer-content p {
    font-size: 0.9375rem;
    color: var(--color-ink-muted);
    line-height: 1.6;
    margin: 0;
  }

  /* ── Stat Section ── */
  .why-stat-section {
    padding: var(--space-lg) 0;
  }

  .why-stat {
    text-align: center;
    max-width: 36rem;
    margin: 0 auto;
  }

  .why-stat-number {
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 800;
    color: #4ade80;
    line-height: 1;
    margin-bottom: var(--space-xs);
  }

  .why-stat-label {
    font-size: 1.25rem;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: var(--space-xs);
  }

  .why-stat-desc {
    font-size: 0.9375rem;
    color: rgba(255, 255, 255, 0.5);
    line-height: 1.6;
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .why-problems-grid {
      grid-template-columns: 1fr;
    }

    .why-layer {
      flex-direction: column;
      gap: var(--space-xs);
    }

    .why-cta-inline {
      flex-direction: column;
    }
  }
</style>
