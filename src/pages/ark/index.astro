---
import Base from '../../layouts/Base.astro'

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Attestto Architecture — Sovereign Digital Identity Infrastructure",
    "url": "https://attestto.org/ark",
    "description": "The complete architecture for sovereign digital identity. Station, Web Extension, Mesh, Ceremony, Trust."
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is the Attestto architecture?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Attestto's architecture has five pillars: Station (desktop app with vault, signer, verifier, mesh node), Web Extension (browser-level certificate verification), Mesh (peer-to-peer credential verification network), Ceremony (CA key governance with Shamir secret sharing), and Trust (multi-country PKI trust store)."
        }
      },
      {
        "@type": "Question",
        "name": "Does Attestto require a central server?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. Attestto uses a peer-to-peer mesh network where every node can verify credentials independently, even offline. There is no central server that stores your data or controls access. Cryptographic timestamps are anchored on a public ledger for auditability."
        }
      },
      {
        "@type": "Question",
        "name": "What is the Attestto trust ladder?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The trust ladder defines four identity verification tiers: C (self-attested), B (government ID verified), A+ (professional credential verified), and A (institutional attestation). Each tier unlocks different capabilities and credential types."
        }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Attestto", "item": "https://attestto.org" },
      { "@type": "ListItem", "position": 2, "name": "Architecture", "item": "https://attestto.org/ark" }
    ]
  }
]
---

<Base
  structuredData={structuredData}
  title="Attestto — Architecture for Sovereign Digital Identity"
  description="The complete architecture for sovereign digital identity. Station, Web Extension, Mesh, Ceremony, Trust — everything an institution needs to issue, verify, and govern verifiable credentials."
  canonicalPath="/ark"
  ogTitle="Attestto — Architecture for Sovereign Digital Identity"
  ogDescription="The complete architecture for sovereign digital identity. Desktop verification, mobile credentials, P2P mesh, CA key ceremonies, and trust governance."
  ogImage="https://attestto.org/og-ark.png"
  navVariant="default"
  footerVariant="default"
  footerNotes={[
    'PKI trust data sourced from <a href="https://trust.attestto.com">trust.attestto.com</a> — independent public mirror, not an official government publication.',
    'Domain names listed are held by Attestto as governance anchors; institution-specific domains will transfer to respective bodies upon formal agreements.',
  ]}
>
  <Fragment slot="head">
    <meta name="keywords" content="identity architecture, sovereign identity, desktop verification, P2P mesh, CA key ceremony, trust governance, verifiable credentials, DID, open source, Attestto Ark" />
  </Fragment>

  <!-- Hero (dark) -->
  <section class="hero">
    <div class="container">
      <div class="hero-text">
        <h1><span data-i18n="ark.hero_title_1">Sovereign digital identity</span> <span data-i18n="ark.hero_title_3"></span> <em data-i18n="ark.hero_title_2">infrastructure</em></h1>
        <p class="lead" data-i18n="ark.lead">The infrastructure for issuing, verifying, and governing verifiable credentials — open source, sovereign by design, and built so any institution can participate in the trust root. No single point of failure, no single point of control.</p>
        <div class="hero-actions">
          <a href="#contact" class="btn btn-primary" data-i18n="ark.btn_board">Get in touch</a>
          <a href="#components" class="btn btn-secondary" data-i18n="ark.btn_explore">Explore the architecture</a>
        </div>
      </div>
      <div class="hero-layers">
        <div class="hero-layer">
          <span class="hero-layer-num">01</span>
          <span class="hero-layer-label" data-i18n="ark.station_title">Station</span>
          <span class="hero-layer-desc" data-i18n="ark.hero_station_desc">Verify, sign, and safeguard your documents — all on your own computer. Nothing leaves your device unless you decide.</span>
        </div>
        <div class="hero-layer">
          <span class="hero-layer-num">02</span>
          <span class="hero-layer-label" data-i18n="ark.ext_title">Web Extension</span>
          <span class="hero-layer-desc" data-i18n="ark.hero_ext_desc">Log in to any website with no username and no password, and sign documents with one click — your data stays private, your accounts stay yours.</span>
        </div>
        <div class="hero-layer">
          <span class="hero-layer-num">03</span>
          <span class="hero-layer-label" data-i18n="ark.mesh_title">Mesh</span>
          <span class="hero-layer-desc" data-i18n="ark.hero_mesh_desc">Stations, extensions, and mobile apps can join a shared, encrypted network — your data lives across the community, not on a single server.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Citizen Rights Principle (manifesto callout) -->
  <section class="section-light rights-callout">
    <div class="container">
      <div class="rights-callout-badge">
        <span class="rights-callout-dot"></span>
        <span data-i18n="ark.rights_label">A founding principle</span>
      </div>
      <h2 data-i18n="ark.rights_title">Free for citizens. Always.</h2>
      <p data-i18n="ark.rights_desc">Identity, signing, anchoring, recovery, and verification are citizen rights — not services. They are free forever for every Costa Rican, and for every human Ark reaches. Commerce pays for the network so citizens never have to. No premium tiers. No paywalls. No exceptions.</p>
    </div>
  </section>

  <!-- Personas (dark) -->
  <section id="who" class="section-dark">
    <div class="container">
      <div class="section-label" data-i18n="ark.who_label">Who is this for</div>
      <h2 class="section-title" data-i18n="ark.who_title">Who this is for</h2>
      <p class="section-desc" data-i18n="ark.who_desc">Ark is open infrastructure offered to the institutions, professionals, and developers who have to make sovereign digital identity real. Find the role that fits you.</p>
      <div class="persona-grid">
        <div class="persona-card">
          <span class="persona-tag" data-i18n="ark.persona1_tag">Government</span>
          <h3 data-i18n="ark.persona1_title">Regulator or public institution</h3>
          <p data-i18n="ark.persona1_desc">National regulators and public institutions. Evaluate the architecture, request a briefing, and explore institutional participation.</p>
          <a class="persona-cta" href="mailto:open@attestto.com?subject=Ark%20%E2%80%94%20Institutional%20briefing" data-i18n="ark.persona1_cta">Request institutional briefing &rarr;</a>
        </div>
        <div class="persona-card">
          <span class="persona-tag" data-i18n="ark.persona2_tag">Notary &middot; Lawyer &middot; Accountant</span>
          <h3 data-i18n="ark.persona2_title">Daily Firma Digital user</h3>
          <p data-i18n="ark.persona2_desc">If you live with the "signature validity unknown" red banner every day, Station is built for you. Verify CR-signed PDFs natively.</p>
          <a class="persona-cta" href="mailto:open@attestto.com?subject=Ark%20%E2%80%94%20Station%20for%20professionals" data-i18n="ark.persona2_cta">Get early access to Station &rarr;</a>
        </div>
        <div class="persona-card">
          <span class="persona-tag" data-i18n="ark.persona3_tag">Institution</span>
          <h3 data-i18n="ark.persona3_title">Bank, insurer, university, KYC operator</h3>
          <p data-i18n="ark.persona3_desc">Run a pilot on a real onboarding or signing flow. Issue verifiable credentials your counterparties can verify offline.</p>
          <a class="persona-cta" href="mailto:open@attestto.com?subject=Ark%20%E2%80%94%20Institutional%20pilot" data-i18n="ark.persona3_cta">Propose a pilot &rarr;</a>
        </div>
        <div class="persona-card">
          <span class="persona-tag" data-i18n="ark.persona4_tag">Developer</span>
          <h3 data-i18n="ark.persona4_title">Open source contributor</h3>
          <p data-i18n="ark.persona4_desc">Every component is open source. Read the code, file issues, ship a module, fork a country deployment.</p>
          <a class="persona-cta" href="https://github.com/Attestto-com" data-i18n="ark.persona4_cta">Browse the repos on GitHub &rarr;</a>
        </div>
        <div class="persona-card">
          <span class="persona-tag" data-i18n="ark.persona5_tag">LATAM partner</span>
          <h3 data-i18n="ark.persona5_title">Operator outside Costa Rica</h3>
          <p data-i18n="ark.persona5_desc">Stand up a sovereign CA in your jurisdiction with your own shareholders and your own ceremony. The architecture is one-per-country by design.</p>
          <a class="persona-cta" href="mailto:open@attestto.com?subject=Ark%20%E2%80%94%20Country%20deployment" data-i18n="ark.persona5_cta">Deploy in your country &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Components (light) -->
  <section id="components" class="section-light">
    <div class="container">
      <div class="section-label" data-i18n="ark.comp_label">Components</div>
      <h2 class="section-title" data-i18n="ark.comp_title">Five pillars, one architecture</h2>
      <p class="section-desc" data-i18n="ark.comp_desc">Start with one component and grow into the full architecture. Onboard progressively — deploy Station today, add the Web Extension tomorrow, join the Mesh when ready. Every step adds value, and the full architecture is greater than the sum of its parts.</p>
      <div class="grid-3">
        <div class="card">
          <div class="card-icon">&#9633;</div>
          <h3 data-i18n="ark.station_title">Station</h3>
          <p data-i18n="ark.station_desc">Electron desktop application. Your verification station, credential vault, and mesh network node.</p>
          <ul>
            <li data-i18n="ark.station_l1">Document verification with OCR and census</li>
            <li data-i18n="ark.station_l2">Encrypted local vault with xsalsa20-poly1305 + scrypt</li>
            <li data-i18n="ark.station_l3">Electronic signature today; smartcard Digital Signature (PKCS#11) planned</li>
            <li data-i18n="ark.station_l4">Every installation can join the mesh as a node</li>
          </ul>
        </div>
        <div class="card">
          <div class="card-icon">&#9671;</div>
          <h3 data-i18n="ark.ext_title">Web Extension</h3>
          <p data-i18n="ark.ext_desc">Browser extension that validates document signatures and CA trust in the page, surfaces a trust score, and connects to the Station for verification flows.</p>
          <ul>
            <li data-i18n="ark.ext_l1">Client-side certificate validation</li>
            <li data-i18n="ark.ext_l2">Trust score surfaced in the browser</li>
            <li data-i18n="ark.ext_l3">Wallet adapter discovery for signing</li>
            <li data-i18n="ark.ext_l4">Bridges browser pages to the Station</li>
          </ul>
        </div>
        <div class="card">
          <div class="card-icon">&#8857;</div>
          <h3 data-i18n="ark.mesh_title">Mesh</h3>
          <p data-i18n="ark.mesh_desc">Encrypted P2P network over libp2p. State synchronization between local devices and national nodes without a central server.</p>
          <ul>
            <li data-i18n="ark.mesh_l1">Blind Courier principle — nodes can't read the data they carry</li>
            <li data-i18n="ark.mesh_l2">Compact per-citizen footprint</li>
            <li data-i18n="ark.mesh_l3">Works offline, syncs when connected</li>
            <li data-i18n="ark.mesh_l4">Cryptographic anchoring on a public ledger</li>
          </ul>
        </div>
        <div class="card">
          <div class="card-icon">&#9881;</div>
          <h3 data-i18n="ark.ceremony_title">Ceremony</h3>
          <p data-i18n="ark.ceremony_desc">Sovereign appliance for CA key ceremonies. Air-gapped Linux laptop, Shamir share distribution via local mesh.</p>
          <ul>
            <li data-i18n="ark.ceremony_l1">Clean Linux laptop (live USB)</li>
            <li data-i18n="ark.ceremony_l2">Key is split, original is destroyed</li>
            <li data-i18n="ark.ceremony_l3">vLEI verification of shareholders (planned)</li>
            <li data-i18n="ark.ceremony_l4">PKCS#11 support per jurisdiction (planned)</li>
          </ul>
        </div>
        <div class="card">
          <div class="card-icon">&#9741;</div>
          <h3 data-i18n="ark.trust_title">Trust</h3>
          <p data-i18n="ark.trust_desc">CA trust framework with Shamir shareholders, public on-chain transparency, and governance distributed across institutions.</p>
          <ul>
            <li data-i18n="ark.trust_l1">CA key split: 2-of-3 today, extensible to 3-of-5 with institutional partners</li>
            <li data-i18n="ark.trust_l2">Trust root at vault.attestto.sol</li>
            <li data-i18n="ark.trust_l3">Auditable blockchain transparency</li>
            <li data-i18n="ark.trust_l4">No actor has unilateral control</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- How it works (dark) -->
  <section id="how" class="section-dark">
    <div class="container">
      <div class="section-label" data-i18n="ark.how_label">How it works</div>
      <h2 class="section-title" data-i18n="ark.how_title">Desktop to mobile verification</h2>
      <p class="section-desc" data-i18n="ark.how_desc">Desktop and phone work together over local WiFi. Images and biometric data never leave your network — the connection is direct, no servers or cloud.</p>
      <div class="grid-3">
        <div class="card">
          <div class="card-icon">1</div>
          <h3 data-i18n="ark.step1_title">Open Station on your desktop</h3>
          <p data-i18n="ark.step1_desc">Select the document type to verify. Station generates a unique session QR code.</p>
        </div>
        <div class="card">
          <div class="card-icon">2</div>
          <h3 data-i18n="ark.step2_title">Scan the QR with your phone</h3>
          <p data-i18n="ark.step2_desc">The QR opens the mobile app with the WebSocket connection preconfigured. Your phone connects directly to your desktop.</p>
        </div>
        <div class="card">
          <div class="card-icon">3</div>
          <h3 data-i18n="ark.step3_title">Capture document and selfie</h3>
          <p data-i18n="ark.step3_desc">Front, back of document, and selfie with liveness proof (blink detection). Everything transmits in real-time to the desktop.</p>
        </div>
        <div class="card">
          <div class="card-icon">4</div>
          <h3 data-i18n="ark.step4_title">Automatic processing</h3>
          <p data-i18n="ark.step4_desc">Station runs OCR, extracts MRZ data, validates the document, and generates the verifiable credential.</p>
        </div>
        <div class="card">
          <div class="card-icon">5</div>
          <h3 data-i18n="ark.step5_title">Credential in your vault</h3>
          <p data-i18n="ark.step5_desc">The credential is stored encrypted in the local vault. Sign it with Digital Signature, anchor it on a public ledger, or share it via verifiable presentation.</p>
        </div>
      </div>

      <div class="arch-subsection">
        <div>
          <h3 class="arch-subsection-title" data-i18n="ark.arch_title">Local network architecture</h3>
          <p class="arch-subsection-desc" data-i18n="ark.arch_desc">The connection between desktop and mobile is direct over local WiFi. No intermediary servers, no cloud, no internet dependency.</p>
          <p class="arch-note" data-i18n="ark.arch_note">Privacy is not a policy — it is a mathematical guarantee.</p>
        </div>
        <div class="arch-layers">
          <div class="arch-layer">
            <span class="arch-layer-num">&#9633;</span>
            <span class="arch-layer-name">Station</span>
            <span class="arch-layer-desc">WebSocket + OCR + Census + Vault</span>
          </div>
          <div class="arch-layer">
            <span class="arch-layer-num">&#8597;</span>
            <span class="arch-layer-name">Local WiFi</span>
            <span class="arch-layer-desc">No internet, direct connection</span>
          </div>
          <div class="arch-layer">
            <span class="arch-layer-num">&#9671;</span>
            <span class="arch-layer-name">Web Extension</span>
            <span class="arch-layer-desc">Camera + Liveness + VCs</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CA Governance (light) -->
  <section id="governance" class="section-light">
    <div class="container">
      <div class="section-label" data-i18n="ark.gov_label">CA Governance</div>
      <h2 class="section-title" data-i18n="ark.gov_title">Distributed trust by design</h2>
      <p class="section-desc" data-i18n="ark.gov_desc">The Certificate Authority private key is split using Shamir's Secret Sharing. No individual actor — including Attestto — can sign unilaterally.</p>
      <div class="grid-3">
        <div class="card">
          <div class="card-icon">&#8902;</div>
          <h3 data-i18n="ark.sss_title">Shamir's Secret Sharing</h3>
          <p data-i18n="ark.sss_desc">The CA Ed25519 key is generated in an air-gapped ceremony and split into N shares. A threshold K is required to reconstruct it. The original key is destroyed.</p>
          <div class="detail-box">
            <div><span class="hl">Phase 1A (current):</span> 2-of-3 founder-only</div>
            <div><span class="hl">Phase 1B:</span> reshare to 3-of-5 as institutional partners join</div>
            <div><span class="hl">Phase 2+:</span> threshold grows with the shareholder set</div>
          </div>
        </div>
        <div class="card">
          <div class="card-icon">&#9878;</div>
          <h3 data-i18n="ark.shareholders_title">Institutional shareholders</h3>
          <p data-i18n="ark.shareholders_desc">Phase 1A is founder-only with all shares held by Attestto. Institutional shareholder positions are reserved for Phase 1B once formal partners join. Each share alone is useless — only when the threshold gathers can the key be temporarily reconstructed.</p>
          <div class="detail-box">
            <div><span class="hl">Attestto</span> — Technical operator (Phase 1A — current)</div>
            <div><span class="hl">Reserved</span> — Institutional partner positions (Phase 1B)</div>
            <div><span class="hl">Reserved</span> — Independent auditor position (Phase 1B)</div>
          </div>
        </div>
        <div class="card">
          <div class="card-icon">&#9830;</div>
          <h3 data-i18n="ark.onchain_title">Public attestation log</h3>
          <p data-i18n="ark.onchain_desc">Ark is chain-agnostic by design. The W3C VC, W3C DID, GLEIF vLEI, and eIDAS standards do not depend on any single ledger. CA events are recorded as public on-chain attestations — providing sovereign naming, sub-second public commitment, and a per-event cost compatible with institutional rollout. Each jurisdiction can choose its anchoring layer as institutional partners require; credentials issued under one anchor remain verifiable under another.</p>
          <div class="detail-box">
            <div><span class="hl">Root:</span> vault.attestto.sol</div>
            <div><span class="hl">Record:</span> Each CA event → on-chain attestation (planned)</div>
            <div><span class="hl">Verification:</span> Public and open</div>
          </div>
        </div>
      </div>

      <div class="vlei-callout">
        <div class="vlei-callout-header">
          <div class="vlei-callout-badge">GLEIF + ISO 17442</div>
          <h3 data-i18n="ark.vlei_title">vLEI Verification</h3>
        </div>
        <p data-i18n-html="ark.vlei_desc">Every shareholder must hold a verified LEI (Legal Entity Identifier) and a vLEI issued by <a href="https://www.gleif.org/en/vlei/introducing-the-vlei" target="_blank" rel="noopener">GLEIF</a> before joining a ceremony — proving they legitimately represent their institution. On-chain verification path is planned.</p>
        <div class="vlei-callout-details">
          <div class="vlei-detail"><span class="vlei-detail-label">Pre-requisite</span><span>Active LEI + issued vLEI</span></div>
          <div class="vlei-detail"><span class="vlei-detail-label">Verification</span><span>On-chain attestation (planned)</span></div>
          <div class="vlei-detail"><span class="vlei-detail-label">Standard</span><span>GLEIF + ISO 17442</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Ceremony (dark) -->
  <section id="ceremony" class="section-dark">
    <div class="container">
      <div class="section-label" data-i18n="ark.cer_label">Key Ceremony</div>
      <h2 class="section-title" data-i18n="ark.cer_title">Sovereign, air-gapped, verifiable</h2>
      <p class="section-desc" data-i18n="ark.cer_desc">The CA key generation ceremony occurs in a completely isolated environment. No internet connection. The only network is an encrypted local mesh between shareholder devices.</p>
      <div class="grid-3">
        <div class="card">
          <div class="card-icon">&#9875;</div>
          <h3 data-i18n="ark.appliance_title">The sovereign appliance</h3>
          <p data-i18n="ark.appliance_desc">A clean Linux laptop boots from live USB. No hard drive, no history, no external network. The ceremony software creates a private WiFi mesh to distribute Shamir shares to shareholder devices.</p>
          <ul>
            <li>Linux live USB — no hard drive</li>
            <li>Local WiFi mesh — no internet</li>
            <li>Generate Ed25519 key pair</li>
            <li>Split into Shamir shares</li>
            <li>Destroy original key</li>
            <li>Auditable, filmed ceremony</li>
          </ul>
        </div>
        <div class="card">
          <div class="card-icon">&#8634;</div>
          <h3 data-i18n="ark.types_title">Ceremony types</h3>
          <p data-i18n="ark.types_desc">The system supports different ceremonies according to the CA lifecycle.</p>
          <div class="detail-box">
            <div><span class="hl">Genesis:</span> First CA key generation</div>
            <div><span class="hl">Rotation:</span> Re-split with new shareholders</div>
            <div><span class="hl">Signing:</span> Reconstruct to sign certificates</div>
            <div><span class="hl">Revocation:</span> Revoke compromised key</div>
          </div>
        </div>
        <div class="card">
          <div class="card-icon">&#9789;</div>
          <h3 data-i18n="ark.multi_title">Multi-jurisdiction</h3>
          <p data-i18n="ark.multi_desc">Each country has its own electronic signature scheme. The appliance supports PKCS#11 to integrate with local signing hardware.</p>
          <div class="detail-box">
            <div><span class="hl">Costa Rica:</span> National digital signature framework (planned)</div>
            <div><span class="hl">Brazil:</span> National PKI infrastructure (planned)</div>
            <div><span class="hl">Mexico:</span> Federal electronic signature (planned)</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TLS (light) -->
  <section id="tls" class="section-light">
    <div class="container">
      <div class="section-label" data-i18n="ark.tls_label">Decentralized TLS</div>
      <h2 class="section-title" data-i18n="ark.tls_title">Four paths to the sovereign web</h2>
      <p class="section-desc" data-i18n="ark.tls_desc">The ultimate goal: TLS certificates issued by Attestto CA recognized natively by browsers. Four parallel paths, each with a different time horizon.</p>
      <div class="timeline-item">
        <div class="timeline-when" data-i18n="ark.tls1_when">Now</div>
        <div class="timeline-content">
          <h3 data-i18n="ark.tls1_title">Browser extension</h3>
          <p data-i18n="ark.tls1_desc">The Attestto ID extension validates certificates client-side against vault.attestto.sol and surfaces a sovereignty trust score in the browser. Day-1 deployment, no DNS infrastructure changes.</p>
        </div>
      </div>
      <div class="timeline-item">
        <div class="timeline-when" data-i18n="ark.tls2_when">6 months</div>
        <div class="timeline-content">
          <h3 data-i18n="ark.tls2_title">DANE / TLSA</h3>
          <p data-i18n="ark.tls2_desc">Publish TLSA records in DNS pointing to Attestto CA certificates. Requires the domain to use DNSSEC. DANE validators already exist in some browsers.</p>
        </div>
      </div>
      <div class="timeline-item">
        <div class="timeline-when" data-i18n="ark.tls3_when">12 months</div>
        <div class="timeline-content">
          <h3 data-i18n="ark.tls3_title">Verification proxy</h3>
          <p data-i18n="ark.tls3_desc">A bridging service that lets sites cross-publish their Attestto-issued certificate alongside a globally-trusted certificate, so browsers without DANE or the extension still see a valid chain while the sovereign certificate is recognized by participating clients.</p>
        </div>
      </div>
      <div class="timeline-item">
        <div class="timeline-when" data-i18n="ark.tls4_when">2-5 years</div>
        <div class="timeline-content">
