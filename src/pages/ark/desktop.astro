---
import Base from '../../layouts/Base.astro'

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "Attestto Station",
    "url": "https://attestto.org/ark/desktop",
    "applicationCategory": "SecurityApplication",
    "operatingSystem": "macOS, Windows, Linux",
    "description": "Modular Electron desktop for sovereign identity. Vault, signer, verifier, mesh node, and proctor — every function on your own machine."
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is Attestto Station?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Attestto Station is a modular Electron desktop application that bundles your identity vault, document signer, verifier, mesh node, and proctoring engine into a single auditable shell. Every sensitive operation runs on your own hardware, on code anyone can read."
        }
      },
      {
        "@type": "Question",
        "name": "What are the five Station modules?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The five modules are: Vault (encrypted identity storage with xsalsa20-poly1305), Signer (PDF and credential signing), Verifier (cryptographic signature and chain validation), Mesh (P2P network node for offline credential verification), and Proctor (exam proctoring with liveness detection)."
        }
      },
      {
        "@type": "Question",
        "name": "Why does Attestto use Electron instead of a web app?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sovereign identity requires that private keys never leave the device. A web app can't guarantee this — the browser sandbox limits access to hardware security modules and local storage isn't encrypted. Electron gives access to the OS keychain, hardware tokens, and local-first encrypted storage."
        }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Attestto", "item": "https://attestto.org" },
      { "@type": "ListItem", "position": 2, "name": "Architecture", "item": "https://attestto.org/ark" },
      { "@type": "ListItem", "position": 3, "name": "Desktop", "item": "https://attestto.org/ark/desktop" }
    ]
  }
]
---

<Base
  structuredData={structuredData}
  title="Attestto Ark · Station — Modular Desktop for Sovereign Identity"
  description="The Attestto Ark Station is a modular Electron desktop. Vault, signer, verifier, mesh node, and proctor — every function is an auditable module on your own machine, never a stranger in a cloud."
  canonicalPath="/ark/desktop"
  ogTitle="Attestto Ark · Station — Modular Desktop for Sovereign Identity"
  ogDescription="Vault, signer, verifier, mesh node, and proctor — every function is an auditable module on your own machine."
  ogImage="https://attestto.org/assets/og-image-station.png"
  navVariant="default"
  footerVariant="default"
  footerTagline="Open source tools for identity verification and signing. Institutional services fund the infrastructure."
>

  <!-- Hero (dark) -->
  <section class="hero hero-single">
    <div class="container">
      <div class="hero-text">
        <p class="eyebrow" data-i18n="desktop.eyebrow">Ark · Station</p>
        <h1 data-i18n="desktop.hero_title">One desktop. Five modules. Zero strangers.</h1>
        <p class="lead" data-i18n="desktop.hero_lead">The Station is an Electron desktop application that bundles your identity vault, document signer, verifier, mesh node, and proctoring engine into a single auditable shell. Every sensitive operation — from biometric liveness to PDF signing — runs on your own hardware, on code anyone can read.</p>
        <div class="hero-actions">
          <a href="#modules" class="btn btn-primary" data-i18n="desktop.hero_cta_primary">Explore the modules</a>
        </div>
      </div>
    </div>
  </section>

  <!-- What runs where -->
  <section id="modules" class="section-light">
    <div class="container">
      <div class="section-label" data-i18n="desktop.modules_label">Modules</div>
      <h2 class="section-title" data-i18n="desktop.modules_title">Five capabilities, one shell</h2>
      <p class="section-desc" data-i18n="desktop.modules_desc">The Station is a composition of independent modules that share a single encrypted vault. Each module is opt-in. You can run the Station purely as a vault, purely as a verifier, or activate every module for a full sovereign-identity workstation.</p>
      <div class="grid-3" style="grid-template-columns: repeat(3, 1fr);">

        <h3 style="grid-column: 1 / -1; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-accent); margin: 0;">Core</h3>

        <div class="card">
          <div class="card-icon">&#128274;</div>
          <h3 data-i18n="desktop.vault_title">Vault</h3>
          <p data-i18n="desktop.vault_desc">Encrypted local key store. Ed25519 signing key + xsalsa20-poly1305 + scrypt key derivation. The private key never leaves the device — not even to the Attestto company.</p>
          <ul>
            <li data-i18n="desktop.vault_l1">xsalsa20-poly1305 + scrypt</li>
            <li data-i18n="desktop.vault_l2">Shamir 2-of-3 backup (planned)</li>
            <li data-i18n="desktop.vault_l3">Zero-knowledge to Attestto</li>
            <li data-i18n="desktop.vault_l4">Open source — auditable</li>
          </ul>
        </div>

        <div class="card">
          <div class="card-icon">&#9999;</div>
          <h3 data-i18n="desktop.signer_title">Signer</h3>
          <p data-i18n="desktop.signer_desc">Sign PDFs with your vault key. Produces W3C Verifiable Credentials embedded directly into the document metadata. Recognized natively by verify.attestto.com — no plugin, no Adobe, no cloud.</p>
          <ul>
            <li data-i18n="desktop.signer_l1">Attestto self-attested signatures (Ed25519)</li>
            <li data-i18n="desktop.signer_l2">Counter-signs Firma Digital PAdES files</li>
            <li data-i18n="desktop.signer_l3">Smart-card PKCS#11 (planned)</li>
            <li data-i18n="desktop.signer_l4">Byte-frozen output for forensic integrity</li>
          </ul>
        </div>

        <div class="card">
          <div class="card-icon">&#10003;</div>
          <h3 data-i18n="desktop.verifier_title">Verifier</h3>
          <p data-i18n="desktop.verifier_desc">Drop a PDF onto the Station, get a forensic report: signature integrity, certificate chain, document hash, tamper detection. Same engine that runs at verify.attestto.com — but offline.</p>
          <ul>
            <li data-i18n="desktop.verifier_l1">PAdES + Attestto self-attested</li>
            <li data-i18n="desktop.verifier_l2">National PKI roots (per jurisdiction)</li>
            <li data-i18n="desktop.verifier_l3">Tamper-evident byte-range checks</li>
            <li data-i18n="desktop.verifier_l4">Works without internet</li>
          </ul>
        </div>

        <h3 style="grid-column: 1 / -1; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-accent); margin: var(--space-sm) 0 0;">Network</h3>

        <div class="card">
          <div class="card-icon">&#9881;</div>
          <h3 data-i18n="desktop.mesh_title">Mesh Node</h3>
          <p data-i18n="desktop.mesh_desc">Every Station can become a peer in the Attestto Mesh — an encrypted libp2p network for credential anchoring, trust mirroring, and redundant verification. Blind-courier: nodes can't read what they carry.</p>
          <ul>
            <li data-i18n="desktop.mesh_l1">libp2p over Bluetooth, WiFi, internet</li>
            <li data-i18n="desktop.mesh_l2">Blind courier — encrypted payloads</li>
            <li data-i18n="desktop.mesh_l3">Public ledger anchoring (deployment-time)</li>
            <li data-i18n="desktop.mesh_l4">Opt-in, never required</li>
          </ul>
        </div>

        <div class="card">
          <div class="card-icon">&#128065;</div>
          <h3 data-i18n="desktop.proctor_title">Proctor</h3>
          <p data-i18n="desktop.proctor_desc">White-box exam proctoring that runs entirely on the candidate's machine. Camera, screen, and process monitoring with zero cloud video upload. The "proctor" is auditable code, not a stranger watching a feed.</p>
          <ul>
            <li data-i18n="desktop.proctor_l1">Local face + liveness detection</li>
            <li data-i18n="desktop.proctor_l2">desktopCapturer screen monitoring</li>
            <li data-i18n="desktop.proctor_l3">Process-level lockdown via Node</li>
            <li data-i18n="desktop.proctor_l4">SHA-256 session hash + Ed25519 signing</li>
          </ul>
        </div>

        <div class="card">
          <div class="card-icon">&#127760;</div>
          <h3 data-i18n="desktop.bridge_title">Bridge to Browser</h3>
          <p data-i18n="desktop.bridge_desc">
            The Station pairs with the Attestto ID extension via the open <code>@attestto/id-wallet-adapter</code>
            protocol. Web pages discover the wallet, request signatures, and receive credentials — without the
            Station ever exposing your private key to the page.
          </p>
          <ul>
            <li data-i18n="desktop.bridge_l1">postMessage protocol, no servers</li>
            <li data-i18n="desktop.bridge_l2">DID login, document signing, credential push</li>
            <li data-i18n="desktop.bridge_l3">Works with any compliant wallet</li>
            <li data-i18n="desktop.bridge_l4">Cross-platform (desktop, browser, mobile PWA)</li>
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- Why Electron -->
  <section class="section-dark">
    <div class="container">
      <div class="section-label" data-i18n="desktop.electron_label">Why Electron</div>
      <h2 class="section-title" data-i18n="desktop.electron_title">A browser engine with hardware access</h2>
      <p class="section-desc" data-i18n="desktop.electron_desc">
        Sovereign identity needs deep access to the device — camera, screen, processes, file system, smart cards —
        which a sandboxed web page cannot provide. Electron gives the Station the Chromium rendering engine for a
        modern UI <em>and</em> Node.js for direct hardware access. The result is a modular desktop that ships as a
        single installer and runs everywhere your team already works.
      </p>

      <div class="grid-3">
        <div class="card">
          <h3 data-i18n="desktop.electron_card1_title">Chromium engine</h3>
          <p data-i18n="desktop.electron_card1_desc">The same rendering pipeline that powers verify.attestto.com runs the Station's UI. PDF preview, OCR, biometric overlays, signature stamps — all rendered with web technology you can inspect.</p>
        </div>
        <div class="card">
          <h3 data-i18n="desktop.electron_card2_title">Node.js system access</h3>
          <p data-i18n="desktop.electron_card2_desc">Direct file system, process inspection, smart card interfaces, mesh networking, and OS-level keychain integration — capabilities a normal browser refuses to grant.</p>
        </div>
        <div class="card">
          <h3 data-i18n="desktop.electron_card3_title">Auditable distribution</h3>
          <p data-i18n="desktop.electron_card3_desc">The Station ships as a notarized DMG, MSI, and AppImage. Source code is open. Reproducible builds are on the roadmap so anyone can verify the binary matches the published commit.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust ladder -->
  <section class="section-light">
    <div class="container">
      <div class="section-label" data-i18n="desktop.trust_label">Trust ladder</div>
      <h2 class="section-title" data-i18n="desktop.trust_title">Five honest tiers</h2>
      <p class="section-desc" data-i18n="desktop.trust_desc">
        A signature is only as trustworthy as the identity verification behind it. The Station surfaces an explicit
        trust tier on every credential it issues, so verifiers and counterparties know exactly what evidence the
        signer presented.
      </p>

      <div class="trust-ladder">
        <div class="trust-tier">
          <span class="trust-tier-badge">A+</span>
          <div class="trust-tier-content">
            <h3>Smart card</h3>
            <p data-i18n="desktop.trust_aplus_desc">Costa Rica Firma Digital smart card (PKCS#11). Qualified electronic signature recognized under Ley 8454.</p>
          </div>
        </div>
        <div class="trust-tier">
          <span class="trust-tier-badge">A</span>
          <div class="trust-tier-content">
            <h3>Full KYC</h3>
            <p data-i18n="desktop.trust_a_desc">Cedula scan + Padron Electoral + facial recognition + liveness proof + Firma Digital seal.</p>
          </div>
        </div>
        <div class="trust-tier">
          <span class="trust-tier-badge">B</span>
          <div class="trust-tier-content">
            <h3>Padron verified</h3>
            <p data-i18n="desktop.trust_b_desc">Cedula scan + Padron Electoral cross-check + facial recognition + liveness proof. The default for citizen-issued credentials.</p>
          </div>
        </div>
        <div class="trust-tier">
          <span class="trust-tier-badge">C</span>
          <div class="trust-tier-content">
            <h3>Document only</h3>
            <p data-i18n="desktop.trust_c_desc">Cedula scanned and OCR'd, no Padron cross-check, no biometrics. Useful for non-binding workflows.</p>
          </div>
        </div>
        <div class="trust-tier">
          <span class="trust-tier-badge">D</span>
          <div class="trust-tier-content">
            <h3>Self-declared</h3>
            <p data-i18n="desktop.trust_d_desc">Holder-asserted data with no external verification. Always labeled, never silently upgraded.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- For auditors -->
  <section id="auditors" class="section-dark">
    <div class="container">
      <div class="section-label" data-i18n="desktop.auditors_label">For auditors</div>
      <h2 class="section-title" data-i18n="desktop.auditors_title">Read the code. Run the binary. File issues.</h2>
      <p class="section-desc" data-i18n="desktop.auditors_desc">
        Every claim on this page is backed by a public repository. If anything looks wrong, the right move is to
        open the source — not to take our word for it.
      </p>

      <div class="grid-3">
        <h3 style="grid-column: 1 / -1; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-accent); margin: 0;">Core Applications</h3>

        <div class="card">
          <h3>attestto-desktop</h3>
          <p>The Station itself. Vault, signer, verifier, proctor, mesh node — all in one Electron app.</p>
          <p><a href="https://github.com/Attestto-com/attestto-desktop" style="color: var(--color-accent, #22d3a8); font-weight: 600;">github.com/Attestto-com/attestto-desktop →</a></p>
        </div>
        <div class="card">
          <h3>attestto-verify</h3>
          <p>The browser-side verification engine. Same code runs at verify.attestto.com and inside the Station.</p>
          <p><a href="https://github.com/Attestto-com/attestto-verify" style="color: var(--color-accent, #22d3a8); font-weight: 600;">github.com/Attestto-com/attestto-verify →</a></p>
        </div>
        <h3 style="grid-column: 1 / -1; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-accent); margin: var(--space-sm) 0 0;">Infrastructure</h3>

        <div class="card">
          <h3>id-wallet-adapter</h3>
          <p>The open wallet handoff protocol that bridges browser pages, the extension, and the Station.</p>
          <p><a href="https://github.com/Attestto-com/id-wallet-adapter" style="color: var(--color-accent, #22d3a8); font-weight: 600;">github.com/Attestto-com/id-wallet-adapter →</a></p>
        </div>
        <div class="card">
          <h3>attestto-mesh</h3>
          <p>The libp2p mesh node. Blind-courier transport, Public ledger anchoring, peer discovery.</p>
          <p><a href="https://github.com/Attestto-com/attestto-mesh" style="color: var(--color-accent, #22d3a8); font-weight: 600;">github.com/Attestto-com/attestto-mesh →</a></p>
        </div>
        <h3 style="grid-column: 1 / -1; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-accent); margin: var(--space-sm) 0 0;">Security</h3>

        <div class="card">
          <h3>attestto-trust</h3>
          <p>Independent public mirror of national CA roots — a reference, never a replacement for the issuing authority.</p>
          <p><a href="https://github.com/Attestto-com/attestto-trust" style="color: var(--color-accent, #22d3a8); font-weight: 600;">github.com/Attestto-com/attestto-trust →</a></p>
        </div>
        <div class="card">
          <h3>SECURITY.md</h3>
          <p>Coordinated disclosure for any vulnerability you find. We acknowledge every report, in writing, with a tracking ID.</p>
          <p><a href="mailto:security@attestto.com" style="color: var(--color-accent, #22d3a8); font-weight: 600;">security@attestto.com →</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section id="contact" class="section-light cta-center">
    <div class="container">
      <div class="section-label" data-i18n="desktop.cta_label">Get the Station</div>
      <h2 class="section-title" data-i18n="desktop.cta_title">Run sovereign identity on your own desktop</h2>
      <p class="section-desc" data-i18n="desktop.cta_desc">
        The Station is in early access for professionals, institutions, and auditors. Tell us who you are and what
        you would use it for, and we will get you a build that fits your jurisdiction.
      </p>
      <a href="mailto:open@attestto.com?subject=Ark%20Station%20%E2%80%94%20early%20access" class="btn btn-primary" data-i18n="desktop.cta_btn">Request early access</a>
      <div class="cta-links">
        <a href="/ark">Back to Ark overview</a>
        <a href="https://github.com/Attestto-com/attestto-desktop">Source code</a>
      </div>
    </div>
  </section>

  <style>
    .trust-ladder {
      display: flex;
      flex-direction: column;
      gap: var(--space-sm);
      max-width: 48rem;
    }

    .trust-tier {
      display: flex;
      align-items: flex-start;
      gap: var(--space-md);
      padding: var(--space-md);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 12px;
    }

    .trust-tier-badge {
      font-size: 1.5rem;
      font-weight: 800;
      color: var(--color-accent);
      min-width: 3rem;
      text-align: center;
      flex-shrink: 0;
    }

    .trust-tier-content h3 {
      font-size: 1rem;
      font-weight: 700;
      margin-bottom: 0.25rem;
    }

    .trust-tier-content p {
      font-size: 0.875rem;
      color: var(--color-ink-muted);
      margin: 0;
    }
  </style>

</Base>
