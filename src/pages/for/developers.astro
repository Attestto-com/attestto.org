---
import Base from '../../layouts/Base.astro'

const moduleInterfaceHtml = `<pre><span class="kw">interface</span> <span class="ty">AttesttoModule</span> {
  manifest: <span class="ty">ModuleManifest</span>
  install: (ctx: <span class="ty">ModuleContext</span>) =&gt; <span class="ty">Promise</span>&lt;<span class="ty">void</span>&gt; | <span class="ty">void</span>
  uninstall?: () =&gt; <span class="ty">void</span>
  getInboxItems?: () =&gt; <span class="ty">Promise</span>&lt;<span class="ty">InboxItem</span>[]&gt;
  getHomeWidget?: () =&gt; <span class="ty">Component</span> | <span class="ty">null</span>
  getOnboarding?: () =&gt; <span class="ty">OnboardingFlow</span> | <span class="ty">null</span>
}

<span class="kw">interface</span> <span class="ty">ModuleManifest</span> {
  id: <span class="ty">string</span>                      <span class="cm">// unique, e.g. "cr-driving"</span>
  name: <span class="ty">string</span>                    <span class="cm">// display name</span>
  country: <span class="ty">string</span>                 <span class="cm">// ISO 3166-1 alpha-2, or "universal"</span>
  version: <span class="ty">string</span>                 <span class="cm">// semver</span>
  description: <span class="ty">string</span>             <span class="cm">// short description</span>
  icon: <span class="ty">string</span>                    <span class="cm">// Material Icons name</span>
  requiredCredentials: <span class="ty">string</span>[]   <span class="cm">// VCs that must be in vault</span>
  capabilities: <span class="ty">string</span>[]          <span class="cm">// e.g. ['exam-practice', 'issue:MyVC']</span>
  routes: <span class="ty">ModuleRoute</span>[]           <span class="cm">// routes this module contributes</span>
}

<span class="kw">interface</span> <span class="ty">ModuleContext</span> {
  getCredentials: (types: <span class="ty">string</span>[]) =&gt; <span class="ty">Promise</span>&lt;<span class="ty">VerifiableCredential</span>[]&gt;
  storeCredential: (vc: <span class="ty">VerifiableCredential</span>) =&gt; <span class="ty">Promise</span>&lt;<span class="ty">void</span>&gt;
  pushInboxItem: (item: <span class="ty">InboxItem</span>) =&gt; <span class="ty">void</span>
  requestBiometric: (reason: <span class="ty">string</span>) =&gt; <span class="ty">Promise</span>&lt;<span class="ty">boolean</span>&gt;
  navigate: (path: <span class="ty">string</span>) =&gt; <span class="ty">void</span>
  storage: <span class="ty">ModuleStorage</span>          <span class="cm">// key-value, namespaced to module ID</span>
  llm: <span class="ty">LlmHandle</span>                 <span class="cm">// on-device Gemma 2B via WebGPU</span>
}</pre>`
---

<Base
  title="Build on Attestto — Developer Portal"
  description="Build sovereign identity modules on Attestto. Module SDK, credential schemas, fee splits, and 12+ unsolved problems waiting for builders."
  canonicalPath="/for/developers"
  navVariant="default"
  footerVariant="default"
>

  <!-- HERO -->
  <section class="hero hero-single">
    <div class="container">
      <div class="hero-text">
        <h1 data-i18n="dev.hero_title">The credential infrastructure layer.<br><em>Fork it, extend it, ship it.</em></h1>
        <p class="lead" data-i18n="dev.hero_lead">Attestto is sovereign identity infrastructure. You build modules on top. Citizens use your module. You earn a revenue share on every transaction. The platform handles identity, verification, and distribution.</p>
        <div class="hero-actions">
          <a href="#sdk" class="btn btn-primary" data-i18n="dev.hero_cta1">Read the SDK</a>
          <a href="#build-this" class="btn btn-secondary" data-i18n="dev.hero_cta2">See what to build</a>
        </div>
      </div>
    </div>
  </section>

  <!-- START HERE -->
  <section id="start" class="section-dark">
    <div class="container">
      <div class="section-label" data-i18n="dev.start_label">START HERE</div>
      <h2 class="section-title" data-i18n="dev.start_title">What are you building?</h2>
      <p class="section-desc" data-i18n="dev.start_desc">Pick your path based on what you need. Each leads to a different part of the stack.</p>

      <div class="decision-tree">
        <div class="decision-branch">
          <span class="branch-arrow">&rarr;</span>
          <div>
            <h4 data-i18n="dev.path1_title">I want to build a module for the Attestto App</h4>
            <p data-i18n="dev.path1_desc">Start with <code>@attestto/module-sdk</code>. Your module runs inside the PWA. You get identity, vault, LLM, and distribution for free.</p>
          </div>
        </div>
        <div class="decision-branch">
          <span class="branch-arrow">&rarr;</span>
          <div>
            <h4 data-i18n="dev.path2_title">I need to verify Costa Rica documents</h4>
            <p data-i18n="dev.path2_desc">Use <code>@attestto/verify</code> web component. Drop it in your page. Drag-and-drop PDF verification against national PKI roots. Zero config.</p>
          </div>
        </div>
        <div class="decision-branch">
          <span class="branch-arrow">&rarr;</span>
          <div>
            <h4 data-i18n="dev.path3_title">I need to issue verifiable credentials</h4>
            <p data-i18n="dev.path3_desc">Use <code>cr-vc-sdk</code> + <code>cr-vc-schemas</code>. Define your credential type, sign with your DID, deliver to wallets.</p>
          </div>
        </div>
        <div class="decision-branch">
          <span class="branch-arrow">&rarr;</span>
          <div>
            <h4 data-i18n="dev.path4_title">I'm building on Solana + identity</h4>
            <p data-i18n="dev.path4_desc">Read the <code>did:sns</code> spec. Resolve decentralized identifiers via Solana Name Service. W3C standards-track.</p>
          </div>
        </div>
        <div class="decision-branch">
          <span class="branch-arrow">&rarr;</span>
          <div>
            <h4 data-i18n="dev.path5_title">I want to run a mesh node</h4>
            <p data-i18n="dev.path5_desc">Download Station (desktop app) or run <code>attestto-mesh</code> directly. Relay verification proofs for the network and earn micropayments.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ARCHITECTURE -->
  <section id="architecture" class="section-light">
    <div class="container">
      <div class="section-label" data-i18n="dev.arch_label">ARCHITECTURE</div>
      <h2 class="section-title" data-i18n="dev.arch_title">Three layers. Your module lives in the middle.</h2>
      <p class="section-desc" data-i18n="dev.arch_desc">The platform handles infrastructure (bottom) and user surfaces (top). You build modules that plug into both.</p>

      <div class="arch-diagram">
        <div class="arch-row">
          <span class="layer-label">Surface</span>
          <div class="layer-items">
            <span>Attestto App (PWA)</span>
            <span>Station (Desktop)</span>
            <span>Extension</span>
            <span>verify.attestto.com</span>
          </div>
        </div>
        <div class="arch-row">
          <span class="layer-label">Modules</span>
          <div class="layer-items">
            <span class="you">Your Module</span>
            <span>cr-driving</span>
            <span>cr-medical</span>
            <span>cr-vc-sdk</span>
            <span>cr-vc-schemas</span>
          </div>
        </div>
        <div class="arch-row">
          <span class="layer-label">Infra</span>
          <div class="layer-items">
            <span>DID / VCs</span>
            <span>Mesh (libp2p)</span>
            <span>Trust Store</span>
            <span>Ledger Anchoring</span>
            <span>On-device LLM</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- MODULE SDK -->
  <section id="sdk" class="section-dark">
    <div class="container">
      <div class="section-label" data-i18n="dev.sdk_label">MODULE SDK</div>
      <h2 class="section-title" data-i18n="dev.sdk_title">Ship a module in a week</h2>
      <p class="section-desc" data-i18n="dev.sdk_desc">The SDK gives you identity, vault access, on-device LLM, credential gating, and distribution. You focus on your domain logic.</p>

      <div class="step-grid">
        <div class="step-card">
          <div class="step-num">01</div>
          <h4 data-i18n="dev.step1_title">Clone the template</h4>
          <p data-i18n="dev.step1_desc">Start from <code>cr-driving</code> as your reference. It implements every SDK interface with real logic you can study.</p>
        </div>
        <div class="step-card">
          <div class="step-num">02</div>
          <h4 data-i18n="dev.step2_title">Define your manifest</h4>
          <p data-i18n="dev.step2_desc">Set your module ID, required credentials, capabilities, routes, and icon. The manifest tells the shell what your module needs and provides.</p>
        </div>
        <div class="step-card">
          <div class="step-num">03</div>
          <h4 data-i18n="dev.step3_title">Implement install()</h4>
          <p data-i18n="dev.step3_desc">The shell calls <code>install(ctx)</code> with a context object. You get credential access, storage, LLM, biometric auth, navigation, and inbox push.</p>
        </div>
        <div class="step-card">
          <div class="step-num">04</div>
          <h4 data-i18n="dev.step4_title">Build your views</h4>
          <p data-i18n="dev.step4_desc">Vue 3 components, lazy-loaded via your manifest routes. The shell handles auth, navigation chrome, and credential gating.</p>
        </div>
        <div class="step-card">
          <div class="step-num">05</div>
          <h4 data-i18n="dev.step5_title">Add onboarding + exams</h4>
          <p data-i18n="dev.step5_desc">Optional: return an <code>OnboardingFlow</code> with contextual LLM prompts. Add proctored exams with mastery tracking and VC issuance on completion.</p>
        </div>
        <div class="step-card">
          <div class="step-num">06</div>
          <h4 data-i18n="dev.step6_title">Submit to the registry</h4>
          <p data-i18n="dev.step6_desc">Open a PR to the module registry. Community testers validate. Once merged, your module is available to every Attestto user.</p>
        </div>
      </div>

      <h3 style="color:#fff;margin:3rem 0 1rem" data-i18n="dev.interface_title">The Module Interface</h3>

      <div class="code-block" set:html={moduleInterfaceHtml} />

      <h3 style="color:#fff;margin:3rem 0 1rem" data-i18n="dev.context_title">What the Platform Gives You</h3>

      <div class="grid-3">
        <div class="card">
          <h3 data-i18n="dev.ctx_identity">Identity</h3>
          <p data-i18n="dev.ctx_identity_desc">User's DID, credential vault, WebAuthn biometric auth. You never manage keys.</p>
        </div>
        <div class="card">
          <h3 data-i18n="dev.ctx_credentials">Credentials</h3>
          <p data-i18n="dev.ctx_creds_desc">Read from vault, write to vault, gate access by credential type. W3C Verifiable Credentials.</p>
        </div>
        <div class="card">
          <h3 data-i18n="dev.ctx_llm">On-device LLM</h3>
          <p data-i18n="dev.ctx_llm_desc">Gemma 2B runs locally via WebGPU. Contextual help, Q&A, document analysis. No data leaves the device.</p>
        </div>
        <div class="card">
          <h3 data-i18n="dev.ctx_storage">Storage</h3>
          <p data-i18n="dev.ctx_storage_desc">Namespaced key-value store. Your data is isolated from other modules. Persists across sessions.</p>
        </div>
        <div class="card">
          <h3 data-i18n="dev.ctx_inbox">Inbox</h3>
          <p data-i18n="dev.ctx_inbox_desc">Push notifications, action items, and warnings to the user's home screen. Priority-sorted.</p>
        </div>
        <div class="card">
          <h3 data-i18n="dev.ctx_distribution">Distribution</h3>
          <p data-i18n="dev.ctx_dist_desc">Your module is available to every Attestto user. PWA on mobile, Station on desktop. No app store needed.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- BUILD THIS -->
  <section id="build-this" class="section-light">
    <div class="container">
      <div class="section-label" data-i18n="dev.bounty_label">BUILD THIS</div>
      <h2 class="section-title" data-i18n="dev.bounty_title">Unsolved problems waiting for builders</h2>
      <p class="section-desc" data-i18n="dev.bounty_desc">Each card is a real problem affecting real people. Full specs are written. You build the module, you earn a revenue share on every transaction your module generates.</p>

      <div class="bounty-grid">

        <div class="bounty-card">
          <span class="bounty-tier tier-medium">Medium</span>
          <h4>HealthOS</h4>
          <p class="bounty-problem">Citizens entitled to universal healthcare can't navigate appointments, medication rights, or disability appeals. Health literacy tools with on-device LLM guidance.</p>
          <div class="bounty-meta">
            <span class="bounty-tag">VCs</span>
            <span class="bounty-tag">LLM</span>
            <span class="bounty-tag">CR</span>
          </div>
        </div>

        <div class="bounty-card">
          <span class="bounty-tier tier-medium">Medium</span>
          <h4>NotarialOS</h4>
          <p class="bounty-problem">Notaries must file digital indices by law, but current processes involve hundreds of manual field entries per cycle. Automate submission with credential-backed identity.</p>
          <div class="bounty-meta">
            <span class="bounty-tag">VCs</span>
            <span class="bounty-tag">Firma Digital</span>
            <span class="bounty-tag">CR</span>
          </div>
        </div>

        <div class="bounty-card">
          <span class="bounty-tier tier-easy">Easy</span>
          <h4>FinancialInclusion</h4>
          <p class="bounty-problem">Most people sign credit contracts without understanding the real cost of debt. Build financial literacy paths, calculators, and contract analysis tools.</p>
          <div class="bounty-meta">
            <span class="bounty-tag">LLM</span>
            <span class="bounty-tag">Mastery</span>
            <span class="bounty-tag">VCs</span>
          </div>
        </div>

        <div class="bounty-card">
          <span class="bounty-tier tier-medium">Medium</span>
          <h4>MigrationOS</h4>
          <p class="bounty-problem">Migrants spend thousands on lawyers for processes that are largely deterministic. Build status trackers, rights guides, and document navigators.</p>
          <div class="bounty-meta">
            <span class="bounty-tag">DIDs</span>
            <span class="bounty-tag">VCs</span>
            <span class="bounty-tag">LLM</span>
          </div>
        </div>

        <div class="bounty-card">
          <span class="bounty-tier tier-medium">Medium</span>
          <h4>CreditOS</h4>
          <p class="bounty-problem">People with consistent income are invisible to credit bureaus. Build privacy-preserving credit profiles from verifiable credential history.</p>
          <div class="bounty-meta">
            <span class="bounty-tag">VCs</span>
            <span class="bounty-tag">ZKP</span>
            <span class="bounty-tag">LATAM</span>
          </div>
        </div>

        <div class="bounty-card">
          <span class="bounty-tier tier-medium">Medium</span>
          <h4>LaborMarketOS</h4>
          <p class="bounty-problem">Labor markets fragmented across informal channels. Professional certifications exist on paper only. Build verified job matching with credential-backed track records.</p>
          <div class="bounty-meta">
            <span class="bounty-tag">VCs</span>
            <span class="bounty-tag">Mesh</span>
          </div>
        </div>

        <div class="bounty-card">
          <span class="bounty-tier tier-hard">Hard</span>
          <h4>CrossBorderOS</h4>
          <p class="bounty-problem">Remittance corridors charge high fees while credentials don't cross borders. Build portable identity for cross-border verification and low-cost settlement.</p>
          <div class="bounty-meta">
            <span class="bounty-tag">USDC</span>
            <span class="bounty-tag">Solana</span>
            <span class="bounty-tag">VCs</span>
          </div>
        </div>

        <div class="bounty-card">
          <span class="bounty-tier tier-hard">Hard</span>
          <h4>CreatorOS</h4>
          <p class="bounty-problem">Content creators keep a fraction of their earnings. No portable identity, no piracy protection, no credit access. Build sovereign creator identity.</p>
          <div class="bounty-meta">
            <span class="bounty-tag">DIDs</span>
            <span class="bounty-tag">C2PA</span>
            <span class="bounty-tag">ZKP</span>
          </div>
        </div>

        <div class="bounty-card">
          <span class="bounty-tier tier-hard">Hard</span>
          <h4>HumanitarianKit</h4>
          <p class="bounty-problem">Displaced persons arrive with zero documents. No institutional backing. Build crisis identity bootstrap using community attestation and mesh networking.</p>
          <div class="bounty-meta">
            <span class="bounty-tag">DIDs</span>
            <span class="bounty-tag">Offline</span>
            <span class="bounty-tag">Mesh</span>
          </div>
        </div>

        <div class="bounty-card">
          <span class="bounty-tier tier-medium">Medium</span>
          <h4>RealEstateOS</h4>
          <p class="bounty-problem">Property buyers lose patrimony through regulatory traps, hidden liens, and environmental restrictions. Build credential-backed due diligence tools.</p>
          <div class="bounty-meta">
            <span class="bounty-tag">VCs</span>
            <span class="bounty-tag">LLM</span>
          </div>
        </div>

        <div class="bounty-card">
          <span class="bounty-tier tier-hard">Hard</span>
          <h4>DataEconomyOS</h4>
          <p class="bounty-problem">User behavioral data has value but can't be monetized without violating privacy. Build privacy-preserving data aggregation where users control and benefit.</p>
          <div class="bounty-meta">
            <span class="bounty-tag">ZKP</span>
            <span class="bounty-tag">MPC</span>
            <span class="bounty-tag">Global</span>
          </div>
        </div>

        <div class="bounty-card">
          <span class="bounty-tier tier-easy">Easy</span>
          <h4>PartnerConnect</h4>
          <p class="bounty-problem">Identity-verified users are high-value leads for financial services. No consent-based referral channel exists. Build the bridge.</p>
          <div class="bounty-meta">
            <span class="bounty-tag">VCs</span>
            <span class="bounty-tag">KYC</span>
            <span class="bounty-tag">Global</span>
          </div>
        </div>

      </div>

      <p style="text-align:center;margin-top:2rem;color:var(--color-ink-muted)">
        <a href="https://github.com/Attestto-com/attestto-app/tree/main/modules" style="color:var(--color-accent);font-weight:600" data-i18n="dev.bounty_cta">Reference implementation and module template on GitHub &rarr;</a>
      </p>
    </div>
  </section>

  <!-- QUICK START -->
  <section id="quickstart" class="section-light">
    <div class="container">
      <div class="section-label" data-i18n="dev.qs_label">QUICK START</div>
      <h2 class="section-title" data-i18n="dev.qs_title">From zero to module in 5 minutes</h2>

      <div class="step-grid">
        <div class="step-card">
          <div class="step-num">$</div>
          <h4 data-i18n="dev.qs1">Clone the repo</h4>
          <p><code>git clone https://github.com/Attestto-com/attestto-app</code></p>
        </div>
        <div class="step-card">
          <div class="step-num">$</div>
          <h4 data-i18n="dev.qs2">Install dependencies</h4>
          <p><code>pnpm install</code></p>
        </div>
        <div class="step-card">
          <div class="step-num">$</div>
          <h4 data-i18n="dev.qs3">Copy the reference module</h4>
          <p><code>cp -r modules/cr-driving modules/my-module</code></p>
        </div>
        <div class="step-card">
          <div class="step-num">$</div>
          <h4 data-i18n="dev.qs4">Run the dev server</h4>
          <p><code>pnpm --filter @attestto/app dev</code></p>
        </div>
      </div>

      <div class="grid-3" style="margin-top:3rem">
        <div class="card">
          <h3>GitHub</h3>
          <p>Source code, issues, PRs</p>
          <a href="https://github.com/Attestto-com/attestto-app" class="dl-btn" style="margin-top:0.5rem">attestto-app &rarr;</a>
        </div>
        <div class="card">
          <h3>Module SDK</h3>
          <p>TypeScript package with all interfaces</p>
          <a href="https://github.com/Attestto-com/attestto-app/tree/main/modules/sdk" class="dl-btn" style="margin-top:0.5rem">@attestto/module-sdk &rarr;</a>
        </div>
        <div class="card">
          <h3>CR Schemas</h3>
          <p>JSON-LD credential schemas for Costa Rica</p>
          <a href="https://github.com/Attestto-com/cr-vc-schemas" class="dl-btn" style="margin-top:0.5rem">cr-vc-schemas &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ALL REPOS -->
  <section class="section-dark">
    <div class="container">
      <div class="section-label" data-i18n="dev.repos_label">BUILDING BLOCKS</div>
      <h2 class="section-title" data-i18n="dev.repos_title">The full stack</h2>

      <div class="grid-3">
        <div class="card">
          <div class="card-icon">&#9670;</div>
          <h3>attestto-app</h3>
          <p>Sovereign wallet PWA. Vue 3 + Quasar. Where modules run.</p>
          <span class="tag tag-mobile">PWA</span>
        </div>
        <div class="card">
          <div class="card-icon">&#9670;</div>
          <h3>attestto-desktop</h3>
          <p>Station. Electron desktop app. Vault, signer, verifier, mesh node.</p>
          <span class="tag tag-desktop">Desktop</span>
        </div>
        <div class="card">
          <div class="card-icon">&#9670;</div>
          <h3>attestto-verify</h3>
          <p>Web component. Drop-in PDF/cert verification against national PKI roots.</p>
          <span class="tag tag-web">Web</span>
        </div>
        <div class="card">
          <div class="card-icon">&#9670;</div>
          <h3>attestto-mesh</h3>
          <p>P2P network. libp2p, DHT, gossip, relay. Decentralized verification.</p>
          <span class="tag tag-sdk">Infra</span>
        </div>
        <div class="card">
          <div class="card-icon">&#9670;</div>
          <h3>attestto-trust</h3>
          <p>Multi-country PKI trust store. Independent public mirror of national CAs.</p>
          <span class="tag tag-sdk">Infra</span>
        </div>
        <div class="card">
          <div class="card-icon">&#9670;</div>
          <h3>cr-vc-sdk</h3>
          <p>Issue and verify Costa Rica credentials. TypeScript.</p>
          <span class="tag tag-sdk">SDK</span>
        </div>
        <div class="card">
          <div class="card-icon">&#9670;</div>
          <h3>cr-vc-schemas</h3>
          <p>JSON-LD schemas for CR credential types. The vocabulary.</p>
          <span class="tag tag-sdk">SDK</span>
        </div>
        <div class="card">
          <div class="card-icon">&#9670;</div>
          <h3>id-wallet-adapter</h3>
          <p>Wallet identity resolution. Connect DIDs to wallets.</p>
          <span class="tag tag-sdk">SDK</span>
        </div>
        <div class="card">
          <div class="card-icon">&#9670;</div>
          <h3>did-sns-spec</h3>
          <p>did:sns DID method. Resolve identifiers via Solana Name Service. W3C track.</p>
          <span class="tag tag-sdk">Spec</span>
        </div>
      </div>
    </div>
  </section>

</Base>
