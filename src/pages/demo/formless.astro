---
import Base from '../../layouts/Base.astro'
import FormlessDemo from '../../components/FormlessDemo.astro'

const title = 'The form-less trámite — Demo | Attestto Open'
const description =
  'A demo of the "form-less form" concept: the site requests credentials, not that you retype your data. You review and sign inside your wallet — even property trámites like a land-use resolution.'
---

<Base
  title={title}
  description={description}
  canonicalPath="/demo/formless"
  navVariant="default"
>
  <section class="section-light">
    <div class="container fl-intro">
      <p class="section-label">Concept demo</p>
      <h1 class="section-title">The form without a form</h1>
      <p class="section-desc">
        Costa Rican municipal systems make people <strong>retype</strong> the
        same data for every errand — often over insecure <code>http://</code>,
        often asking them to invent <strong>yet another password</strong>. And a
        property trámite isn't even about a person: it's about a
        <strong>finca</strong> (a parcel).
      </p>

      <figure class="fl-shot">
        <img src="/demo/nicoya-visado.png" alt="A Costa Rican municipal registration form over insecure http://" width="1472" height="956" loading="lazy" />
        <figcaption>A real Costa Rican municipal form, over insecure <code>http://</code> — passing your cédula, name, email and phone as <strong>plain text</strong> to the site.</figcaption>
      </figure>

      <p class="fl-note">
        With Attestto it flips: the site <strong>requests credentials</strong>,
        and everything sensitive (picking the property, reviewing what's shared,
        and signing) happens <strong>inside your wallet</strong>, never on the
        untrusted site. The presentation can even be <strong>signed by you and
        encrypted to the department's public key</strong>, so it can cross the
        insecure site while only the municipal system can read it: the site
        relays an opaque blob, not your plaintext data.
      </p>
      <p class="fl-note">
        Simulated and framework-free. The same logic is meant for
        <code>@attestto/id-wallet-adapter</code>, and a request can be
        <strong>imported from an existing WordPress form built with
        <a href="/demo/acf-field-group.example.json">ACF (Advanced Custom Fields)</a></strong>,
        where each field maps to a credential
        (<a href="/demo/acf-field-group.example.json">see the JSON</a>).
      </p>
    </div>
  </section>


  <FormlessDemo />
</Base>
