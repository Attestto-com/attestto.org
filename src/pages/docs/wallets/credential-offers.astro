---
import DocsLayout from '../../../layouts/DocsLayout.astro'
import CodeBlock from '../../../components/docs/CodeBlock.astro'
import Callout from '../../../components/docs/Callout.astro'
---

<DocsLayout
  title="Credential Offers"
  description="Open Credential Handoff (O4CH) protocol — share verifiable credentials via URL fragments without transmitting them to any server."
  currentPath="/docs/wallets/credential-offers/"
>
  <h1>Credential Offers</h1>
  <p>
    The <strong>Open Credential Handoff (O4CH)</strong> protocol lets issuers
    deliver Verifiable Credentials to holders via URL. The credential travels
    in the URL fragment (<code>#vc=</code>) and is never transmitted to a server.
  </p>

  <h2>How It Works</h2>
  <ol>
    <li>Issuer serializes the credential into a compact URL using <code>serializeCredentialOffer()</code></li>
    <li>The URL is delivered to the holder (QR code, email, link)</li>
    <li>The holder opens the URL — the receiving page reads the fragment</li>
    <li><code>parseCredentialOffer()</code> extracts and validates the credential</li>
    <li>The holder's wallet stores the credential locally</li>
  </ol>

  <Callout type="privacy">
    <p>
      Because the credential is in the <strong>URL fragment</strong> (after
      <code>#</code>), it is never sent to the server in an HTTP request.
      The credential stays entirely client-side.
    </p>
  </Callout>

  <h2>CredentialOffer</h2>
  <CodeBlock lang="TypeScript">
    <Fragment set:html={`<span class="c-kw">interface</span> <span class="c-typ">CredentialOffer</span> <span class="c-br">{</span>
  <span class="c-attr">credential</span>: <span class="c-typ">VerifiableCredential</span>  <span class="c-cm">// The full W3C VC</span>
  <span class="c-attr">issuerDid</span>: <span class="c-typ">string</span>                  <span class="c-cm">// Issuer's DID</span>
  <span class="c-attr">issuedAt</span>: <span class="c-typ">string</span>                   <span class="c-cm">// ISO 8601 timestamp</span>
  <span class="c-attr">expiresAt</span>?: <span class="c-typ">string</span>                  <span class="c-cm">// Optional expiry</span>
<span class="c-br">}</span>`} />
  </CodeBlock>

  <h2>CredentialOfferPreview</h2>
  <CodeBlock lang="TypeScript">
    <Fragment set:html={`<span class="c-kw">interface</span> <span class="c-typ">CredentialOfferPreview</span> <span class="c-br">{</span>
  <span class="c-attr">type</span>: <span class="c-typ">string</span>          <span class="c-cm">// Credential type name</span>
  <span class="c-attr">issuerName</span>: <span class="c-typ">string</span>    <span class="c-cm">// Human-readable issuer</span>
  <span class="c-attr">summary</span>: <span class="c-typ">string</span>       <span class="c-cm">// One-line description</span>
  <span class="c-attr">issuedAt</span>: <span class="c-typ">string</span>      <span class="c-cm">// When issued</span>
  <span class="c-attr">expiresAt</span>?: <span class="c-typ">string</span>    <span class="c-cm">// When it expires</span>
<span class="c-br">}</span>`} />
  </CodeBlock>

  <h2>Creating an Offer URL</h2>
  <CodeBlock lang="TypeScript">
    <Fragment set:html={`<span class="c-kw">import</span> { serializeCredentialOffer } <span class="c-kw">from</span> <span class="c-str">'@attestto/id-wallet-adapter'</span>

<span class="c-kw">const</span> url = <span class="c-fn">serializeCredentialOffer</span><span class="c-br">(</span><span class="c-br">{</span>
  <span class="c-attr">baseUrl</span>: <span class="c-str">'https://verify.attestto.com/offer/'</span>,
  <span class="c-attr">credential</span>: myVC,
  <span class="c-attr">issuerDid</span>: <span class="c-str">'did:sns:attestto.sol'</span>,
  <span class="c-attr">issuedAt</span>: <span class="c-kw">new</span> <span class="c-typ">Date</span><span class="c-br">(</span><span class="c-br">)</span>.<span class="c-fn">toISOString</span><span class="c-br">(</span><span class="c-br">)</span>,
<span class="c-br">}</span><span class="c-br">)</span>

<span class="c-cm">// Result: https://verify.attestto.com/offer/#vc=eyJ0eXAi...</span>
console.<span class="c-fn">log</span><span class="c-br">(</span>url<span class="c-br">)</span>`} />
  </CodeBlock>

  <h2>Consuming an Offer</h2>
  <CodeBlock lang="TypeScript">
    <Fragment set:html={`<span class="c-kw">import</span> { parseCredentialOffer } <span class="c-kw">from</span> <span class="c-str">'@attestto/id-wallet-adapter'</span>

<span class="c-cm">// On the receiving page</span>
<span class="c-kw">const</span> offer = <span class="c-fn">parseCredentialOffer</span><span class="c-br">(</span>window.location.href<span class="c-br">)</span>

<span class="c-kw">if</span> <span class="c-br">(</span>offer<span class="c-br">)</span> <span class="c-br">{</span>
  console.<span class="c-fn">log</span><span class="c-br">(</span><span class="c-str">'Received credential from:'</span>, offer.issuerDid<span class="c-br">)</span>
  console.<span class="c-fn">log</span><span class="c-br">(</span><span class="c-str">'Type:'</span>, offer.credential.type<span class="c-br">)</span>

  <span class="c-cm">// Store in wallet</span>
  <span class="c-kw">const</span> wallet = <span class="c-kw">await</span> <span class="c-fn">pickWallet</span><span class="c-br">(</span><span class="c-br">{</span> <span class="c-attr">render</span>: <span class="c-str">'modal'</span> <span class="c-br">}</span><span class="c-br">)</span>
  <span class="c-kw">await</span> wallet.<span class="c-fn">storeCredential</span><span class="c-br">(</span>offer.credential<span class="c-br">)</span>
<span class="c-br">}</span>`} />
  </CodeBlock>

  <h2>verify.attestto.com Implementation</h2>
  <p>
    The page at <code>verify.attestto.com/offer/</code> implements O4CH as a
    reference. When a user opens an offer URL, the page reads the fragment,
    displays a preview card using <code>CredentialOfferPreview</code>, and
    prompts the user to store the credential in their wallet.
  </p>
</DocsLayout>
