<DocsLayout
  title="JavaScript Integration"
  description="Add DID-based login to any website. Four approaches: vanilla JS, React, Vue, and Web Component. Includes backend verification with Express.js."
  currentPath="/docs/integration/javascript/"
  structuredData={structuredData}
>
  <h1>JavaScript Integration</h1>
  <p>
    Add DID-based authentication to any website. Choose your approach based on
    your stack.
  </p>

  <Callout type="warning">
    <p>
      <strong>Backend verification is required.</strong> Client-side wallet
      discovery and presentation requests are convenient for UX, but the
      Verifiable Presentation must be verified on the server where trusted
      issuer lists and resolver endpoints cannot be tampered with.
    </p>
  </Callout>

  <h2>Vanilla JavaScript</h2>
  <CodeBlock lang="HTML">
    <Fragment set:html={`<span class="c-kw">&lt;script</span> <span class="c-attr">type</span>=<span class="c-str">"module"</span><span class="c-kw">&gt;</span>
  <span class="c-kw">import</span> { pickWallet, verifyPresentation }
    <span class="c-kw">from</span> <span class="c-str">'https://cdn.attestto.com/id-wallet-adapter/0.4.1/index.mjs'</span>

  document.<span class="c-fn">getElementById</span><span class="c-br">(</span><span class="c-str">'did-login'</span><span class="c-br">)</span>.<span class="c-fn">addEventListener</span><span class="c-br">(</span><span class="c-str">'click'</span>, <span class="c-kw">async</span> <span class="c-br">(</span><span class="c-br">)</span> <span class="c-kw">=&gt;</span> <span class="c-br">{</span>
    <span class="c-kw">const</span> wallet = <span class="c-kw">await</span> <span class="c-fn">pickWallet</span><span class="c-br">(</span><span class="c-br">{</span> <span class="c-attr">render</span>: <span class="c-str">'modal'</span> <span class="c-br">}</span><span class="c-br">)</span>
    <span class="c-kw">const</span> vp = <span class="c-kw">await</span> wallet.<span class="c-fn">requestPresentation</span><span class="c-br">(</span><span class="c-br">{</span>
      <span class="c-attr">challenge</span>: crypto.<span class="c-fn">randomUUID</span><span class="c-br">(</span><span class="c-br">)</span>,
    <span class="c-br">}</span><span class="c-br">)</span>

    <span class="c-cm">// Send VP to backend for verification</span>
    <span class="c-kw">const</span> res = <span class="c-kw">await</span> <span class="c-fn">fetch</span><span class="c-br">(</span><span class="c-str">'/api/auth/did-login'</span>, <span class="c-br">{</span>
      <span class="c-attr">method</span>: <span class="c-str">'POST'</span>,
      <span class="c-attr">headers</span>: <span class="c-br">{</span> <span class="c-str">'Content-Type'</span>: <span class="c-str">'application/json'</span> <span class="c-br">}</span>,
      <span class="c-attr">body</span>: JSON.<span class="c-fn">stringify</span><span class="c-br">(</span><span class="c-br">{</span> <span class="c-attr">vp</span> <span class="c-br">}</span><span class="c-br">)</span>,
    <span class="c-br">}</span><span class="c-br">)</span>

    <span class="c-kw">const</span> session = <span class="c-kw">await</span> res.<span class="c-fn">json</span><span class="c-br">(</span><span class="c-br">)</span>
    <span class="c-kw">if</span> <span class="c-br">(</span>session.authenticated<span class="c-br">)</span> <span class="c-br">{</span>
      window.location.href = <span class="c-str">'/dashboard'</span>
    <span class="c-br">}</span>
  <span class="c-br">}</span><span class="c-br">)</span>
<span class="c-kw">&lt;/script&gt;</span>

<span class="c-kw">&lt;button</span> <span class="c-attr">id</span>=<span class="c-str">"did-login"</span><span class="c-kw">&gt;</span>Sign in with DID<span class="c-kw">&lt;/button&gt;</span>`} />
  </CodeBlock>

  <h2>React</h2>
  <CodeBlock lang="TypeScript" title="DIDLogin.tsx">
    <Fragment set:html={`<span class="c-kw">import</span> { pickWallet } <span class="c-kw">from</span> <span class="c-str">'@attestto/id-wallet-adapter'</span>

<span class="c-kw">export function</span> <span class="c-fn">DIDLogin</span><span class="c-br">(</span><span class="c-br">)</span> <span class="c-br">{</span>
  <span class="c-kw">const</span> <span class="c-fn">handleLogin</span> = <span class="c-kw">async</span> <span class="c-br">(</span><span class="c-br">)</span> <span class="c-kw">=&gt;</span> <span class="c-br">{</span>
    <span class="c-kw">const</span> wallet = <span class="c-kw">await</span> <span class="c-fn">pickWallet</span><span class="c-br">(</span><span class="c-br">{</span> <span class="c-attr">render</span>: <span class="c-str">'modal'</span> <span class="c-br">}</span><span class="c-br">)</span>
    <span class="c-kw">const</span> vp = <span class="c-kw">await</span> wallet.<span class="c-fn">requestPresentation</span><span class="c-br">(</span><span class="c-br">{</span>
      <span class="c-attr">challenge</span>: crypto.<span class="c-fn">randomUUID</span><span class="c-br">(</span><span class="c-br">)</span>,
    <span class="c-br">}</span><span class="c-br">)</span>

    <span class="c-kw">const</span> res = <span class="c-kw">await</span> <span class="c-fn">fetch</span><span class="c-br">(</span><span class="c-str">'/api/auth/did-login'</span>, <span class="c-br">{</span>
      <span class="c-attr">method</span>: <span class="c-str">'POST'</span>,
      <span class="c-attr">headers</span>: <span class="c-br">{</span> <span class="c-str">'Content-Type'</span>: <span class="c-str">'application/json'</span> <span class="c-br">}</span>,
      <span class="c-attr">body</span>: JSON.<span class="c-fn">stringify</span><span class="c-br">(</span><span class="c-br">{</span> <span class="c-attr">vp</span> <span class="c-br">}</span><span class="c-br">)</span>,
    <span class="c-br">}</span><span class="c-br">)</span>

    <span class="c-kw">const</span> session = <span class="c-kw">await</span> res.<span class="c-fn">json</span><span class="c-br">(</span><span class="c-br">)</span>
    <span class="c-kw">if</span> <span class="c-br">(</span>session.authenticated<span class="c-br">)</span> window.location.href = <span class="c-str">'/dashboard'</span>
  <span class="c-br">}</span>

  <span class="c-kw">return</span> <span class="c-br">(</span>
    <span class="c-kw">&lt;button</span> <span class="c-attr">onClick</span>=<span class="c-br">{</span>handleLogin<span class="c-br">}</span><span class="c-kw">&gt;</span>Sign in with DID<span class="c-kw">&lt;/button&gt;</span>
  <span class="c-br">)</span>
<span class="c-br">}</span>`} />
  </CodeBlock>

  <h2>Vue</h2>
  <CodeBlock lang="Vue" title="DIDLogin.vue">
    <Fragment set:html={`<span class="c-kw">&lt;script</span> <span class="c-attr">setup</span> <span class="c-attr">lang</span>=<span class="c-str">"ts"</span><span class="c-kw">&gt;</span>
<span class="c-kw">import</span> { pickWallet } <span class="c-kw">from</span> <span class="c-str">'@attestto/id-wallet-adapter'</span>

<span class="c-kw">async function</span> <span class="c-fn">handleLogin</span><span class="c-br">(</span><span class="c-br">)</span> <span class="c-br">{</span>
  <span class="c-kw">const</span> wallet = <span class="c-kw">await</span> <span class="c-fn">pickWallet</span><span class="c-br">(</span><span class="c-br">{</span> <span class="c-attr">render</span>: <span class="c-str">'modal'</span> <span class="c-br">}</span><span class="c-br">)</span>
  <span class="c-kw">const</span> vp = <span class="c-kw">await</span> wallet.<span class="c-fn">requestPresentation</span><span class="c-br">(</span><span class="c-br">{</span>
    <span class="c-attr">challenge</span>: crypto.<span class="c-fn">randomUUID</span><span class="c-br">(</span><span class="c-br">)</span>,
  <span class="c-br">}</span><span class="c-br">)</span>

  <span class="c-kw">const</span> res = <span class="c-kw">await</span> <span class="c-fn">fetch</span><span class="c-br">(</span><span class="c-str">'/api/auth/did-login'</span>, <span class="c-br">{</span>
    <span class="c-attr">method</span>: <span class="c-str">'POST'</span>,
    <span class="c-attr">headers</span>: <span class="c-br">{</span> <span class="c-str">'Content-Type'</span>: <span class="c-str">'application/json'</span> <span class="c-br">}</span>,
    <span class="c-attr">body</span>: JSON.<span class="c-fn">stringify</span><span class="c-br">(</span><span class="c-br">{</span> <span class="c-attr">vp</span> <span class="c-br">}</span><span class="c-br">)</span>,
  <span class="c-br">}</span><span class="c-br">)</span>

  <span class="c-kw">const</span> session = <span class="c-kw">await</span> res.<span class="c-fn">json</span><span class="c-br">(</span><span class="c-br">)</span>
  <span class="c-kw">if</span> <span class="c-br">(</span>session.authenticated<span class="c-br">)</span> window.location.href = <span class="c-str">'/dashboard'</span>
<span class="c-br">}</span>
<span class="c-kw">&lt;/script&gt;</span>

<span class="c-kw">&lt;template&gt;</span>
  <span class="c-kw">&lt;button</span> <span class="c-attr">@click</span>=<span class="c-str">"handleLogin"</span><span class="c-kw">&gt;</span>Sign in with DID<span class="c-kw">&lt;/button&gt;</span>
<span class="c-kw">&lt;/template&gt;</span>`} />
  </CodeBlock>

  <h2>Web Component</h2>
  <CodeBlock lang="HTML">
    <Fragment set:html={`<span class="c-cm">&lt;!-- Drop-in: no framework needed --&gt;</span>
<span class="c-kw">&lt;script</span> <span class="c-attr">type</span>=<span class="c-str">"module"</span>
  <span class="c-attr">src</span>=<span class="c-str">"https://cdn.attestto.com/id-wallet-adapter/0.4.1/did-login.mjs"</span>
<span class="c-kw">&gt;&lt;/script&gt;</span>

<span class="c-kw">&lt;attestto-did-login</span>
  <span class="c-attr">verify-endpoint</span>=<span class="c-str">"/api/auth/did-login"</span>
  <span class="c-attr">redirect</span>=<span class="c-str">"/dashboard"</span>
<span class="c-kw">&gt;&lt;/attestto-did-login&gt;</span>`} />
  </CodeBlock>

  <h2>Backend: Express.js Middleware</h2>
  <CodeBlock lang="TypeScript" title="middleware/did-auth.ts">
    <Fragment set:html={`<span class="c-kw">import</span> { verifyPresentation } <span class="c-kw">from</span> <span class="c-str">'@attestto/id-wallet-adapter'</span>

<span class="c-kw">const</span> TRUSTED_ISSUERS = <span class="c-br">[</span>
  <span class="c-str">'did:web:gov.example.com'</span>,
  <span class="c-str">'did:sns:attestto.sol'</span>,
<span class="c-br">]</span>

<span class="c-kw">export async function</span> <span class="c-fn">didAuth</span><span class="c-br">(</span>req, res<span class="c-br">)</span> <span class="c-br">{</span>
  <span class="c-kw">const</span> { vp } = req.body
  <span class="c-kw">if</span> <span class="c-br">(</span><span class="c-op">!</span>vp<span class="c-br">)</span> <span class="c-kw">return</span> res.<span class="c-fn">status</span><span class="c-br">(</span><span class="c-num">400</span><span class="c-br">)</span>.<span class="c-fn">json</span><span class="c-br">(</span><span class="c-br">{</span> <span class="c-attr">error</span>: <span class="c-str">'Missing VP'</span> <span class="c-br">}</span><span class="c-br">)</span>

  <span class="c-kw">const</span> result = <span class="c-kw">await</span> <span class="c-fn">verifyPresentation</span><span class="c-br">(</span>vp, <span class="c-br">{</span>
    <span class="c-attr">trustedIssuers</span>: TRUSTED_ISSUERS,
    <span class="c-attr">checkRevocation</span>: <span class="c-kw">true</span>,
  <span class="c-br">}</span><span class="c-br">)</span>

  <span class="c-kw">if</span> <span class="c-br">(</span><span class="c-op">!</span>result.valid<span class="c-br">)</span> <span class="c-br">{</span>
    <span class="c-kw">return</span> res.<span class="c-fn">status</span><span class="c-br">(</span><span class="c-num">401</span><span class="c-br">)</span>.<span class="c-fn">json</span><span class="c-br">(</span><span class="c-br">{</span> <span class="c-attr">errors</span>: result.errors <span class="c-br">}</span><span class="c-br">)</span>
  <span class="c-br">}</span>

  <span class="c-cm">// Create session with the verified holder DID</span>
  req.session.did = result.holderDid
  res.<span class="c-fn">json</span><span class="c-br">(</span><span class="c-br">{</span> <span class="c-attr">authenticated</span>: <span class="c-kw">true</span>, <span class="c-attr">did</span>: result.holderDid <span class="c-br">}</span><span class="c-br">)</span>
<span class="c-br">}</span>`} />
  </CodeBlock>

  <h2>CDN Approach</h2>
  <p>
    For sites that cannot use npm, the adapter is available via CDN as a single
    ESM module. Add a <code>&lt;script type="module"&gt;</code> tag pointing to
    the CDN URL. No build step required.
  </p>
  <CodeBlock lang="HTML">
    <Fragment set:html={`<span class="c-kw">&lt;script</span> <span class="c-attr">type</span>=<span class="c-str">"module"</span> <span class="c-attr">src</span>=<span class="c-str">"https://cdn.attestto.com/id-wallet-adapter/0.4.1/index.mjs"</span><span class="c-kw">&gt;&lt;/script&gt;</span>`} />
  </CodeBlock>
</DocsLayout>
