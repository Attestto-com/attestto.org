---
import Base from '../layouts/Base.astro'
---

<Base
  title="Page Not Found — Attestto"
  description="The page you're looking for doesn't exist. Explore Attestto's open infrastructure for sovereign identity."
  canonicalPath="/404"
>
  <section class="error-page">
    <div class="container">
      <div class="error-content">
        <div class="error-code">404</div>
        <h1>Page not found</h1>
        <p>The page you're looking for doesn't exist or has been moved.</p>
        <div class="error-actions">
          <a href="/" class="cta-primary">Go to homepage</a>
          <a href="/why" class="cta-secondary">Why Attestto exists</a>
          <a href="/standards" class="cta-secondary">Standards</a>
          <a href="/docs" class="cta-secondary">Documentation</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .error-page {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--space-xl) 0;
  }

  .error-content {
    max-width: 32rem;
  }

  .error-code {
    font-family: var(--font-mono);
    font-size: clamp(4rem, 12vw, 8rem);
    font-weight: 800;
    color: var(--color-accent);
    line-height: 1;
    margin-bottom: var(--space-xs);
  }

  .error-content h1 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-ink);
    margin-bottom: var(--space-xs);
  }

  .error-content p {
    font-size: 1rem;
    color: var(--color-ink-muted);
    margin-bottom: var(--space-md);
  }

  .error-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    justify-content: center;
  }
</style>
