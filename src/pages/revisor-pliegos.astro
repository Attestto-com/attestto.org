---
import Base from '../layouts/Base.astro'
---

<Base
  title="Revisor de Pliegos — Attestto"
  description="Herramienta gratuita para funcionarios publicos. Suba un pliego de licitacion y reciba un analisis de cumplimiento del marco legal costarricense: portabilidad de datos, privacidad ciudadana y estandares abiertos."
  canonicalPath="/revisor-pliegos"
  lang="es"
  navVariant="revisor"
  footerVariant="revisor"
  bodyClass="page-revisor"
>

  <!-- Hero -->
  <section class="gov-hero">
    <div class="container">
      <div class="badge">Herramienta gratuita para funcionarios publicos</div>
      <h1>Revisor de Pliegos</h1>
      <p class="lead">Suba un pliego de licitacion y reciba un analisis automatico contra el marco legal costarricense: Ley 8968 (proteccion de datos), Ley 8642 (neutralidad tecnologica), Ley 7494 (contratacion administrativa) y estandares abiertos W3C/ISO.</p>
    </div>
  </section>

  <!-- Analyzer -->
  <div class="analyzer">

    <!-- File upload -->
    <div class="file-drop" id="fileDrop">
      <div class="icon">&#128196;</div>
      <div class="main-text">Suba el documento del pliego</div>
      <div class="sub-text">Arrastre aqui o haga clic para seleccionar — PDF, Word o texto plano</div>
      <div class="file-name" id="fileName"></div>
      <input type="file" id="fileInput" accept=".pdf,.docx,.doc,.txt,.md,.rtf">
    </div>

    <div style="font-size: 0.78rem; color: rgba(255,255,255,0.3); margin-bottom: var(--space-sm); line-height: 1.6;">
      <strong style="color: rgba(255,255,255,0.5);">Privacidad:</strong> Su documento se procesa en memoria y se descarta. No se almacena, no se comparte, no se vende. El texto se envia a la API de Anthropic (Claude) para analisis — <a href="https://www.anthropic.com/privacy" target="_blank" rel="noopener" style="color: #60a5fa;">politica de Anthropic</a>. Solo guardamos los resultados anonimizados (puntuaciones y hallazgos). <a href="https://github.com/Attestto-com/attestto-pliego-reviewer" target="_blank" rel="noopener" style="color: #60a5fa;">Codigo fuente abierto</a>.
    </div>
    <button class="btn-analyze" id="analyzeBtn" disabled>Analizar pliego</button>
    <div class="status-msg" id="statusText"></div>

    <!-- Extension CTA (shown after free analysis used) -->
    <div class="ext-cta" id="extCta" style="display: none;">
      <div class="ext-cta-inner">
        <div class="ext-cta-left">
          <div class="ext-cta-title">Attestto ID — Extension para navegador</div>
          <div class="ext-cta-desc">Instale la extension para obtener 1 analisis diario gratuito. Ademas:</div>
          <ul class="ext-cta-benefits">
            <li>Verifique credenciales y firmas digitales en cualquier sitio web</li>
            <li>Obtenga su identidad digital (DID) con un clic</li>
            <li>Proteja sus datos con firma criptografica desde el navegador</li>
            <li>1 analisis de pliego por dia, gratis</li>
          </ul>
        </div>
        <div class="ext-cta-right">
          <a href="https://attestto.org/downloads" class="btn-ext" target="_blank" rel="noopener">Descargar extension</a>
          <div class="ext-cta-note">Chrome, Edge, Brave y Firefox</div>
        </div>
      </div>
    </div>

    <!-- Results -->
    <div class="results" id="results">
      <h2>Resultado del analisis</h2>
      <div class="score-bar" id="scoreBar"></div>
      <div id="summaryCard"></div>

      <h2 style="margin-top: var(--space-lg);">Matriz de Cumplimiento</h2>
      <div class="matrix-counters" id="matrixCounters"></div>
      <div class="matrix-tabs" id="matrixTabs"></div>
      <table class="matrix-table" id="matrixTable">
        <thead>
          <tr><th>REF</th><th>REQUISITO</th><th>ESTADO</th><th>HALLAZGO</th></tr>
        </thead>
        <tbody id="matrixBody"></tbody>
      </table>

      <div id="violationsSection"></div>

      <!-- Chat -->
      <div id="chatSection" style="display: none; margin-top: var(--space-lg);">
        <h2>Preguntas sobre el analisis</h2>
        <p style="color: rgba(255,255,255,0.45); font-size: 0.9rem; margin-bottom: var(--space-sm);">Seleccione su perfil y pregunte sobre los hallazgos.</p>
        <div style="display: flex; gap: 0.5rem; margin-bottom: var(--space-sm); flex-wrap: wrap;">
          <button class="role-btn active" data-role="funcionario" style="padding: 0.5rem 1rem; border-radius: 6px; border: 1px solid rgba(255,255,255,0.1); background: rgba(74,222,128,0.1); color: #4ade80; font-weight: 600; font-size: 0.8rem; cursor: pointer;">Funcionario</button>
          <button class="role-btn" data-role="legal" style="padding: 0.5rem 1rem; border-radius: 6px; border: 1px solid rgba(255,255,255,0.1); background: transparent; color: rgba(255,255,255,0.4); font-weight: 600; font-size: 0.8rem; cursor: pointer;">Asesor Legal</button>
          <button class="role-btn" data-role="tecnico" style="padding: 0.5rem 1rem; border-radius: 6px; border: 1px solid rgba(255,255,255,0.1); background: transparent; color: rgba(255,255,255,0.4); font-weight: 600; font-size: 0.8rem; cursor: pointer;">Director TI / CTO</button>
          <button class="role-btn" data-role="auditor" style="padding: 0.5rem 1rem; border-radius: 6px; border: 1px solid rgba(255,255,255,0.1); background: transparent; color: rgba(255,255,255,0.4); font-weight: 600; font-size: 0.8rem; cursor: pointer;">Auditor / CGR</button>
        </div>
        <div id="chatMessages" style="margin-bottom: var(--space-sm); max-height: 400px; overflow-y: auto;"></div>
        <div style="display: flex; gap: 0.5rem;">
          <input type="text" id="chatInput" placeholder="Ej: Que requisitos de portabilidad de datos exige la Ley 8968?" style="flex: 1; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; color: #e2e8f0; padding: 0.75rem 1rem; font-size: 0.92rem;">
          <button id="chatSend" style="background: #594FD3; color: #fff; border: none; border-radius: 8px; padding: 0.75rem 1.5rem; font-weight: 600; cursor: pointer; font-size: 0.92rem;">Preguntar</button>
        </div>
      </div>

      <!-- Download report -->
      <div id="downloadSection" style="display: none; margin-top: var(--space-lg); text-align: center;">
        <button class="btn-analyze" id="downloadBtn" style="max-width: 400px; margin: 0 auto;" onclick="downloadReport()">Descargar reporte (PDF)</button>
        <div style="font-size: 0.78rem; color: rgba(255,255,255,0.3); margin-top: 0.5rem;">El reporte incluye la matriz completa, hallazgos y referencias legales.</div>
      </div>

      <details style="margin-top: var(--space-md);">
        <summary style="cursor: pointer; font-size: 0.85rem; color: rgba(255,255,255,0.35);">Ver datos que guardamos (transparencia)</summary>
        <p style="font-size: 0.78rem; color: rgba(255,255,255,0.3); margin: 0.5rem 0;">Esto es exactamente lo que se almacena de forma anonimizada. No incluye su documento ni datos personales.</p>
        <div class="raw-output" id="rawOutput"></div>
      </details>
    </div>
  </div>

  <!-- Marco legal — checklist -->
  <div class="analyzer">
    <div class="checklist">
      <h2>Marco legal aplicable</h2>
      <p class="checklist-intro">Cada requisito legal tiene una forma concreta de resolverse en un pliego de licitacion.</p>
      <div class="legal-rows">

        <div class="legal-row">
          <div class="legal-req">
            <h3>Ley 8968 Art. 7 · Portabilidad</h3>
            <p>El ciudadano tiene derecho a que sus datos sean exportables en formato estandar al terminar un contrato.</p>
          </div>
          <div class="legal-fix">
            <p>Exigir en el pliego que el sistema exporte datos en formatos abiertos (JSON, CSV, XML) sin costo adicional y sin depender del proveedor.</p>
          </div>
        </div>

        <div class="legal-row">
          <div class="legal-req">
            <h3>Ley 8642 Art. 3(h) · Neutralidad tecnologica</h3>
            <p>Ningun requisito tecnico debe favorecer una tecnologia sobre otra.</p>
          </div>
          <div class="legal-fix">
            <p>Especificar estandares (W3C, ISO, IETF) en lugar de productos. Aceptar cualquier implementacion que cumpla el estandar.</p>
          </div>
        </div>

        <div class="legal-row">
          <div class="legal-req">
            <h3>Ley 8968 Art. 4-5 · Minimizacion y finalidad</h3>
            <p>Solo recopilar datos estrictamente necesarios. No usar datos para fines distintos al declarado.</p>
          </div>
          <div class="legal-fix">
            <p>Definir en el pliego exactamente que datos se recopilan y para que. Prohibir reutilizacion o venta. Exigir mecanismos de divulgacion selectiva.</p>
          </div>
        </div>

        <div class="legal-row">
          <div class="legal-req">
            <h3>Ley 8292 · Control Interno / CGR</h3>
            <p>Un auditor independiente debe poder verificar la integridad de los datos sin depender del proveedor.</p>
          </div>
          <div class="legal-fix">
            <p>Incluir clausula de auditoria independiente. Exigir logs inmutables y firmas criptograficas verificables por terceros.</p>
          </div>
        </div>

        <div class="legal-row">
          <div class="legal-req">
            <h3>D.E. 45061-MICITT · Ciberseguridad</h3>
            <p>Los sistemas deben mantener integridad verificable aun si el servidor es comprometido.</p>
          </div>
          <div class="legal-fix">
            <p>Exigir integridad criptografica a nivel de documento (firmas digitales, hashes), no solo seguridad perimetral. Arquitectura resiliente a compromiso de servidor.</p>
          </div>
        </div>

        <div class="legal-row">
          <div class="legal-req">
            <h3>Ley 7494 Art. 5 · Contratacion administrativa</h3>
            <p>Los pliegos deben permitir la participacion de multiples proveedores en igualdad de condiciones.</p>
          </div>
          <div class="legal-fix">
            <p>Evitar requisitos que solo un proveedor pueda cumplir. Especificar capacidades funcionales, no marcas o productos especificos.</p>
          </div>
        </div>

        <div class="legal-row">
          <div class="legal-req">
            <h3>Ley 8131 · Eficiencia en gasto publico</h3>
            <p>El Estado debe minimizar costos de cambio y evitar dependencias contractuales innecesarias.</p>
          </div>
          <div class="legal-fix">
            <p>Incluir clausula de transicion: datos y flujos deben ser migrables a otro proveedor. Codigo fuente o APIs documentadas como entregable.</p>
          </div>
        </div>

        <div class="legal-row">
          <div class="legal-req">
            <h3>Art. 24 Constitucion · Autodeterminacion informativa</h3>
            <p>El ciudadano debe poder verificar y rectificar sus datos sin depender de intermediarios.</p>
          </div>
          <div class="legal-fix">
            <p>Exigir acceso directo del ciudadano a sus datos. No condicionar acceso a sucursales, tokens fisicos o software propietario.</p>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Checklist para diseño de pliegos -->
  <div class="analyzer">
    <div class="checklist">
      <h2>Checklist para diseño de pliegos</h2>
      <p class="checklist-intro">Use esta lista al redactar los requisitos de una licitacion que involucre datos ciudadanos. Cada clausula esta respaldada por legislacion vigente.</p>

      <div class="tender-checklist" id="tenderChecklist">

        <div class="tender-category">
          <h3>Portabilidad y formatos</h3>
          <label class="tender-item">
            <input type="checkbox">
            <span class="tender-text">El sistema debe permitir exportacion completa de datos en formatos abiertos (JSON, CSV, XML) sin costo adicional.</span>
            <span class="tender-law">Ley 8968 Art. 7</span>
          </label>
          <label class="tender-item">
            <input type="checkbox">
            <span class="tender-text">Los requisitos tecnicos se especifican por estandar internacional (W3C, ISO, IETF), no por producto o marca.</span>
            <span class="tender-law">Ley 8642 Art. 3(h)</span>
          </label>
          <label class="tender-item">
            <input type="checkbox">
            <span class="tender-text">Al finalizar el contrato, los datos y flujos deben ser migrables a otro proveedor sin perdida ni conversion propietaria.</span>
            <span class="tender-law">Ley 8131 · Eficiencia</span>
          </label>
        </div>

        <div class="tender-category">
          <h3>Privacidad y datos personales</h3>
          <label class="tender-item">
            <input type="checkbox">
            <span class="tender-text">El pliego define explicitamente que datos personales se recopilan y con que finalidad exclusiva.</span>
            <span class="tender-law">Ley 8968 Art. 4-5</span>
          </label>
          <label class="tender-item">
            <input type="checkbox">
            <span class="tender-text">Se prohibe el uso de datos para fines distintos al declarado, incluyendo venta o cesion a terceros.</span>
            <span class="tender-law">Ley 8968 Art. 5</span>
          </label>
          <label class="tender-item">
            <input type="checkbox">
            <span class="tender-text">El ciudadano puede acceder, verificar y rectificar sus datos directamente, sin depender de sucursales o software propietario.</span>
            <span class="tender-law">Art. 24 Constitucion</span>
          </label>
        </div>

        <div class="tender-category">
          <h3>Seguridad e integridad</h3>
          <label class="tender-item">
            <input type="checkbox">
            <span class="tender-text">Los documentos y datos deben tener integridad criptografica a nivel individual (firmas digitales, hashes), no solo seguridad perimetral.</span>
            <span class="tender-law">D.E. 45061-MICITT</span>
          </label>
          <label class="tender-item">
            <input type="checkbox">
            <span class="tender-text">El sistema debe mantener verificabilidad aun si el servidor es comprometido (resiliencia post-Conti).</span>
            <span class="tender-law">D.E. 45061-MICITT / NIST CSF 2.0</span>
          </label>
          <label class="tender-item">
            <input type="checkbox">
            <span class="tender-text">Se incluye clausula de auditoria independiente: logs inmutables y firmas verificables por terceros.</span>
            <span class="tender-law">Ley 8292 · CGR</span>
          </label>
        </div>

        <div class="tender-category">
          <h3>Competencia y transparencia</h3>
          <label class="tender-item">
            <input type="checkbox">
            <span class="tender-text">Los requisitos son funcionales (que debe hacer el sistema), no restrictivos (que producto debe usar).</span>
            <span class="tender-law">Ley 7494 Art. 5</span>
          </label>
          <label class="tender-item">
            <input type="checkbox">
            <span class="tender-text">Se incluye clausula de transicion con entregables documentados: APIs, codigo fuente o especificaciones suficientes para migrar.</span>
            <span class="tender-law">Ley 8131 · Eficiencia</span>
          </label>
          <label class="tender-item">
            <input type="checkbox">
            <span class="tender-text">El consentimiento informado del ciudadano esta contemplado antes de cualquier recopilacion o transferencia de datos.</span>
            <span class="tender-law">Ley 8968 Art. 5</span>
          </label>
        </div>

      </div>

      <div class="tender-actions">
        <div class="tender-progress">
          <span id="checkCount">0</span> / <span id="checkTotal">12</span> clausulas incluidas
        </div>
        <button class="btn-analyze" id="printChecklist" style="max-width: 320px;">Imprimir checklist</button>
      </div>

    </div>
  </div>

  <script is:inline>
  // ── Tender checklist counter + print ──
  (function() {
    var checks = document.querySelectorAll('#tenderChecklist input[type="checkbox"]');
    var countEl = document.getElementById('checkCount');
    var totalEl = document.getElementById('checkTotal');
    totalEl.textContent = checks.length;

    checks.forEach(function(cb) {
      cb.addEventListener('change', function() {
        var n = 0;
        checks.forEach(function(c) { if (c.checked) n++; });
        countEl.textContent = n;
      });
    });

    document.getElementById('printChecklist').addEventListener('click', function() {
      var items = [];
      checks.forEach(function(cb) {
        var label = cb.closest('.tender-item');
        var text = label.querySelector('.tender-text').textContent;
        var law = label.querySelector('.tender-law').textContent;
        items.push({ text: text, law: law, checked: cb.checked });
      });

      var date = new Date().toLocaleDateString('es-CR', { year: 'numeric', month: 'long', day: 'numeric' });
      var html = '<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8">' +
        '<title>Checklist para Diseño de Pliegos — Attestto</title>' +
        '<style>' +
        'body{font-family:Arial,sans-serif;color:#1a1a2e;padding:40px;font-size:13px;line-height:1.6;}' +
        'h1{font-size:18px;margin-bottom:4px;}' +
        '.meta{color:#666;font-size:12px;margin-bottom:24px;}' +
        '.item{display:flex;gap:10px;padding:8px 0;border-bottom:1px solid #eee;align-items:flex-start;}' +
        '.box{width:16px;height:16px;border:2px solid #333;border-radius:3px;flex-shrink:0;margin-top:2px;display:flex;align-items:center;justify-content:center;font-size:12px;}' +
        '.box.done{background:#dcfce7;border-color:#16a34a;}' +
        '.text{flex:1;}' +
        '.law{font-size:11px;color:#4a6cf7;font-family:monospace;white-space:nowrap;}' +
        '.footer{margin-top:30px;padding-top:12px;border-top:1px solid #ddd;font-size:11px;color:#999;text-align:center;}' +
        '@media print{body{padding:20px;}@page{margin:1.5cm;}}' +
        '</style></head><body>';
      html += '<h1>Checklist para Diseño de Pliegos de Licitacion</h1>';
      html += '<div class="meta">Fecha: ' + date + ' · Basado en legislacion costarricense vigente · attestto.org/revisor-pliegos/</div>';

      for (var i = 0; i < items.length; i++) {
        var it = items[i];
        html += '<div class="item">' +
          '<div class="box' + (it.checked ? ' done' : '') + '">' + (it.checked ? '✓' : '') + '</div>' +
          '<div class="text">' + it.text + '</div>' +
          '<div class="law">' + it.law + '</div></div>';
      }

      html += '<div class="footer">Generado por Attestto · attestto.org/revisor-pliegos/ · Herramienta gratuita, codigo abierto Apache 2.0<br>Esta lista es una guia basada en el marco legal. No constituye asesoria legal.</div>';
      html += '</body></html>';

      var win = window.open('', '_blank');
      win.document.write(html);
      win.document.close();
      setTimeout(function() { win.print(); }, 500);
    });
  })();
  </script>

  <script is:inline>
  (function() {
    var PLIEGO_API = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1'
      ? 'http://localhost:3100'
      : 'https://pliego.attestto.org';

    var fileDrop = document.getElementById('fileDrop');
    var fileInput = document.getElementById('fileInput');
    var fileNameEl = document.getElementById('fileName');
    var analyzeBtn = document.getElementById('analyzeBtn');
    var statusText = document.getElementById('statusText');
    var results = document.getElementById('results');
    var scoreBar = document.getElementById('scoreBar');
    var riskCards = document.getElementById('riskCards');
    var rawOutput = document.getElementById('rawOutput');

    var uploadedFile = null;

    // ── File upload ──
    fileDrop.addEventListener('click', function() { fileInput.click(); });
    fileDrop.addEventListener('dragover', function(e) { e.preventDefault(); fileDrop.classList.add('dragover'); });
    fileDrop.addEventListener('dragleave', function() { fileDrop.classList.remove('dragover'); });
    fileDrop.addEventListener('drop', function(e) {
      e.preventDefault();
      fileDrop.classList.remove('dragover');
      if (e.dataTransfer.files.length) handleFile(e.dataTransfer.files[0]);
    });
    fileInput.addEventListener('change', function(e) {
      if (e.target.files.length) handleFile(e.target.files[0]);
    });

    function handleFile(file) {
      var maxSize = 10 * 1024 * 1024; // 10MB
      if (file.size > maxSize) {
        statusText.textContent = 'El archivo excede 10 MB. Intente con un archivo mas pequeno.';
        statusText.style.color = '#ef4444';
        return;
      }
      uploadedFile = file;
      // Store text for chat context
      if (file.type === 'text/plain' || file.name.endsWith('.txt') || file.name.endsWith('.md')) {
        file.text().then(function(t) { lastPlegoText = t.substring(0, 4000); });
      }
      fileNameEl.textContent = file.name + ' (' + (file.size / 1024).toFixed(0) + ' KB)';
      analyzeBtn.disabled = false;
      statusText.textContent = '';
    }

    // ── Analysis ──
    analyzeBtn.addEventListener('click', runAnalysis);

    async function runAnalysis() {
      if (!uploadedFile) return;

      analyzeBtn.disabled = true;
      statusText.style.color = '#4ade80';
      var steps = [
        'Extrayendo texto del documento...',
        'Analizando identidad y autenticacion (A1-A5)...',
        'Revisando privacidad y proteccion de datos (B1-B6)...',
        'Evaluando interoperabilidad (C1-C5)...',
        'Verificando seguridad (D1-D5)...',
        'Revisando gobernanza y propiedad intelectual (E1-E5)...',
        'Evaluando cumplimiento AML/CFT (F1-F4)...',
        'Verificando acceso ciudadano (G1-G4)...',
        'Generando matriz de cumplimiento (34 checks)...',
        'Identificando violaciones criticas...',
        'Preparando reporte final...',
      ];
      var stepIdx = 0;
      var elapsed = 0;
      statusText.textContent = steps[0];
      var progressInterval = setInterval(function() {
        elapsed += 3;
        stepIdx = (stepIdx + 1) % steps.length;
        statusText.textContent = steps[stepIdx] + ' (' + elapsed + 's)';
      }, 3000);
      results.classList.remove('visible');

      try {
        var formData = new FormData();
        formData.append('file', uploadedFile);

        var response = await fetch(PLIEGO_API + '/api/analyze', {
          method: 'POST',
          body: formData,
        });

        if (response.status === 429) {
          clearInterval(progressInterval);
          var errData = await response.json();
          statusText.textContent = 'Limite alcanzado. Instale la extension para 1 analisis diario.';
          statusText.style.color = '#fbbf24';
          document.getElementById('extCta').style.display = 'block';
          analyzeBtn.disabled = false;
          return;
        }

        if (!response.ok) {
          var errBody = await response.json().catch(function() { return {}; });
          throw new Error(errBody.error || 'Error del servidor: ' + response.status);
        }

        var data = await response.json();
        var analysis = data.analysis;

        clearInterval(progressInterval);
        if (analysis) {
          renderResults(analysis);
          statusText.textContent = 'Analisis completo.';
          statusText.style.color = '#4ade80';
        } else {
          statusText.textContent = 'No se pudo procesar el documento.';
          statusText.style.color = '#ef4444';
        }
      } catch (err) {
        clearInterval(progressInterval);
        statusText.textContent = 'Error: ' + err.message;
        statusText.style.color = '#ef4444';
      }

      analyzeBtn.disabled = false;
    }

    var CATEGORY_NAMES = {
      A: 'Identidad', B: 'Privacidad', C: 'Interoperabilidad',
      D: 'Seguridad', E: 'Gobernanza', F: 'AML/CFT', G: 'Acceso Ciudadano'
    };

    var EVAL_BADGE = {
      cumple: 'badge-cumple', insuficiente: 'badge-insuficiente',
      ausente: 'badge-ausente', incumple: 'badge-incumple', viola: 'badge-incumple'
    };

    var EVAL_LABEL = {
      cumple: 'CUMPLE', insuficiente: 'INSUFICIENTE',
      ausente: 'AUSENTE', incumple: 'INCUMPLE', viola: 'INCUMPLE'
    };

    var currentTab = 'all';

    function renderResults(analysis) {
      // Scores
      scoreBar.innerHTML = '';
      if (analysis.scores) {
        for (var key in analysis.scores) {
          var score = analysis.scores[key];
          var colorClass = score.value >= 70 ? 'score-good' : score.value >= 40 ? 'score-warn' : 'score-bad';
          scoreBar.innerHTML +=
            '<div class="score-item">' +
              '<div class="score-value ' + colorClass + '">' + score.value + '</div>' +
              '<div class="score-label">' + score.label + '</div>' +
            '</div>';
        }
      }

      // Summary
      var summaryCard = document.getElementById('summaryCard');
      summaryCard.innerHTML = '';
      if (analysis.summary) {
        summaryCard.innerHTML =
          '<div class="risk-card" style="border-left: 3px solid #60a5fa; margin-bottom: var(--space-md);">' +
            '<p style="color: rgba(255,255,255,0.8);">' + analysis.summary + '</p>' +
          '</div>';
      }

      // Matrix counters
      var matrixCounters = document.getElementById('matrixCounters');
      var matrix = analysis.matrix || [];
      var counts = { cumple: 0, insuficiente: 0, ausente: 0, viola: 0 };
      for (var i = 0; i < matrix.length; i++) {
        var ev = matrix[i].evaluation;
        if (counts[ev] !== undefined) counts[ev]++;
      }
      matrixCounters.innerHTML =
        '<div class="matrix-counter"><span class="num" style="color:#4ade80;">' + counts.cumple + '</span><span class="lbl">Cumple</span></div>' +
        '<div class="matrix-counter"><span class="num" style="color:#fbbf24;">' + counts.insuficiente + '</span><span class="lbl">Insuficiente</span></div>' +
        '<div class="matrix-counter"><span class="num" style="color:#94a3b8;">' + counts.ausente + '</span><span class="lbl">Ausente</span></div>' +
        '<div class="matrix-counter"><span class="num" style="color:#ef4444;">' + counts.viola + '</span><span class="lbl">Viola</span></div>';

      // Matrix tabs
      var matrixTabs = document.getElementById('matrixTabs');
      matrixTabs.innerHTML = '<button class="matrix-tab active" data-cat="all">Todos</button>';
      var cats = {};
      for (var i = 0; i < matrix.length; i++) {
        var catId = matrix[i].framework_id.charAt(0);
        cats[catId] = true;
      }
      for (var c in CATEGORY_NAMES) {
        if (cats[c]) {
          matrixTabs.innerHTML += '<button class="matrix-tab" data-cat="' + c + '">' + CATEGORY_NAMES[c] + '</button>';
        }
      }
      matrixTabs.querySelectorAll('.matrix-tab').forEach(function(tab) {
        tab.addEventListener('click', function() {
          matrixTabs.querySelectorAll('.matrix-tab').forEach(function(t) { t.classList.remove('active'); });
          tab.classList.add('active');
          currentTab = tab.getAttribute('data-cat');
          renderMatrixRows(matrix);
        });
      });

      // Matrix rows
      renderMatrixRows(matrix);

      // Critical violations
      var violationsSection = document.getElementById('violationsSection');
      violationsSection.innerHTML = '';
      if (analysis.critical_violations && analysis.critical_violations.length > 0) {
        var html = '<div class="violations-section"><h3>Incumplimientos criticos (' + analysis.critical_violations.length + ')</h3>';
        for (var i = 0; i < analysis.critical_violations.length; i++) {
          var v = analysis.critical_violations[i];
          html += '<div class="violation-item">' +
            '<strong>[' + v.framework_id + ']</strong> ' + v.description +
            '<div class="violation-law">' + v.law + '</div></div>';
        }
        html += '</div>';
        violationsSection.innerHTML = html;
      }

      // Store context for chat
      lastAnalysis = analysis;

      // Show chat and download sections
      document.getElementById('chatSection').style.display = 'block';
      document.getElementById('downloadSection').style.display = 'block';

      // Raw JSON
      rawOutput.textContent = JSON.stringify(analysis, null, 2);
      results.classList.add('visible');
      results.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function renderMatrixRows(matrix) {
      var matrixBody = document.getElementById('matrixBody');
      matrixBody.innerHTML = '';
      for (var i = 0; i < matrix.length; i++) {
        var m = matrix[i];
        var catId = m.framework_id.charAt(0);
        if (currentTab !== 'all' && catId !== currentTab) continue;
        var ev = m.evaluation;
        var badgeClass = EVAL_BADGE[ev] || 'badge-ausente';
        var badgeLabel = EVAL_LABEL[ev] || ev.toUpperCase();
        matrixBody.innerHTML +=
          '<tr>' +
            '<td>' + m.framework_id + '</td>' +
            '<td>' + (m.pliego_text || m.pliego_ref || '') + '</td>' +
            '<td><span class="eval-badge ' + badgeClass + '">' + badgeLabel + '</span></td>' +
            '<td>' + m.finding + '</td>' +
          '</tr>';
      }
    }

    // ── Chat ──
    var lastAnalysis = null;
    var lastPlegoText = '';
    var chatRole = 'funcionario';

    document.querySelectorAll('.role-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        document.querySelectorAll('.role-btn').forEach(function(b) {
          b.classList.remove('active');
          b.style.background = 'transparent';
          b.style.color = 'rgba(255,255,255,0.4)';
        });
        btn.classList.add('active');
        btn.style.background = 'rgba(74,222,128,0.1)';
        btn.style.color = '#4ade80';
        chatRole = btn.getAttribute('data-role');
      });
    });
    var chatInput = document.getElementById('chatInput');
    var chatSend = document.getElementById('chatSend');
    var chatMessages = document.getElementById('chatMessages');

    chatSend.addEventListener('click', sendChat);
    chatInput.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') sendChat();
    });

    async function sendChat() {
      var q = chatInput.value.trim();
      if (!q) return;

      chatMessages.innerHTML += '<div class="chat-msg chat-user">' + q + '</div>';
      chatInput.value = '';
      chatMessages.innerHTML += '<div class="chat-msg chat-bot chat-typing" id="chatTyping">Pensando...</div>';
      chatMessages.scrollTop = chatMessages.scrollHeight;

      try {
        var resp = await fetch(PLIEGO_API + '/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            question: q,
            role: chatRole,
            analysisContext: lastAnalysis,
            plegoExcerpt: lastPlegoText
          })
        });

        var typing = document.getElementById('chatTyping');
        if (typing) typing.remove();

        if (!resp.ok) {
          var err = await resp.json().catch(function() { return {}; });
          chatMessages.innerHTML += '<div class="chat-msg chat-bot">Error: ' + (err.error || 'No se pudo procesar.') + '</div>';
          return;
        }

        var data = await resp.json();
        chatMessages.innerHTML += '<div class="chat-msg chat-bot">' + data.answer.replace(/\n/g, '<br>') + '</div>';
        chatMessages.scrollTop = chatMessages.scrollHeight;
      } catch (err) {
        var typing = document.getElementById('chatTyping');
        if (typing) typing.remove();
        chatMessages.innerHTML += '<div class="chat-msg chat-bot">Error de conexion.</div>';
      }
    }

    // ── PDF Download ──
    function downloadReport() {
      if (!lastAnalysis) return;
      var a = lastAnalysis;
      var matrix = a.matrix || [];
      var date = new Date().toLocaleDateString('es-CR', { year: 'numeric', month: 'long', day: 'numeric' });

      var html = '<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8">' +
        '<title>Reporte de Cumplimiento — Attestto Pliego Reviewer</title>' +
        '<style>' +
        'body{font-family:Arial,sans-serif;color:#1a1a2e;padding:40px;font-size:13px;line-height:1.6;}' +
        'h1{font-size:20px;margin-bottom:4px;}' +
        'h2{font-size:16px;margin-top:24px;border-bottom:1px solid #ccc;padding-bottom:4px;}' +
        '.meta{color:#666;font-size:12px;margin-bottom:20px;}' +
        '.summary{background:#f0f4ff;border-left:3px solid #4a6cf7;padding:12px;margin:16px 0;border-radius:4px;}' +
        '.scores{display:flex;gap:12px;flex-wrap:wrap;margin:16px 0;}' +
        '.score{border:1px solid #ddd;border-radius:6px;padding:10px 16px;text-align:center;min-width:100px;}' +
        '.score .val{font-size:24px;font-weight:800;}' +
        '.score .lbl{font-size:11px;color:#666;}' +
        '.red{color:#dc2626;}.yellow{color:#d97706;}.green{color:#16a34a;}.gray{color:#6b7280;}' +
        'table{width:100%;border-collapse:collapse;margin:12px 0;font-size:12px;}' +
        'th{background:#f3f4f6;text-align:left;padding:6px 8px;font-size:11px;text-transform:uppercase;letter-spacing:0.05em;border-bottom:2px solid #ddd;}' +
        'td{padding:6px 8px;border-bottom:1px solid #eee;vertical-align:top;}' +
        '.badge{display:inline-block;padding:2px 6px;border-radius:3px;font-size:10px;font-weight:700;text-transform:uppercase;}' +
        '.b-cumple{background:#dcfce7;color:#16a34a;}' +
        '.b-insuficiente{background:#fef3c7;color:#d97706;}' +
        '.b-ausente{background:#f3f4f6;color:#6b7280;}' +
        '.b-incumple{background:#fee2e2;color:#dc2626;}' +
        '.violation{background:#fef2f2;border:1px solid #fecaca;border-radius:6px;padding:10px;margin:8px 0;}' +
        '.footer{margin-top:30px;padding-top:12px;border-top:1px solid #ddd;font-size:11px;color:#999;text-align:center;}' +
        '@media print{body{padding:20px;}@page{margin:1.5cm;}}' +
        '</style></head><body>';

      html += '<h1>Reporte de Cumplimiento de Pliego</h1>';
      html += '<div class="meta">Fecha: ' + date + ' · Framework v1.0.0 (34 checks, 7 categorias) · attestto.org/revisor-pliegos/</div>';

      if (a.summary) {
        html += '<div class="summary">' + a.summary + '</div>';
      }

      // Scores
      html += '<h2>Puntuaciones por Categoria</h2><div class="scores">';
      if (a.scores) {
        for (var k in a.scores) {
          var s = a.scores[k];
          var cls = s.value >= 70 ? 'green' : s.value >= 40 ? 'yellow' : 'red';
          html += '<div class="score"><div class="val ' + cls + '">' + s.value + '</div><div class="lbl">' + s.label + '</div></div>';
        }
      }
      html += '</div>';

      // Matrix
      html += '<h2>Matriz de Cumplimiento (' + matrix.length + ' hallazgos)</h2>';
      html += '<table><thead><tr><th>Ref</th><th>Requisito</th><th>Estado</th><th>Hallazgo</th><th>Ley</th></tr></thead><tbody>';
      for (var i = 0; i < matrix.length; i++) {
        var m = matrix[i];
        var ev = m.evaluation || 'ausente';
        var bc = ev === 'cumple' ? 'b-cumple' : ev === 'insuficiente' ? 'b-insuficiente' : ev === 'ausente' ? 'b-ausente' : 'b-incumple';
        var label = ev === 'viola' ? 'INCUMPLE' : ev.toUpperCase();
        html += '<tr><td>' + m.framework_id + '</td><td>' + (m.pliego_text || m.pliego_ref || '') + '</td>' +
          '<td><span class="badge ' + bc + '">' + label + '</span></td>' +
          '<td>' + m.finding + '</td><td style="font-size:11px;color:#666;">' + (m.law || m.recommendation || '') + '</td></tr>';
      }
      html += '</tbody></table>';

      // Violations
      if (a.critical_violations && a.critical_violations.length > 0) {
        html += '<h2>Incumplimientos Criticos (' + a.critical_violations.length + ')</h2>';
        for (var i = 0; i < a.critical_violations.length; i++) {
          var v = a.critical_violations[i];
          html += '<div class="violation"><strong>[' + v.framework_id + ']</strong> ' + v.description + '<br><span style="font-size:11px;color:#666;">' + v.law + '</span></div>';
        }
      }

      html += '<div class="footer">Generado por Attestto Pliego Reviewer · attestto.org/revisor-pliegos/ · Codigo abierto Apache 2.0<br>Este reporte es una evaluacion automatizada. No constituye asesoria legal.</div>';
      html += '</body></html>';

      // Open in new window for print/save
      var win = window.open('', '_blank');
      win.document.write(html);
      win.document.close();
      setTimeout(function() { win.print(); }, 500);
    }

    // Expose for testing
    if (typeof window !== 'undefined') {
      window._revisor = { renderResults: renderResults };
    }
  })();
  </script>

  <script is:inline defer data-domain="attestto.org" src="https://plausible.io/js/script.js"></script>

</Base>
