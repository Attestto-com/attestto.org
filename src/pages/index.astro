---
import Base from '../layouts/Base.astro'

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Attestto",
  "url": "https://attestto.org",
  "description": "Open-source sovereign identity infrastructure. Verifiable credentials, decentralized identifiers, and cryptographic verification for governments, professionals, and citizens.",
  "license": "https://www.apache.org/licenses/LICENSE-2.0",
  "sameAs": [
    "https://github.com/Attestto-com",
    "https://attestto.com"
  ]
}
---

<Base
  title="Attestto — Sovereign Identity Infrastructure"
  description="Open-source infrastructure for verifiable credentials and decentralized identity. Verify documents, issue credentials, bridge national PKIs — with W3C standards and live resolvers."
  canonicalPath=""
  ogTitle="Attestto — Sovereign Identity Infrastructure"
  ogDescription="Open-source infrastructure for verifiable credentials and decentralized identity. W3C standards-track DID methods, live resolver, real deployments."
  structuredData={structuredData}
>
  <Fragment slot="head">
    <meta name="keywords" content="sovereign identity, decentralized identity, DID, verifiable credentials, digital signature verification, did:pki, did:sns, W3C, open source, LATAM identity" />
    <link rel="alternate" hreflang="en" href="https://attestto.org" />
    <link rel="alternate" hreflang="es" href="https://attestto.org/es" />
    <link rel="alternate" hreflang="x-default" href="https://attestto.org" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="es_CR" />
  </Fragment>

  <!-- Hero -->
  <section class="hero hero-single">
    <div class="container">
      <div class="hero-text">
        <h1 data-i18n="index.title">Verify any document. Issue any credential. Bridge any PKI.</h1>
        <p class="lead" data-i18n="index.lead">
          Identity infrastructure built on W3C and IETF standards.
          Technologically neutral &mdash; works with any stack, any vendor, any government.
          Open source reference implementations anyone can deploy.
        </p>
        <div class="hero-actions">
          <a href="https://verify.attestto.com" class="btn btn-primary" data-i18n="index.btn_verify">Verify a document</a>
          <a href="/standards" class="btn btn-secondary" data-i18n="index.btn_standards">Explore the standards</a>
        </div>
      </div>
    </div>
  </section>

  <!-- What Attestto Does — Use Cases -->
  <section id="usecases" class="section-light">
    <div class="container">
      <div class="section-label" data-i18n="index.uc_label">What we build</div>
      <h2 class="section-title" data-i18n="index.uc_title">Identity infrastructure for the real world</h2>
      <p class="section-desc" data-i18n="index.uc_desc">
        Each use case below is either live or in active development,
        using open standards for identity resolution and credential verification.
      </p>
      <div class="usecases-grid">
        <div class="usecase-card">
          <h3>Document verification</h3>
          <p>Drop a digitally signed PDF. The signature, certificate chain, and issuing authority are verified cryptographically — no account required, no data uploaded.</p>
          <div class="usecase-meta">
            <span class="usecase-status live">Live</span>
            <a href="https://verify.attestto.com" class="usecase-link">verify.attestto.com</a>
          </div>
        </div>

        <div class="usecase-card">
          <h3>Cross-border PKI bridge</h3>
          <p>Costa Rica's Firma Digital PKI hierarchy mapped to <code>did:pki</code> DIDs. Every CA resolvable as a DID Document. A document signed in CR can be verified anywhere — one resolver endpoint, any country.</p>
          <div class="usecase-meta">
            <span class="usecase-status live">Live</span>
            <a href="/standards#methods" class="usecase-link">did:pki spec</a>
          </div>
        </div>

        <div class="usecase-card">
          <h3>Professional credentials</h3>
          <p>Proposed framework for Verifiable Credentials for licensed professionals — doctors, lawyers, engineers. Mastery-based continuous competency model with issuance by professional bodies.</p>
          <div class="usecase-meta">
            <span class="usecase-status proposed">Proposed</span>
            <a href="/ark" class="usecase-link">Architecture</a>
          </div>
        </div>

        <div class="usecase-card">
          <h3>Digital driving credentials</h3>
          <p>Proposed mobile driving license architecture following ISO 18013-5, with proctored exams, decay scoring, and renewal gates — anchored to the holder's DID.</p>
          <div class="usecase-meta">
            <span class="usecase-status proposed">Proposed</span>
            <a href="/cr" class="usecase-link">Costa Rica</a>
          </div>
        </div>


      </div>
    </div>
  </section>

  <!-- Surfaces — What you can use today -->
  <section id="surfaces" class="section-dark">
    <div class="container">
      <div class="section-label" data-i18n="index.surf_label">Tools</div>
      <h2 class="section-title" data-i18n="index.surf_title">Use it today</h2>
      <p class="section-desc" data-i18n="index.surf_desc">
        Four surfaces, progressive adoption. Start with zero friction in the browser,
        go deeper as you need.
      </p>
      <div class="grid-4 surfaces-grid">
        <div class="card surface-card">
          <div class="surface-badge live">Live</div>
          <h3>Verify</h3>
          <p>Drag and drop a signed PDF. Verify the signature, certificate chain, and issuing CA — in your browser, nothing uploaded.</p>
          <a href="https://verify.attestto.com" class="surface-link">verify.attestto.com &rarr;</a>
        </div>
        <div class="card surface-card">
          <div class="surface-badge live">Live</div>
          <h3>App</h3>
          <p>Sovereign identity wallet. Store credentials, take proctored exams, present proofs. Progressive Web App — works on any device.</p>
          <a href="https://app.attestto.com" class="surface-link">app.attestto.com &rarr;</a>
        </div>
        <div class="card surface-card">
          <div class="surface-badge soon">Pre-release</div>
          <h3>Station</h3>
          <p>Desktop vault, signer, verifier, and mesh node. Full offline capability. Electron on macOS, Windows, and Linux.</p>
          <a href="/ark/desktop" class="surface-link">Learn more &rarr;</a>
        </div>
        <div class="card surface-card">
          <div class="surface-badge soon">Coming soon</div>
          <h3>Extension</h3>
          <p>Browser extension for web-native verification. Validates digital signatures on any page you visit.</p>
          <a href="/downloads" class="surface-link">Downloads &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Standards — Social Proof -->
  <section id="standards" class="section-light">
    <div class="container">
      <div class="section-label" data-i18n="index.std_label">Standards</div>
      <h2 class="section-title" data-i18n="index.std_title">W3C standards-track DID methods</h2>
      <p class="section-desc" data-i18n="index.std_desc">
        Two DID methods, both on the W3C standards track, both with live resolvers.
        They bridge existing trust infrastructure into the DID ecosystem
        without replacing anything.
      </p>
      <div class="standards-row">
        <div class="standard-card">
          <code class="standard-name">did:pki</code>
          <p>Read-only DIDs derived from X.509 CA certificates. If a government CA exists, it already has a DID.</p>
          <div class="standard-links">
            <a href="https://github.com/Attestto-com/did-pki-spec">Spec</a>
            <a href="https://github.com/w3c/did-extensions/pull/697">W3C PR #697</a>
          </div>
        </div>
        <div class="standard-card">
          <code class="standard-name">did:sns</code>
          <p>Alias-anchored DIDs via Solana Name Service. Human-readable, verifiable identifiers.</p>
          <div class="standard-links">
            <a href="https://github.com/Attestto-com/did-sns-spec">Spec</a>
            <a href="https://github.com/w3c/did-extensions/pull/674">W3C PR #674</a>
          </div>
        </div>
        <div class="standard-card resolver-card">
          <code class="standard-name">resolver</code>
          <p>Unified HTTP endpoint resolving both methods. DIF Universal Resolver compatible.</p>
          <div class="standard-links">
            <a href="https://resolver.attestto.com/1.0/identifiers/did:pki:cr:raiz-nacional">Try it live</a>
            <a href="https://github.com/decentralized-identity/universal-resolver/pull/542">DIF PR #542</a>
          </div>
        </div>
      </div>
      <div style="text-align: center; margin-top: var(--space-md);">
        <a href="/standards" class="btn btn-outline" data-i18n="index.btn_all_standards">All standards &amp; use cases &rarr;</a>
      </div>
    </div>
  </section>

  <!-- Open Source -->
  <section id="source" class="section-dark">
    <div class="container">
      <div class="section-label" data-i18n="index.source_label">Reference Implementations</div>
      <h2 class="section-title" data-i18n="index.source_title">Standards-based. Open source. Deployable.</h2>
      <p class="section-desc" data-i18n="index.source_desc">
        We publish reference implementations for every standard we propose.
        Traditional vendors can adopt the standards without using our code. Or fork it. Apache 2.0.
      </p>
      <div class="repo-grid">
        <a href="https://github.com/Attestto-com/did-pki-spec" class="repo">
          <img src="/github.svg" class="repo-icon" alt="GitHub" />
          <div>
            <div class="repo-name">did-pki-spec</div>
            <div class="repo-desc">DID method for national PKI hierarchies. W3C standards-track.</div>
            <span class="repo-tag">Spec</span>
          </div>
        </a>
        <a href="https://github.com/Attestto-com/did-pki-resolver" class="repo">
          <img src="/github.svg" class="repo-icon" alt="GitHub" />
          <div>
            <div class="repo-name">did-pki-resolver</div>
            <div class="repo-desc">Reference implementation — X.509 to DID Document resolution.</div>
            <span class="repo-tag">Resolver</span>
          </div>
        </a>
        <a href="https://github.com/Attestto-com/did-sns-spec" class="repo">
          <img src="/github.svg" class="repo-icon" alt="GitHub" />
          <div>
            <div class="repo-name">did-sns-spec</div>
            <div class="repo-desc">DID method for Solana Name Service. W3C standards-track.</div>
            <span class="repo-tag">Spec</span>
          </div>
        </a>
        <a href="https://github.com/Attestto-com/attestto-did-resolver" class="repo">
          <img src="/github.svg" class="repo-icon" alt="GitHub" />
          <div>
            <div class="repo-name">attestto-did-resolver</div>
            <div class="repo-desc">Unified resolver — did:pki + did:sns in one HTTP service.</div>
            <span class="repo-tag">Infrastructure</span>
          </div>
        </a>
        <a href="https://github.com/Attestto-com/attestto-verify" class="repo">
          <img src="/github.svg" class="repo-icon" alt="GitHub" />
          <div>
            <div class="repo-name">attestto-verify</div>
            <div class="repo-desc">Document verification web components — drop a PDF, verify the math.</div>
            <span class="repo-tag">Web</span>
          </div>
        </a>
        <a href="https://github.com/Attestto-com/attestto-trust" class="repo">
          <img src="/github.svg" class="repo-icon" alt="GitHub" />
          <div>
            <div class="repo-name">attestto-trust</div>
            <div class="repo-desc">Multi-country PKI trust store — independent public mirror of national CA roots.</div>
            <span class="repo-tag">Trust</span>
          </div>
        </a>
        <a href="https://github.com/Attestto-com/cr-vc-sdk" class="repo">
          <img src="/github.svg" class="repo-icon" alt="GitHub" />
          <div>
            <div class="repo-name">cr-vc-sdk</div>
            <div class="repo-desc">Typed SDK for issuing and verifying Costa Rica credentials.</div>
            <span class="repo-tag">Costa Rica</span>
          </div>
        </a>
        <a href="https://github.com/Attestto-com/attestto-mesh" class="repo">
          <img src="/github.svg" class="repo-icon" alt="GitHub" />
          <div>
            <div class="repo-name">attestto-mesh</div>
            <div class="repo-desc">P2P data mesh over libp2p — encrypted state-sync for sovereign identity.</div>
            <span class="repo-tag">Network</span>
          </div>
        </a>
        <a href="https://github.com/Attestto-com/cr-vc-schemas" class="repo">
          <img src="/github.svg" class="repo-icon" alt="GitHub" />
          <div>
            <div class="repo-name">cr-vc-schemas</div>
            <div class="repo-desc">JSON-LD schemas for Costa Rica credential types. W3C VDL + ISO 18013-5.</div>
            <span class="repo-tag">Costa Rica</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Audience Routing -->
  <section id="adopt" class="section-light">
    <div class="container">
      <div class="section-label" data-i18n="index.adopt_label">Get started</div>
      <h2 class="section-title" data-i18n="index.adopt_title">Built to be deployed</h2>
      <div class="audience-grid">
        <a href="/cr" class="audience-card">
          <h3>Governments</h3>
          <p>Deploy sovereign identity infrastructure. Issue verifiable public documents. Interoperate across jurisdictions.</p>
          <span class="audience-cta">See Costa Rica deployment &rarr;</span>
        </a>
        <a href="/ark/desktop" class="audience-card">
          <h3>Professionals</h3>
          <p>Verifiable credentials for your license, signature, and competency. Issued by your Colegio, carried on your device.</p>
          <span class="audience-cta">Explore Station &rarr;</span>
        </a>
        <a href="/standards" class="audience-card">
          <h3>Standards bodies</h3>
          <p>Two W3C DID methods, DIF Universal Resolver integration, open test vectors, and working implementations.</p>
          <span class="audience-cta">Review the standards &rarr;</span>
        </a>
        <a href="https://github.com/Attestto-com" class="audience-card">
          <h3>Developers</h3>
          <p>Fork the SDKs, extend the schemas, implement new DID methods, or build modules for the credential marketplace.</p>
          <span class="audience-cta">Browse on GitHub &rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Principles (compact) -->
  <section id="principles" class="section-dark">
    <div class="container">
      <div class="section-label" data-i18n="index.principles_label">Principles</div>
      <h2 class="section-title" data-i18n="index.principles_title">What we stand for</h2>
      <div class="principles-row">
        <div class="principle-item">
          <strong data-i18n="index.p_sovereignty">Sovereignty</strong>
          <span data-i18n="index.p_sovereignty_short">Your keys, your device, your data.</span>
        </div>
        <div class="principle-item">
          <strong data-i18n="index.p_interop">Interoperability</strong>
          <span data-i18n="index.p_interop_short">W3C, IETF, ISO standards only.</span>
        </div>
        <div class="principle-item">
          <strong data-i18n="index.p_privacy">Privacy</strong>
          <span data-i18n="index.p_privacy_short">Selective disclosure by default.</span>
        </div>
        <div class="principle-item">
          <strong data-i18n="index.p_nolock">Portability</strong>
          <span data-i18n="index.p_nolock_short">Fork it, export it, migrate freely.</span>
        </div>
        <div class="principle-item">
          <strong data-i18n="index.p_transparency">Transparency</strong>
          <span data-i18n="index.p_transparency_short">Open source, open governance, open audit.</span>
        </div>
        <div class="principle-item">
          <strong data-i18n="index.p_neutrality">Neutrality</strong>
          <span data-i18n="index.p_neutrality_short">You choose the technology, not us.</span>
        </div>
        <div class="principle-item">
          <strong data-i18n="index.p_public">Public good</strong>
          <span data-i18n="index.p_public_short">Free for citizens, forever.</span>
        </div>
      </div>
      <div style="margin-top: var(--space-md);">
        <a href="/why" class="btn btn-outline" data-i18n="index.btn_why">Read the full story &rarr;</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ── Use Case Cards ── */
  .usecases-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  .usecase-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
  }

  .usecase-card h3 {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-ink);
    margin-bottom: 0.5rem;
  }

  .usecase-card p {
    font-size: 0.875rem;
    color: var(--color-ink-muted);
    line-height: 1.6;
    flex: 1;
  }

  .usecase-card code {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    background: #f1f5f9;
    padding: 0.1rem 0.3rem;
    border-radius: 3px;
  }

  .usecase-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-top: var(--space-sm);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-border);
  }

  .usecase-status {
    font-size: 0.6875rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .usecase-status.live { background: #dcfce7; color: #15803d; }
  .usecase-status.poc { background: #dbeafe; color: #1e40af; }
  .usecase-status.building { background: #fef3c7; color: #92400e; }
  .usecase-status.proposed { background: #f3e8ff; color: #6b21a8; }
  .usecase-status.planned { background: #f1f5f9; color: #475569; }

  .usecase-link {
    font-size: 0.8125rem;
    color: var(--color-accent);
    font-weight: 500;
    margin-left: auto;
  }

  /* ── Surface Cards ── */
  .surfaces-grid {
    gap: var(--space-sm) !important;
  }

  .surface-card {
    position: relative;
    padding-top: calc(var(--space-md) + 0.5rem) !important;
  }

  .surface-badge {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    font-size: 0.6875rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .surface-badge.live { background: #dcfce7; color: #15803d; }
  .surface-badge.soon { background: rgba(255,255,255,0.1); color: rgba(255,255,255,0.5); }

  .surface-link {
    display: inline-block;
    margin-top: var(--space-xs);
    font-size: 0.875rem;
    color: #4ade80;
    font-weight: 500;
  }

  /* ── Standards Row ── */
  .standards-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  .standard-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: var(--space-md);
  }

  .standard-name {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-accent);
    display: block;
    margin-bottom: 0.5rem;
  }

  .standard-card p {
    font-size: 0.875rem;
    color: var(--color-ink-muted);
    line-height: 1.6;
  }

  .standard-links {
    display: flex;
    gap: 1rem;
    margin-top: var(--space-sm);
  }

  .standard-links a {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-accent);
  }

  .resolver-card {
    border-color: var(--color-accent);
  }

  .btn-outline {
    display: inline-block;
    padding: 0.6rem 1.5rem;
    border: 1px solid rgba(255,255,255,0.3);
    border-radius: 6px;
    color: rgba(255,255,255,0.8);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.15s;
  }

  .section-light .btn-outline {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .btn-outline:hover {
    background: rgba(255,255,255,0.05);
    color: #ffffff;
    text-decoration: none;
  }

  .section-light .btn-outline:hover {
    background: var(--color-accent);
    color: #ffffff;
  }

  /* ── Audience Cards ── */
  .audience-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  .audience-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: var(--space-md);
    text-decoration: none;
    transition: border-color 0.15s, box-shadow 0.15s;
    display: flex;
    flex-direction: column;
  }

  .audience-card:hover {
    border-color: var(--color-accent);
    box-shadow: 0 4px 12px rgba(21, 128, 61, 0.1);
    text-decoration: none;
  }

  .audience-card h3 {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-ink);
    margin-bottom: 0.5rem;
  }

  .audience-card p {
    font-size: 0.875rem;
    color: var(--color-ink-muted);
    line-height: 1.6;
    flex: 1;
  }

  .audience-cta {
    display: block;
    margin-top: var(--space-sm);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  /* ── Principles Row ── */
  .principles-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-sm) var(--space-md);
    margin-top: var(--space-md);
  }

  .principle-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .principle-item strong {
    color: #ffffff;
    font-size: 0.9375rem;
  }

  .principle-item span {
    color: rgba(255,255,255,0.5);
    font-size: 0.8125rem;
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .usecases-grid { grid-template-columns: repeat(2, 1fr); }
    .audience-grid { grid-template-columns: repeat(2, 1fr); }
    .principles-row { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 768px) {
    .usecases-grid,
    .standards-row,
    .audience-grid { grid-template-columns: 1fr; }
    .principles-row { grid-template-columns: 1fr 1fr; }
  }
</style>
