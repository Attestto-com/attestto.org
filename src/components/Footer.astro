---
interface Props {
  variant?: 'default' | 'revisor'
  tagline?: string
  notes?: string[]
}

const { variant = 'default', tagline, notes = [] } = Astro.props

interface FooterLink {
  href: string
  label: string
  i18n?: string
}

const footerConfigs: Record<string, { brand: string; description: string; links: FooterLink[] }> = {
  default: {
    brand: 'Attestto',
    description: 'Open-source identity infrastructure built on W3C and IETF standards. Technologically neutral, sovereign by design.',
    links: [
      { href: '/why', label: 'Why' },
      { href: '/standards', label: 'Standards' },
      { href: '/ark', label: 'Architecture', i18n: 'nav.architecture' },
      { href: '/downloads', label: 'Downloads', i18n: 'footer.downloads' },
      { href: 'https://github.com/Attestto-com', label: 'GitHub', i18n: 'footer.github' },
      { href: 'mailto:open@attestto.com', label: 'open@attestto.com' },
    ],
  },
  revisor: {
    brand: 'Attestto · Revisor de Pliegos',
    description: 'Herramienta de verificación de pliegos de licitación.',
    links: [
      { href: '/', label: 'Attestto' },
      { href: 'https://github.com/Attestto-com/attestto-pliego-reviewer', label: 'Código fuente' },
      { href: 'mailto:open@attestto.com', label: 'open@attestto.com' },
    ],
  },
}

const config = footerConfigs[variant]
const year = new Date().getFullYear()
---

<footer>
  <div class="container footer-grid">
    <div class="footer-brand">
      <img src="/logo-full-white.svg" alt="Attestto" class="footer-logo" />
      <p class="footer-desc">{config.description}</p>
    </div>
    <nav class="footer-nav" aria-label="Footer navigation">
      {config.links.map((link) => (
        <a href={link.href} data-i18n={link.i18n}>{link.label}</a>
      ))}
    </nav>
  </div>
  {tagline && (
    <div class="container footer-tagline-wrap">
      <p class="footer-tagline">{tagline}</p>
    </div>
  )}
  {notes.length > 0 && (
    <div class="container footer-notes-wrap">
      {notes.map((note) => (
        <p class="footer-note" set:html={note} />
      ))}
    </div>
  )}
  <div class="container footer-bottom">
    <span>&copy; {year} Attestto Inc. Apache 2.0</span>
  </div>
</footer>
