---
interface Props {
  variant?: 'default' | 'standards' | 'docs'
}

const { variant = 'default' } = Astro.props

interface NavLink {
  href: string
  label: string
  i18n?: string
  color?: string
  weight?: string
}

const navConfigs: Record<string, { brandSuffix: string; brandI18n?: string; links: NavLink[] }> = {
  default: {
    brandSuffix: '',
    links: [
      { href: '/why', label: 'Why', i18n: 'nav.why', color: '#fbbf24', weight: '600' },
      { href: '/commitments', label: 'Commitments', i18n: 'nav.commitments' },
      { href: '/standards', label: 'Standards', i18n: 'nav.standards' },
      { href: '/ark', label: 'Ark', i18n: 'nav.architecture' },
      { href: '/downloads', label: 'Downloads', i18n: 'nav.downloads' },
      { href: 'https://github.com/Attestto-com', label: 'GitHub' },
    ],
  },
  standards: {
    brandSuffix: '',
    links: [
      { href: '/standards#methods', label: 'Methods' },
      { href: '/standards#resolver', label: 'Resolver' },
      { href: '/standards#usecases', label: 'Use Cases' },
      { href: '/standards#coverage', label: 'Coverage' },
    ],
  },
  docs: {
    brandSuffix: 'Docs',
    links: [
      { href: '/docs', label: 'Home' },
      { href: '/for/developers', label: 'Developer Portal' },
      { href: 'https://github.com/Attestto-com', label: 'GitHub' },
    ],
  },
}

const config = navConfigs[variant]
---

<nav>
  <div class="container">
    <a href="/" class="nav-brand">
      <img src="/logo-full-white.svg" alt="Attestto" class="nav-logo" />
      {config.brandSuffix && <span data-i18n={config.brandI18n}>{config.brandSuffix}</span>}
    </a>
    {config.links.length > 0 && (
      <ul class="nav-links">
        {config.links.map((link) => (
          <li>
            <a
              href={link.href}
              data-i18n={link.i18n}
              style={[
                link.color ? `color: ${link.color}` : '',
                link.weight ? `font-weight: ${link.weight}` : '',
              ].filter(Boolean).join('; ') || undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</nav>
