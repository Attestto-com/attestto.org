---
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import { BUILD_VERSION as i18nBuildVersion } from '../lib/build-version'
import '../styles/tokens.css'
import '../styles/base.css'
import '../styles/components.css'

interface Props {
  title: string
  description: string
  canonicalPath?: string
  ogTitle?: string
  ogDescription?: string
  ogImage?: string
  ogType?: string
  themeColor?: string
  lang?: string
  navVariant?: 'default' | 'revisor' | 'standards' | 'docs'
  footerVariant?: 'default' | 'revisor'
  footerTagline?: string
  footerNotes?: string[]
  structuredData?: object
  bodyClass?: string
  extraHead?: string
}

const {
  title,
  description,
  canonicalPath = '',
  ogTitle,
  ogDescription,
  ogImage = 'https://attestto.org/og-image.png',
  ogType = 'website',
  themeColor = '#0a1628',
  lang = 'en',
  navVariant = 'default',
  footerVariant = 'default',
  footerTagline,
  footerNotes = [],
  structuredData,
  bodyClass,
} = Astro.props

const canonicalUrl = `https://attestto.org${canonicalPath}`

// ── Breadcrumb generation ──
// Maps path segments to display names (EN + ES)
const breadcrumbNames: Record<string, Record<string, string>> = {
  en: {
    '': 'Attestto',
    'ark': 'Architecture',
    'desktop': 'Desktop',
    'patrons': 'Patrons',
    'standards': 'Standards',
    'why': 'Why',
    'downloads': 'Downloads',
    'cr': 'Costa Rica',
    'sistemas': 'State Systems',
    'for': 'For',
    'developers': 'Developers',
    'docs': 'Docs',
    'quickstart': 'Quickstart',
    'verify': 'Verify & Sign',
    'credentials': 'Credentials',
    'wallets': 'Wallets',
    'identity': 'Identity',
    'integration': 'Integration',
    'verify-a-document': 'Verify a Document',
    'issue-a-credential': 'Issue a Credential',
    'add-did-login': 'Add DID Login',
    'verify-component': 'Verify Component',
    'sign-component': 'Sign Component',
    'composables': 'Composables',
    'theming': 'Theming',
    'plugins': 'Plugins',
    'playground': 'Playground',
    'issuing': 'Issuing',
    'verifying': 'Verifying',
    'key-management': 'Key Management',
    'schemas': 'Schemas',
    'costa-rica': 'Costa Rica',
    'picker': 'Wallet Picker',
    'verification': 'Verification',
    'signing': 'Signing',
    'credential-offers': 'Credential Offers',
    'did-sns': 'did:sns',
    'did-pki': 'did:pki',
    'resolution': 'Resolution',
    'javascript': 'JavaScript',
    'forms': 'Form Validation',
    'wordpress': 'WordPress',
    'joomla': 'Joomla',
    'installation': 'Installation',
    'privacy': 'Privacy Policy',
    'terms': 'Terms of Service',
    'cookies': 'Cookie Policy',
  },
  es: {
    '': 'Attestto',
    'ark': 'Arquitectura',
    'desktop': 'Escritorio',
    'patrons': 'Patrocinadores',
    'standards': 'Estándares',
    'why': 'Por qué',
    'downloads': 'Descargas',
    'cr': 'Costa Rica',
    'for': 'Para',
    'developers': 'Desarrolladores',
    'docs': 'Documentación',
  },
}

// Build breadcrumb items from canonical path
const isSpanish = lang === 'es'
const pathForBreadcrumb = isSpanish ? canonicalPath.replace(/^\/es/, '') : canonicalPath
const segments = pathForBreadcrumb.split('/').filter(Boolean)
const names = breadcrumbNames[lang] || breadcrumbNames['en']

interface BreadcrumbItem {
  label: string
  href: string
}

const breadcrumbs: BreadcrumbItem[] = [
  { label: 'Attestto', href: isSpanish ? '/es' : '/' },
]

let buildPath = isSpanish ? '/es' : ''
for (const seg of segments) {
  buildPath += `/${seg}`
  breadcrumbs.push({
    label: names[seg] || seg.charAt(0).toUpperCase() + seg.slice(1),
    href: buildPath,
  })
}

// Only show breadcrumb if we're deeper than homepage
const showBreadcrumb = breadcrumbs.length > 1

// Pages that have Spanish equivalents in /es/ (keyed by locale-agnostic path)
const pagesWithSpanish = ['', '/ark', '/ark/desktop', '/ark/patrons', '/downloads', '/standards', '/why', '/commitments', '/demo/formless']
// Strip a leading /es so an EN page and its ES twin resolve to the same key.
// This is why the has-Spanish flag and hreflang must be computed from the
// locale-agnostic path: an ES page's canonicalPath is "/es/why", and we still
// need it to (a) report hasSpanish=true so the switcher shows and the chrome
// stays Spanish, and (b) emit correct hreflang without a doubled "/es/es".
const basePath = canonicalPath.replace(/^\/es(?=\/|$)/, '')
const hasSpanish = pagesWithSpanish.includes(basePath)
const enUrl = `https://attestto.org${basePath}`
const esUrl = `https://attestto.org/es${basePath}`
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <!--
    Content-Security-Policy (SEV-1/SEV-5). GitHub Pages sets no headers, so this
    meta is the origin allow-list backstop: even if a CDN is compromised, only the
    listed origins may execute scripts or frame content. script-src / frame-src are
    the real allow-lists; connect-src / img-src stay permissive so analytics and the
    verify component cannot break (a static site carries no secrets to exfiltrate).
    'unsafe-inline' is required because the site uses is:inline scripts (no nonces
    under static Astro). NOTE: verify in a browser (analytics, fonts, verify demo,
    YouTube embeds) before merging to main.
  -->
  <meta
    http-equiv="Content-Security-Policy"
    content="default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://plausible.io https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https:; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com"
  />

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-JCE4RZ8CCC"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-JCE4RZ8CCC');
  </script>

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content={themeColor} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Tell i18n.js whether this page has a Spanish counterpart, so the language
       switcher only appears (and only pins a language) where ES content exists.
       Stops EN-only pages from getting stuck showing an inert ES toggle. -->
  <script is:inline set:html={`window.__attesttoHasSpanish = ${JSON.stringify(hasSpanish)};`}></script>

  <!-- Open Graph -->
  <meta property="og:title" content={ogTitle || title} />
  <meta property="og:description" content={ogDescription || description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content="Attestto" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content={lang === 'es' ? 'es_CR' : 'en_US'} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={ogTitle || title} />
  <meta name="twitter:description" content={ogDescription || description} />
  <meta name="twitter:image" content={ogImage} />

  {structuredData && (
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  )}

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/jpeg" href="/favicon.jpg" />
  <link rel="apple-touch-icon" href="/favicon.jpg" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="dns-prefetch" href="https://verify.attestto.com" />
  <link rel="dns-prefetch" href="https://resolver.attestto.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <!-- hreflang -->
  {hasSpanish && (
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
  )}

  <slot name="head" />
</head>
<body class={bodyClass}>
  <header>
    <Nav variant={navVariant} />
  </header>

  {showBreadcrumb && (
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="container">
        <ol class="breadcrumb-list">
          {breadcrumbs.map((item, i) => (
            <li class="breadcrumb-item">
              {i < breadcrumbs.length - 1 ? (
                <a href={item.href}>{item.label}</a>
              ) : (
                <span aria-current="page">{item.label}</span>
              )}
            </li>
          ))}
        </ol>
      </div>
    </nav>
  )}

  <main>
    <slot />
  </main>

  <Footer variant={footerVariant} tagline={footerTagline} notes={footerNotes} />

  <!-- Version the src with the build time so a deploy invalidates the cached
       copy. Without this, browsers keep running a stale i18n.js across deploys
       (the tag URL never changes), so guard/logic fixes silently never apply. -->
  <script is:inline src={`/assets/js/i18n.js?v=${i18nBuildVersion}`}></script>
</body>
</html>
