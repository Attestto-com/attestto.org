---
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import '../styles/tokens.css'
import '../styles/base.css'
import '../styles/components.css'

interface Props {
  title: string
  description: string
  canonicalPath?: string
  ogTitle?: string
  ogDescription?: string
  ogImage?: string
  themeColor?: string
  lang?: string
  navVariant?: 'default' | 'ark' | 'ark-sub' | 'developers' | 'downloads' | 'revisor' | 'standards'
  footerVariant?: 'default' | 'revisor'
  footerTagline?: string
  footerNotes?: string[]
  structuredData?: object
  bodyClass?: string
  extraHead?: string
}

const {
  title,
  description,
  canonicalPath = '',
  ogTitle,
  ogDescription,
  ogImage = 'https://attestto.org/og-image.png',
  themeColor = '#0a1628',
  lang = 'en',
  navVariant = 'default',
  footerVariant = 'default',
  footerTagline,
  footerNotes = [],
  structuredData,
  bodyClass,
} = Astro.props

const canonicalUrl = `https://attestto.org${canonicalPath}`

// ── Breadcrumb generation ──
// Maps path segments to display names (EN + ES)
const breadcrumbNames: Record<string, Record<string, string>> = {
  en: {
    '': 'Attestto',
    'ark': 'Architecture',
    'desktop': 'Desktop',
    'patrons': 'Patrons',
    'standards': 'Standards',
    'why': 'Why',
    'downloads': 'Downloads',
    'cr': 'Costa Rica',
    'for': 'For',
    'developers': 'Developers',
  },
  es: {
    '': 'Attestto',
    'ark': 'Arquitectura',
    'desktop': 'Escritorio',
    'patrons': 'Patrocinadores',
    'standards': 'Estándares',
    'why': 'Por qué',
    'downloads': 'Descargas',
    'cr': 'Costa Rica',
    'for': 'Para',
    'developers': 'Desarrolladores',
  },
}

// Build breadcrumb items from canonical path
const isSpanish = lang === 'es'
const pathForBreadcrumb = isSpanish ? canonicalPath.replace(/^\/es/, '') : canonicalPath
const segments = pathForBreadcrumb.split('/').filter(Boolean)
const names = breadcrumbNames[lang] || breadcrumbNames['en']

interface BreadcrumbItem {
  label: string
  href: string
}

const breadcrumbs: BreadcrumbItem[] = [
  { label: 'Attestto', href: isSpanish ? '/es' : '/' },
]

let buildPath = isSpanish ? '/es' : ''
for (const seg of segments) {
  buildPath += `/${seg}`
  breadcrumbs.push({
    label: names[seg] || seg.charAt(0).toUpperCase() + seg.slice(1),
    href: buildPath,
  })
}

// Only show breadcrumb if we're deeper than homepage
const showBreadcrumb = breadcrumbs.length > 1

// Pages that have Spanish equivalents in /es/
const pagesWithSpanish = ['', '/ark', '/ark/desktop', '/ark/patrons', '/downloads', '/standards', '/why']
const hasSpanish = pagesWithSpanish.includes(canonicalPath)
const enUrl = `https://attestto.org${canonicalPath}`
const esUrl = `https://attestto.org/es${canonicalPath}`
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content={themeColor} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph -->
  <meta property="og:title" content={ogTitle || title} />
  <meta property="og:description" content={ogDescription || description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content="Attestto" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content={lang === 'es' ? 'es_CR' : 'en_US'} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={ogTitle || title} />
  <meta name="twitter:description" content={ogDescription || description} />
  <meta name="twitter:image" content={ogImage} />

  {structuredData && (
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  )}

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/jpeg" href="/favicon.jpg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <!-- hreflang -->
  {hasSpanish && (
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
  )}

  <slot name="head" />
</head>
<body class={bodyClass}>
  <header>
    <Nav variant={navVariant} />
  </header>

  {showBreadcrumb && (
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="container">
        <ol class="breadcrumb-list">
          {breadcrumbs.map((item, i) => (
            <li class="breadcrumb-item">
              {i < breadcrumbs.length - 1 ? (
                <a href={item.href}>{item.label}</a>
              ) : (
                <span aria-current="page">{item.label}</span>
              )}
            </li>
          ))}
        </ol>
      </div>
    </nav>
  )}

  <main>
    <slot />
  </main>

  <Footer variant={footerVariant} tagline={footerTagline} notes={footerNotes} />

  <script is:inline src="/assets/js/i18n.js"></script>
</body>
</html>
